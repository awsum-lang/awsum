  %i64 = zext i32 %i to i64
  %slot_p = getelementptr ptr, ptr %p, i64 %i64
  %child = load ptr, ptr %slot_p
  call void @__free_recursive(ptr %child)
  %i_next = add i32 %i, 1
  br label %loop_check
