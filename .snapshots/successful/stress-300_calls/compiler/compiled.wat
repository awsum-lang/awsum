      (loop $grow_loop
        (br_if $grow_done
          (i32.le_u (global.get $heap)
                    (i32.mul (memory.size) (i32.const 65536))))
        (if (i32.eq (memory.grow (i32.const 1)) (i32.const -1))
          (then (unreachable)))
        (br $grow_loop)))
    (local.get $ptr))


