    (i32.store (i32.add (local.get $ptr) (i32.const 8)) (local.get $shape))
    (i32.add (local.get $ptr) (i32.const 12)))


;; '$__free' reads the 4-byte flag prefix at (p - 12):
;;   flag == 0 → literal, no-op (safe to call on '@.empty' / pool ptr).
