        (br_if $grow_done
          (i32.le_u (global.get $heap)
                    (i32.mul (memory.size) (i32.const 65536))))
        (drop (memory.grow (i32.const 1)))
        (br $grow_loop)))
    (local.get $ptr))


  (func $__memcpy (param $dst i32) (param $src i32) (param $len i32)
    (local $i i32)
