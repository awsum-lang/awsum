      (i32.add (global.get $__wl_buf) (i32.shl (local.get $top) (i32.const 2)))
      (local.get $p))
    (global.set $__wl_top (i32.add (local.get $top) (i32.const 1))))


  (func $__free_recursive (param $p i32)
