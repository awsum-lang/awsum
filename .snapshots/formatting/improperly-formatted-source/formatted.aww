comment -}

-- top comment 1

-- top comment 2

type Color
  = Red
  | Green
  | Blue

-- before show sig

show : Color -> String

{- between show sig and def -}

show c = case c of
  -- deep leading
  -- shallow leading
  {- block comment in case -}
  Red -> "Red" -- inline 1
  -- deep between
  Green -> "Green" -- inline 2
  Blue -> "Blue"
  -- trailing case comment

