{- Nested block comments inside declarations and expressions. -}

import IO.Stdout

type Pick = A | B

pick : Pick -> Int32
pick p = case p of
  A -> 1
  B -> 2

_total : Either (UnderflowError | OverflowError) Int32
_total = do
  x <- addInt32 (pick A) (pick B)
  pureEither x

inLet : Int32
inLet =
  let n = (pick B)
   in n

main : IO Never Unit
main = IO.Stdout.print (showInt32 inLet)
