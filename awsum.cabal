name:           awsum
version:        0.0.4
description:    Please see the README on GitHub at <https://github.com/awsum-lang/awsum#readme>
license:        MIT
license-file:   LICENSE
build-type:     Simple
extra-source-files:
    README.md
    CHANGELOG.md
    stdlib/Prelude.aww

flag tree-sitter-tests
  description: Build the `tree-sitter-tests` test-suite, which exercises the
               external `tree-sitter-awsum` grammar by parsing every `.aww`
               under `test/sources/successful/` and `test/sources/property/`,
               plus an arbitrary-program property test. Disabled by default so
               CI doesn't build a suite that depends on the `tree-sitter` CLI
               and a sibling `../tree-sitter-awsum` checkout. Enable with
               `stack test --flag awsum:tree-sitter-tests` (or via the
               `just test-tree-sitter[-property]` recipes).
  manual: True
  default: False

library
  exposed-modules:
      Awsum.BuiltIn
      Awsum.CallGraph
      Awsum.Codegen
      Awsum.Codegen.CLR
      Awsum.Codegen.CLR.Assemble
      Awsum.Codegen.JS
      Awsum.Codegen.JVM
      Awsum.Codegen.JVM.Assemble
      Awsum.Codegen.LLVM
      Awsum.Codegen.WASM
      Awsum.Codegen.WASM.Assemble
      Awsum.Core
      Awsum.Cps
      Awsum.Defunctionalize
      Awsum.Desugar
      Awsum.Diagnostic
      Awsum.ElaborateLower
      Awsum.Format
      Awsum.HM
      Awsum.LowerClosures
      Awsum.Lsp
      Awsum.Normalize
      Awsum.Parser
      Awsum.Prelude
      Awsum.Program
      Awsum.Program.Cli
      Awsum.Render
      Awsum.Scc
      Awsum.StackSafety
      Awsum.Symbols
      Awsum.Syntax
      Awsum.Tco
      Awsum.Typing
      Common.File
  other-modules:
      Paths_awsum
  hs-source-dirs:
      src
  default-extensions:
      NoImplicitPrelude
      DeriveAnyClass
      DerivingVia
      DuplicateRecordFields
      OverloadedRecordDot
      OverloadedStrings
  ghc-options: -j16 +RTS -A32m -RTS -O2 -haddock -Weverything -Wno-all-missed-specialisations -Wno-missed-specialisations -Wno-missing-local-signatures -Wno-unsafe -Wno-missing-kind-signatures -Wno-missing-safe-haskell-mode -Wno-missing-import-lists
  build-depends:
      aeson
    , base >=4.7 && <5
    , bytestring
    , containers
    , directory
    , file-embed
    , filepath
    , lens
    , lsp
    , lsp-types
    , megaparsec
    , relude
    , text
  default-language: GHC2024

executable awsum
  main-is: Main.hs
  other-modules:
      Paths_awsum
  hs-source-dirs:
      awsum
  default-extensions:
      NoImplicitPrelude
      DeriveAnyClass
      DerivingVia
      DuplicateRecordFields
      OverloadedRecordDot
      OverloadedStrings
  ghc-options: -j16 +RTS -A32m -RTS -O2 -haddock -Weverything -Wno-all-missed-specialisations -Wno-missed-specialisations -Wno-missing-local-signatures -Wno-unsafe -Wno-missing-kind-signatures -Wno-missing-safe-haskell-mode -Wno-missing-import-lists -threaded -rtsopts -with-rtsopts=-N
  build-depends:
      awsum
    , base >=4.7 && <5
    , filepath
    , optparse-applicative
    , pretty-simple
    , process
    , relude
    , temporary
  default-language: GHC2024

test-suite awsum-test
  type: exitcode-stdio-1.0
  main-is: Main.hs
  other-modules:
      Awsum.ArbitraryInstances
      Awsum.ErrorSnapshotsSpec
      Awsum.FormattingSnapshotsSpec
      Awsum.HMSpec
      Awsum.ProgramSnapshotsSpec
      Awsum.PropertySpec
      Awsum.RunBackend
      Awsum.StringLiteralCapSpec
      Awsum.TreeSitterSpec
      Matchers
      TreeSitterMain
      Paths_awsum
  hs-source-dirs:
