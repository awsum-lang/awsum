  default-extensions:
      NoImplicitPrelude
      DeriveAnyClass
      DerivingVia
      DuplicateRecordFields
      OverloadedRecordDot
      OverloadedStrings
  ghc-options: -j16 +RTS -A32m -RTS -O2 -haddock -Weverything -Wno-all-missed-specialisations -Wno-missed-specialisations -Wno-missing-local-signatures -Wno-unsafe -Wno-missing-kind-signatures -Wno-missing-safe-haskell-mode -Wno-missing-import-lists -threaded -rtsopts -with-rtsopts=-N
  build-depends:
      QuickCheck
    , async
    , awsum
    , base >=4.7 && <5
    , directory
    , filepath
    , hspec
    , hspec-golden
    , pretty-simple
    , process
    , relude
    , temporary
  default-language: GHC2024

test-suite tree-sitter-tests
  type: exitcode-stdio-1.0
  main-is: TreeSitterMain.hs
  other-modules:
      Awsum.ArbitraryInstances
      Awsum.TreeSitterSpec
  hs-source-dirs:
      test
  default-extensions:
      NoImplicitPrelude
      DeriveAnyClass
      DerivingVia
      DuplicateRecordFields
      OverloadedRecordDot
      OverloadedStrings
  ghc-options: -j16 +RTS -A32m -RTS -O2 -haddock -Weverything -Wno-all-missed-specialisations -Wno-missed-specialisations -Wno-missing-local-signatures -Wno-unsafe -Wno-missing-kind-signatures -Wno-missing-safe-haskell-mode -Wno-missing-import-lists -threaded -rtsopts -with-rtsopts=-N -main-is TreeSitterMain
  build-depends:
      QuickCheck
    , awsum
    , base >=4.7 && <5
    , directory
    , filepath
    , hspec
    , process
    , relude
    , temporary
  default-language: GHC2024
  if !flag(tree-sitter-tests)
    buildable: False
