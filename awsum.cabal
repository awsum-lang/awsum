name:           awsum
version:        0.0.7
description:    Please see the README on GitHub at <https://github.com/awsum-lang/awsum#readme>
license:        Apache-2.0
license-file:   LICENSE
build-type:     Simple
extra-source-files:
    README.md
    CHANGELOG.md
    NOTICE
    VERSION
    stdlib/Prelude.aww

flag textmate-tests
  description: Build the `textmate-tests` test-suite, which exercises the
               `awsum.tmLanguage.json` TextMate grammar shipped in
               `awsum-vscode/`. Shells out to a small Node script that
               tokenizes every `.aww` in the corpus and every arbitrary-
               generated `Program` through `vscode-textmate` — the same
               engine VSCode runs in production — and asserts invariants on
               the resulting scope stacks. Disabled by default so CI's main
               suite doesn't depend on Node or a sibling `../awsum-vscode/`
               checkout with `npm install` already run inside it. Enable
               with `stack test --flag awsum:textmate-tests` (or via the
               `just test-textmate[-property]` recipes).
  manual: True
  default: False

flag tree-sitter-tests
  description: Build the `tree-sitter-tests` test-suite, which exercises the
               external `tree-sitter-awsum` grammar by parsing every `.aww`
               under `test/sources/successful/` and `test/sources/property/`,
               plus an arbitrary-program property test. Disabled by default so
               CI doesn't build a suite that depends on the `tree-sitter` CLI
               and a sibling `../tree-sitter-awsum` checkout. Enable with
               `stack test --flag awsum:tree-sitter-tests` (or via the
               `just test-tree-sitter[-property]` recipes).
  manual: True
  default: False

