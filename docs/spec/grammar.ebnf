(* Awsum surface grammar — EBNF.
   Applies-to: Awsum 0.0.1
*)

Program             = { Import }, { TopItem , Terminator }, [ Terminator ] ;

Import              = { TopComment , Terminator } , "import" , ModulePath , [ TrailingLineComment ] ;
ModulePath          = UIdent , { "." , UIdent } ;

TopItem             = TopComment | TypeDecl | Sig | FunDef ;

TypeDecl            = "type" , UIdent , { LIdent } , [ "=" , ConDef , { "|" , ConDef } ] ;
ConDef              = UIdent , { TypeAtom } ;

Sig                 = LIdent , ":" , Type , [ TrailingLineComment ] ;
FunDef              = LIdent , { LIdent } , "=" , Expr , [ TrailingLineComment ] ;

TopComment          = LineComment | BlockComment ;
LineComment         = "--" , LineText ;
BlockComment        = "{-" , BlockText , "-}" ;
TrailingLineComment = "--" , LineText ;

(* Types: right-associative arrow *)
Type                = TypeAtom , { "->" , Type } ;
TypeAtom            = UIdent , { TypeAtom } | LIdent | "(" , Type , ")" ;

(* Expressions: ++ < application < atoms (both left-associative) *)
Expr                = Concat ;
Concat              = App , { "++" , App } ;
App                 = Atom , { Atom } ;
Atom                = CaseExpr | QName | ConName | "(" , Expr , ")" | String | Int ;
(* Case: arms at reference indent (set by first arm).
   Comments accepted at any column > 1 — lenient so misaligned comments
   don't break compilation; the formatter normalizes.
   A blank line terminates the case block. *)
CaseExpr            = "case" , Expr , "of" , NEWLINE , { CaseItem } ;
CaseItem            = ( LineComment | BlockComment ) , Terminator
                    | Pattern , "->" , Expr , [ TrailingLineComment ] , Terminator ;
Pattern             = UIdent , { PatternAtom } | LIdent ;
PatternAtom         = LIdent | UIdent | "(" , Pattern , ")" ;

QName               = { UIdent , "." } , LIdent ;

(* Lexical sketch (exact rules implemented by the lexer):
   - String escapes: \n \t \r \" \\ \0
   - Block comment nesting is handled lexically
*)
LIdent              = lower , { identTail } ;
UIdent              = upper , { identTail } ;
identTail           = lower | upper | digit | "_" | "'" ;

String              = '"' , { stringChar } , '"' ;
stringChar          = escape | ( any - ['"' | '\\'] ) ;
escape              = "\\" , ( "n" | "t" | "r" | "\"" | "\\" | "0" ) ;

(* Integer literal: optional leading '-' adjacent to digits.
   Range validation is performed at typecheck time against the declared type
   (e.g. Int32 or UInt8); there is no defaulting. *)
Int                 = [ "-" ] , digit , { digit } ;

LineText            = { any - ['\n'] } ;
BlockText           = { any } ;

Terminator          = NEWLINE | EOF ;

lower               = 'a'…'z' ;
upper               = 'A'…'Z' ;
digit               = '0'…'9' ;
any                 = U+0000…U+10FFFF ;
