-- Property: `mulInt32 1 a == Right a`. Left-identity of one under
-- multiplication. Single Int32 input. Multiplying by 1 is always in
-- range, so neither UNDERFLOW nor OVERFLOW can fire on a well-formed
-- input.
import IO.Stdout

property : Int32 -> Either (UnderflowError | OverflowError) Bool
property a = do
  r <- mulInt32 1 a
  pureEither (eqInt32 r a)

main : String -> IO Unit
main raw =
  let res : Either (ParseError | UnderflowError | OverflowError) Bool = do
        a <- parseInt32 raw
        property a
   in case res of
        Left e -> case e of
          (_ : ParseError) -> IO.Stdout.print "PARSE_ERROR"
          (_ : UnderflowError) -> IO.Stdout.print "UNDERFLOW"
          (_ : OverflowError) -> IO.Stdout.print "OVERFLOW"
        Right True -> IO.Stdout.print "OK"
        Right False -> IO.Stdout.print "FAIL"
