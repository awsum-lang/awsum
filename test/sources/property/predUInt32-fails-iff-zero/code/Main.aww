{- Property: `predUInt32 x` fails iff `x == 0` (the UInt32 min). Single
   UInt32 input; the only error path is a parse failure. -}

import IO.Stdout
import IO.Stdin

property : UInt32 -> Bool
property x = case predUInt32 x of
  Left _ -> eqUInt32 x minUInt32
  Right _ -> not (eqUInt32 x minUInt32)

printOutcome : Bool -> IO Never Unit
printOutcome holds = case holds of
  True -> IO.Stdout.print "OK"
  False -> IO.Stdout.print "FAIL"

main : IO Never Unit
main = IO.Stdin.readAllString
  |> andThenIO (\raw -> eitherToIO (parseUInt32 raw))
  |> andThenIO (\x -> printOutcome (property x))
  |> handleErrorIO onError

onError : (StringTooLong | InvalidUtf8 | ParseError) -> IO Never Unit
onError e = case e of
  StringTooLong -> IO.Stdout.print "STRING_TOO_LONG"
  InvalidUtf8 -> IO.Stdout.print "INVALID_UTF8"
  ParseError -> IO.Stdout.print "PARSE_ERROR"
