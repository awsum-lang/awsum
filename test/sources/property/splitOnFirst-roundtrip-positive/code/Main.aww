{- Property: if `splitOnFirst sep s == Just (Tuple2 a b)`, then
   `a ++ sep ++ b == s`. Input: "sep:s" where sep is non-empty; s
   is `a ++ sep ++ b` so the split is guaranteed to find a match.
   The property emits the round-tripped string. -}

import IO.Stdout
import IO.Stdin

type NoMatch = NoMatch

parseInput : String -> Either ParseError (Tuple2 String String)
parseInput raw = case splitOnFirst ":" raw of
  Nothing -> Left ParseError
  Just (Tuple2 sep s) -> Right (Tuple2 sep s)

property : String -> String -> Either (NoMatch | StringTooLong) String
property sep s = case splitOnFirst sep s of
  Nothing -> Left NoMatch
  Just (Tuple2 a b) -> do
    s0 <- a ++ sep
    s0 ++ b

main : IO Never Unit
main = IO.Stdin.readAllString
  |> andThenIO (\raw -> eitherToIO (parseInput raw))
  |> andThenIO (\(Tuple2 sep s) -> eitherToIO (property sep s))
  |> andThenIO IO.Stdout.print
  |> handleErrorIO onError

onError : (StringTooLong | InvalidUtf8 | ParseError | NoMatch) -> IO Never Unit
onError e = case e of
  StringTooLong -> IO.Stdout.print "STRING_TOO_LONG"
  InvalidUtf8 -> IO.Stdout.print "INVALID_UTF8"
  ParseError -> IO.Stdout.print "PARSE_ERROR"
  NoMatch -> IO.Stdout.print "NO_MATCH"
