{- Property: `addUInt8 a 0 == Right a`. Right-identity of zero under
   addition. Single UInt8 input. Adding 0 is always in range, so
   OVERFLOW cannot fire on a well-formed input. -}

import IO.Stdout
import IO.Stdin

property : UInt8 -> Either OverflowError Bool
property a = do
  r <- addUInt8 a 0
  pureEither (eqUInt8 r a)

showOutcome : Bool -> String
showOutcome holds = case holds of
  True -> "OK"
  False -> "FAIL"

main : IO Never Unit
main = IO.Stdin.readAllString
  |> andThenIO (\raw -> eitherToIO (parseUInt8 raw))
  |> andThenIO (\a -> eitherToIO (property a))
  |> andThenIO (\holds -> IO.Stdout.print (showOutcome holds))
  |> handleErrorIO onError

onError : (StringTooLong | InvalidUtf8 | ParseError | OverflowError) -> IO Never Unit
onError e = case e of
  StringTooLong -> IO.Stdout.print "STRING_TOO_LONG"
  InvalidUtf8 -> IO.Stdout.print "INVALID_UTF8"
  ParseError -> IO.Stdout.print "PARSE_ERROR"
  OverflowError -> IO.Stdout.print "OVERFLOW"
