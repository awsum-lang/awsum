-- Property: `addInt32 a b == addInt32 b a` whenever the sum stays in
-- range. Input format: "a:b" where a and b are decimal Int32 literals.
-- The Haskell-side generator picks pairs constructively from the
-- no-overflow region (see `NoOverflowAddInt32Pair` in PropertySpec.hs),
-- so the OVERFLOW branch is never expected to fire.
import IO.Stdout

parsePair : String -> Either ParseError (Tuple2 Int32 Int32)
parsePair raw = case splitOnFirst ":" raw of
  Nothing -> Left ParseError
  Just t -> case t of
    Tuple2 aStr bStr -> case parseInt32 aStr of
      Left e -> Left e
      Right a -> case parseInt32 bStr of
        Left e -> Left e
        Right b -> Right (Tuple2 a b)

main : String -> IO Unit
main raw = case parsePair raw of
  Left _ -> IO.Stdout.print "PARSE_ERROR"
  Right t -> case t of
    Tuple2 a b -> case addInt32 a b of
      Left _ -> IO.Stdout.print "OVERFLOW"
      Right ab -> case addInt32 b a of
        Left _ -> IO.Stdout.print "OVERFLOW"
        Right ba -> case eqInt32 ab ba of
          True -> IO.Stdout.print "OK"
          False -> IO.Stdout.print ("FAIL: " ++ showInt32 ab ++ " /= " ++ showInt32 ba)
