-- Property: `addUInt8 (addUInt8 a b) c == addUInt8 a (addUInt8 b c)`
-- whenever every intermediate sum stays in range. Input format:
-- "a:b:c". The Haskell-side generator picks triples constructively
-- from the no-overflow region, so OVERFLOW is never expected to
-- fire on a well-formed input.
import IO.Stdout
import IO.Args

parseInput : String -> Either ParseError (Tuple3 UInt8 UInt8 UInt8)
parseInput raw = case splitOnFirst ":" raw of
  Nothing -> Left ParseError
  Just (Tuple2 aStr rest) -> case splitOnFirst ":" rest of
    Nothing -> Left ParseError
    Just (Tuple2 bStr cStr) -> do
      a <- parseUInt8 aStr
      b <- parseUInt8 bStr
      c <- parseUInt8 cStr
      pureEither (Tuple3 a b c)

property : UInt8 -> UInt8 -> UInt8 -> Either OverflowError Bool
property a b c = do
  ab <- addUInt8 a b
  abc <- addUInt8 ab c
  bc <- addUInt8 b c
  aBc <- addUInt8 a bc
  pureEither (eqUInt8 abc aBc)

runMain : Either (StringTooLong | UnpairedUtf16Surrogate) String -> IO Never Unit
runMain rawArg =
  let res : Either (StringTooLong | UnpairedUtf16Surrogate | ParseError | OverflowError) Bool = (do
        raw <- rawArg
        Tuple3 a b c <- parseInput raw
        property a b c
      )
   in case res of
        Left e -> case e of
          StringTooLong -> IO.Stdout.print "STRING_TOO_LONG"
          UnpairedUtf16Surrogate -> IO.Stdout.print "UNPAIRED_UTF16_SURROGATE"
          ParseError -> IO.Stdout.print "PARSE_ERROR"
          OverflowError -> IO.Stdout.print "OVERFLOW"
        Right True -> IO.Stdout.print "OK"
        Right False -> IO.Stdout.print "FAIL"

main : IO Never Unit
main =
  IO.Args.getArgs
    |> andThenIO (\s -> runMain (Right s))
    |> handleErrorIO (\e -> runMain (Left e))
