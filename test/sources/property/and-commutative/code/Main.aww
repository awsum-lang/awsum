-- Property: `and a b == and b a`. The property emits
-- `boolToStr (and a b) ++ boolToStr (and b a)` — both halves
-- should match Haskell's independently computed `(a && b)`.
-- Input format: "a:b" with a, b as "0" / "1" decimal strings.
import IO.Stdout

intToBool : UInt8 -> Bool
intToBool n = case eqUInt8 n 0 of
  True -> False
  False -> True

boolToStr : Bool -> String
boolToStr b = case b of
  True -> "T"
  False -> "F"

parseInput : String -> Either ParseError (Tuple2 UInt8 UInt8)
parseInput raw = case splitOnFirst ":" raw of
  Nothing -> Left ParseError
  Just (Tuple2 sa sb) -> do
    na <- parseUInt8 sa
    nb <- parseUInt8 sb
    pureEither (Tuple2 na nb)

property : UInt8 -> UInt8 -> Either StringTooLong String
property na nb =
  let a = intToBool na
      b = intToBool nb
   in boolToStr (and a b) ++ boolToStr (and b a)

main : Either (StringTooLong | UnpairedUtf16Surrogate) String -> IO Never Unit
main rawArg =
  let res : Either (StringTooLong | UnpairedUtf16Surrogate | ParseError) String = (do
        raw <- rawArg
        Tuple2 na nb <- parseInput raw
        property na nb
      )
   in case res of
        Left e -> case e of
          (_ : StringTooLong) -> IO.Stdout.print "STRING_TOO_LONG"
          (_ : UnpairedUtf16Surrogate) -> IO.Stdout.print "UNPAIRED_UTF16_SURROGATE"
          (_ : ParseError) -> IO.Stdout.print "PARSE_ERROR"
        Right s -> IO.Stdout.print s
