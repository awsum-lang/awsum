-- Property: `and a b == and b a`. Output is `boolToStr (and a b) ++
-- boolToStr (and b a)` — both halves should match Haskell's
-- independently computed `(a && b)`.
import IO.Stdout

intToBool : UInt8 -> Bool
intToBool n = case eqUInt8 n 0 of
  True -> False
  False -> True

boolToStr : Bool -> String
boolToStr b = case b of
  True -> "T"
  False -> "F"

main : String -> IO Unit
main raw = case splitOnFirst ":" raw of
  Nothing -> IO.Stdout.print "PARSE_ERROR"
  Just t -> case t of
    Tuple2 sa sb -> case parseUInt8 sa of
      Left _ -> IO.Stdout.print "PARSE_ERROR"
      Right na -> case parseUInt8 sb of
        Left _ -> IO.Stdout.print "PARSE_ERROR"
        Right nb -> IO.Stdout.print (boolToStr (and (intToBool na) (intToBool nb)) ++ boolToStr (and (intToBool nb) (intToBool na)))
