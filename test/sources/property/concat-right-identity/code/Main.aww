-- Property: `s ++ "" == s` for every String. The Haskell side hands
-- back the input unchanged as the expected output, so this is an
-- expectedOutput-style property (the property prints the computed
-- value, Haskell expects the input back). There's nothing to parse
-- and nothing that can fail, so the property runs over 'main raw'
-- directly.
import IO.Stdout
import IO.Args

property : String -> Either StringTooLong String
property s = s ++ ""

runMain : Either (StringTooLong | UnpairedUtf16Surrogate) String -> IO Never Unit
runMain rawArg =
  let res : Either (StringTooLong | UnpairedUtf16Surrogate) String = (do
        raw <- rawArg
        property raw
      )
   in case res of
        Left e -> case e of
          StringTooLong -> IO.Stdout.print "STRING_TOO_LONG"
          UnpairedUtf16Surrogate -> IO.Stdout.print "UNPAIRED_UTF16_SURROGATE"
        Right s -> IO.Stdout.print s

main : IO Never Unit
main =
  IO.Args.getArgs
    |> andThenIO (\s -> runMain (Right s))
    |> handleErrorIO (\e -> runMain (Left e))
