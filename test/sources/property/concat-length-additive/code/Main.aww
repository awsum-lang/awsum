{- Property: for any pair of valid-UTF-16 inputs, all three
   string-length functions are additive under (++). On the Right
   path Awsum prints

     lengthCodePoints       (a ++ b)
       : lengthUtf16CodeUnits (a ++ b)
       : lengthUtf8Bytes      (a ++ b)

   A backend whose '__concat' produced a buffer of wrong size, or
   which miscounted at the join between two operands, would diverge
   from at least one peer.

   Input: "a:b". The colon is excluded from both operand
   alphabets. -}

import IO.Stdout
import IO.Stdin

parseInput : String -> Either ParseError (Tuple2 String String)
parseInput raw = case splitOnFirst ":" raw of
  Nothing -> Left ParseError
  Just (Tuple2 a b) -> Right (Tuple2 a b)

property : String -> String -> Either StringTooLong String
property a b = do
  ab <- a ++ b
  let cp = showUInt32 (lengthCodePoints ab)
  let cu = showUInt32 (lengthUtf16CodeUnits ab)
  let bs = showUInt32 (lengthUtf8Bytes ab)
  s0 <- cp ++ ":"
  s1 <- s0 ++ cu
  s2 <- s1 ++ ":"
  s2 ++ bs

main : IO Never Unit
main = IO.Stdin.readAllString
  |> andThenIO (\raw -> eitherToIO (parseInput raw))
  |> andThenIO (\(Tuple2 a b) -> eitherToIO (property a b))
  |> andThenIO IO.Stdout.print
  |> handleErrorIO onError

onError : (StringTooLong | InvalidUtf8 | ParseError) -> IO Never Unit
onError e = case e of
  StringTooLong -> IO.Stdout.print "STRING_TOO_LONG"
  InvalidUtf8 -> IO.Stdout.print "INVALID_UTF8"
  ParseError -> IO.Stdout.print "PARSE_ERROR"
