{- Property: `succInt32 x` fails (returns `Left _`) iff `x == maxInt32`.
   Both branches must be exercised, so the Haskell-side generator
   biases towards `maxInt32` via QuickCheck `frequency` (~10% chance)
   so the boundary case shows up regularly in 100-test runs. -}

import IO.Stdout
import IO.Stdin

property : Int32 -> Bool
property x = case succInt32 x of
  Left _ -> eqInt32 x maxInt32
  Right _ -> not (eqInt32 x maxInt32)

runMain : Either (StringTooLong | InvalidUtf8) String -> IO Never Unit
runMain rawArg =
  let res : Either (StringTooLong | InvalidUtf8 | ParseError) Bool = (do
        raw <- rawArg
        x <- parseInt32 raw
        pureEither (property x)
      )
   in case res of
        Left e -> case e of
          StringTooLong -> IO.Stdout.print "STRING_TOO_LONG"
          InvalidUtf8 -> IO.Stdout.print "INVALID_UTF8"
          ParseError -> IO.Stdout.print "PARSE_ERROR"
        Right True -> IO.Stdout.print "OK"
        Right False -> IO.Stdout.print "FAIL"

main : IO Never Unit
main = IO.Stdin.readAllString
  |> andThenIO (\s -> runMain (Right s))
  |> handleErrorIO (\e -> runMain (Left e))
