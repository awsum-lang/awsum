-- Property: `succInt32 x` fails (returns `Left _`) iff `x == maxInt32`.
-- Both branches must be exercised, so the Haskell-side generator
-- biases towards `maxInt32` via QuickCheck `frequency` (~10% chance)
-- so the boundary case shows up regularly in 100-test runs.
import IO.Stdout

property : Int32 -> Bool
property x = case succInt32 x of
  Left _ -> eqInt32 x maxInt32
  Right _ -> not (eqInt32 x maxInt32)

main : String -> IO Unit
main raw =
  let res : Either ParseError Bool = do
        x <- parseInt32 raw
        pureEither (property x)
   in case res of
        Left _ -> IO.Stdout.print "PARSE_ERROR"
        Right True -> IO.Stdout.print "OK"
        Right False -> IO.Stdout.print "FAIL"
