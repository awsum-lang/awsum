{- Property: `addUInt32 0 a == Right a`. Left-identity of zero under
   addition. Single UInt32 input. Adding 0 is always in range, so
   OVERFLOW cannot fire on a well-formed input. -}

import IO.Stdout
import IO.Stdin

property : UInt32 -> Either OverflowError Bool
property a = do
  r <- addUInt32 0 a
  pureEither (eqUInt32 r a)

printOutcome : Bool -> IO Never Unit
printOutcome holds = case holds of
  True -> IO.Stdout.print "OK"
  False -> IO.Stdout.print "FAIL"

main : IO Never Unit
main = IO.Stdin.readAllString
  |> andThenIO (\raw -> eitherToIO (parseUInt32 raw))
  |> andThenIO (\a -> eitherToIO (property a))
  |> andThenIO printOutcome
  |> handleErrorIO onError

onError : (StringTooLong | InvalidUtf8 | ParseError | OverflowError) -> IO Never Unit
onError e = case e of
  StringTooLong -> IO.Stdout.print "STRING_TOO_LONG"
  InvalidUtf8 -> IO.Stdout.print "INVALID_UTF8"
  ParseError -> IO.Stdout.print "PARSE_ERROR"
  OverflowError -> IO.Stdout.print "OVERFLOW"
