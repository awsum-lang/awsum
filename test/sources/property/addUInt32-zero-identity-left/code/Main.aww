{- Property: `addUInt32 0 a == Right a`. Left-identity of zero under
   addition. Single UInt32 input. Adding 0 is always in range, so
   OVERFLOW cannot fire on a well-formed input. -}

import IO.Stdout
import IO.Stdin

property : UInt32 -> Either OverflowError Bool
property a = do
  r <- addUInt32 0 a
  pureEither (eqUInt32 r a)

runMain : Either (StringTooLong | UnpairedUtf16Surrogate) String -> IO Never Unit
runMain rawArg =
  let res : Either (StringTooLong | UnpairedUtf16Surrogate | ParseError | OverflowError) Bool = (do
        raw <- rawArg
        a <- parseUInt32 raw
        property a
      )
   in case res of
        Left e -> case e of
          StringTooLong -> IO.Stdout.print "STRING_TOO_LONG"
          UnpairedUtf16Surrogate -> IO.Stdout.print "UNPAIRED_UTF16_SURROGATE"
          ParseError -> IO.Stdout.print "PARSE_ERROR"
          OverflowError -> IO.Stdout.print "OVERFLOW"
        Right True -> IO.Stdout.print "OK"
        Right False -> IO.Stdout.print "FAIL"

main : IO Never Unit
main = IO.Stdin.readAll
  |> andThenIO (\s -> runMain (Right s))
  |> handleErrorIO (\e -> runMain (Left e))
