{- Property: `negInt32 x + x == 0` for every Int32 except `minInt32`
   (which can't be negated in two's complement). Single Int32 input.
   The Haskell-side generator (`NonMinInt32`) excludes `minInt32`,
   so neither error branch is expected to fire. -}

import IO.Stdout
import IO.Stdin

property : Int32 -> Either (UnderflowError | OverflowError) Bool
property x = do
  negX <- negInt32 x
  s <- addInt32 negX x
  pureEither (eqInt32 s 0)

runMain : Either (StringTooLong | UnpairedUtf16Surrogate) String -> IO Never Unit
runMain rawArg =
  let res : Either (StringTooLong | UnpairedUtf16Surrogate | ParseError | UnderflowError | OverflowError) Bool = (do
        raw <- rawArg
        x <- parseInt32 raw
        property x
      )
   in case res of
        Left e -> case e of
          StringTooLong -> IO.Stdout.print "STRING_TOO_LONG"
          UnpairedUtf16Surrogate -> IO.Stdout.print "UNPAIRED_UTF16_SURROGATE"
          ParseError -> IO.Stdout.print "PARSE_ERROR"
          UnderflowError -> IO.Stdout.print "UNDERFLOW"
          OverflowError -> IO.Stdout.print "OVERFLOW"
        Right True -> IO.Stdout.print "OK"
        Right False -> IO.Stdout.print "FAIL"

main : IO Never Unit
main = IO.Stdin.readAll
  |> andThenIO (\s -> runMain (Right s))
  |> handleErrorIO (\e -> runMain (Left e))
