-- Property: `"" ++ s == s` for every String. Mirrors
-- `concat-right-identity` on the other side. There's nothing to
-- parse and nothing that can fail, so the property runs over
-- 'main raw' directly — Haskell expects the input back.
import IO.Stdout
import IO.Stdin

property : String -> Either StringTooLong String
property s = "" ++ s

runMain : Either (StringTooLong | UnpairedUtf16Surrogate) String -> IO Never Unit
runMain rawArg =
  let res : Either (StringTooLong | UnpairedUtf16Surrogate) String = (do
        raw <- rawArg
        property raw
      )
   in case res of
        Left e -> case e of
          StringTooLong -> IO.Stdout.print "STRING_TOO_LONG"
          UnpairedUtf16Surrogate -> IO.Stdout.print "UNPAIRED_UTF16_SURROGATE"
        Right s -> IO.Stdout.print s

main : IO Never Unit
main = IO.Stdin.readAll
  |> andThenIO (\s -> runMain (Right s))
  |> handleErrorIO (\e -> runMain (Left e))
