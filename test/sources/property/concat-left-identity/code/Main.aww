{- Property: `"" ++ s == s` for every String. Mirrors
   `concat-right-identity` on the other side. There's nothing to
   parse and nothing that can fail, so the property runs over the
   raw input directly. -}

import IO.Stdout
import IO.Stdin

property : String -> Either StringTooLong String
property s = "" ++ s

main : IO Never Unit
main = IO.Stdin.readAllString
  |> andThenIO (\raw -> eitherToIO (property raw))
  |> andThenIO IO.Stdout.print
  |> handleErrorIO onError

onError : (StringTooLong | InvalidUtf8) -> IO Never Unit
onError e = case e of
  StringTooLong -> IO.Stdout.print "STRING_TOO_LONG"
  InvalidUtf8 -> IO.Stdout.print "INVALID_UTF8"
