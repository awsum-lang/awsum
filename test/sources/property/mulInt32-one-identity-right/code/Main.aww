{- Property: `mulInt32 a 1 == Right a`. Right-identity of one under
   multiplication. Single Int32 input. Multiplying by 1 is always in
   range, so neither UNDERFLOW nor OVERFLOW can fire on a well-formed
   input. -}

import IO.Stdout
import IO.Stdin

property : Int32 -> Either (UnderflowError | OverflowError) Bool
property a = do
  r <- mulInt32 a 1
  pureEither (eqInt32 r a)

runMain : Either (StringTooLong | InvalidUtf8) String -> IO Never Unit
runMain rawArg =
  let res : Either (StringTooLong | InvalidUtf8 | ParseError | UnderflowError | OverflowError) Bool = (do
        raw <- rawArg
        a <- parseInt32 raw
        property a
      )
   in case res of
        Left e -> case e of
          StringTooLong -> IO.Stdout.print "STRING_TOO_LONG"
          InvalidUtf8 -> IO.Stdout.print "INVALID_UTF8"
          ParseError -> IO.Stdout.print "PARSE_ERROR"
          UnderflowError -> IO.Stdout.print "UNDERFLOW"
          OverflowError -> IO.Stdout.print "OVERFLOW"
        Right True -> IO.Stdout.print "OK"
        Right False -> IO.Stdout.print "FAIL"

main : IO Never Unit
main = IO.Stdin.readAllString
  |> andThenIO (\s -> runMain (Right s))
  |> handleErrorIO (\e -> runMain (Left e))
