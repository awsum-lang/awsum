{- Property: `predUInt8 x` fails iff `x == 0` (the UInt8 min). Single
   UInt8 input; the only error path is a parse failure. -}

import IO.Stdout
import IO.Stdin

property : UInt8 -> Bool
property x = case predUInt8 x of
  Left _ -> eqUInt8 x minUInt8
  Right _ -> not (eqUInt8 x minUInt8)

showOutcome : Bool -> String
showOutcome holds = case holds of
  True -> "OK"
  False -> "FAIL"

main : IO Never Unit
main = IO.Stdin.readAllString
  |> andThenIO (\raw -> eitherToIO (parseUInt8 raw))
  |> andThenIO (\x -> IO.Stdout.print (showOutcome (property x)))
  |> handleErrorIO onError

onError : (StringTooLong | InvalidUtf8 | ParseError) -> IO Never Unit
onError e = case e of
  StringTooLong -> IO.Stdout.print "STRING_TOO_LONG"
  InvalidUtf8 -> IO.Stdout.print "INVALID_UTF8"
  ParseError -> IO.Stdout.print "PARSE_ERROR"
