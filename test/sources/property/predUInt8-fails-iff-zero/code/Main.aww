-- Property: `predUInt8 x` fails iff `x == 0` (the UInt8 min).
import IO.Stdout

minUInt8 : UInt8
minUInt8 = 0

main : String -> IO Unit
main raw = case parseUInt8 raw of
  Left _ -> IO.Stdout.print "PARSE_ERROR"
  Right x -> case eqUInt8 x minUInt8 of
    True -> case predUInt8 x of
      Left _ -> IO.Stdout.print "OK"
      Right _ -> IO.Stdout.print "FAIL: pred at 0 should fail"
    False -> case predUInt8 x of
      Left _ -> IO.Stdout.print "FAIL: pred above 0 should succeed"
      Right _ -> IO.Stdout.print "OK"
