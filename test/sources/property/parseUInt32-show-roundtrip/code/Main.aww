-- Property: `parseUInt32 (showUInt32 x) == Right x` for any UInt32 0..255.
-- Mirror of `parseInt32-show-roundtrip` for the unsigned 8-bit type.
import IO.Stdout

property : UInt32 -> String
property v = showUInt32 v

main : Either (StringTooLong | UnpairedUtf16Surrogate) String -> IO Never Unit
main rawArg =
  let res : Either (StringTooLong | UnpairedUtf16Surrogate | ParseError) String = (do
        raw <- rawArg
        v <- parseUInt32 raw
        pureEither (property v)
      )
   in case res of
        Left e -> case e of
          StringTooLong -> IO.Stdout.print "STRING_TOO_LONG"
          UnpairedUtf16Surrogate -> IO.Stdout.print "UNPAIRED_UTF16_SURROGATE"
          ParseError -> IO.Stdout.print "PARSE_ERROR"
        Right s -> IO.Stdout.print s
