{- Property: `parseUInt32 (showUInt32 x) == Right x` for any UInt32.
   Tests that the show / parse pair round-trips; the output echoes
   the input. Input: one UInt32 decimal literal. -}

import IO.Stdout
import IO.Stdin

property : UInt32 -> String
property v = showUInt32 v

main : IO Never Unit
main = IO.Stdin.readAllString
  |> andThenIO (\raw -> eitherToIO (parseUInt32 raw))
  |> andThenIO (\v -> IO.Stdout.print (property v))
  |> handleErrorIO onError

onError : (StringTooLong | InvalidUtf8 | ParseError) -> IO Never Unit
onError e = case e of
  StringTooLong -> IO.Stdout.print "STRING_TOO_LONG"
  InvalidUtf8 -> IO.Stdout.print "INVALID_UTF8"
  ParseError -> IO.Stdout.print "PARSE_ERROR"
