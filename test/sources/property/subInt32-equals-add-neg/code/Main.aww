{- Property: `subInt32 a b == addInt32 a (negInt32 b)` whenever every
   intermediate value (negB, subResult, addResult) stays in Int32
   range. Input format: "a:b". Inputs stay in the no-overflow region,
   so neither UNDERFLOW nor OVERFLOW fires. -}

import IO.Stdout
import IO.Stdin

property : Int32 -> Int32 -> Either (UnderflowError | OverflowError) Bool
property a b = do
  negB <- negInt32 b
  subResult <- subInt32 a b
  addResult <- addInt32 a negB
  pureEither (eqInt32 subResult addResult)

showOutcome : Bool -> String
showOutcome holds = case holds of
  True -> "OK"
  False -> "FAIL"

main : IO Never Unit
main = IO.Stdin.readAllString
  |> andThenIO (\raw -> eitherToIO (parseInput raw))
  |> andThenIO (\(Tuple2 a b) -> eitherToIO (property a b))
  |> andThenIO (\holds -> IO.Stdout.print (showOutcome holds))
  |> handleErrorIO onError

parseInput : String -> Either ParseError (Tuple2 Int32 Int32)
parseInput raw = case splitOnFirst ":" raw of
  Nothing -> Left ParseError
  Just (Tuple2 aStr bStr) -> do
    a <- parseInt32 aStr
    b <- parseInt32 bStr
    pureEither (Tuple2 a b)

onError : (StringTooLong | InvalidUtf8 | ParseError | UnderflowError | OverflowError) -> IO Never Unit
onError e = case e of
  StringTooLong -> IO.Stdout.print "STRING_TOO_LONG"
  InvalidUtf8 -> IO.Stdout.print "INVALID_UTF8"
  ParseError -> IO.Stdout.print "PARSE_ERROR"
  UnderflowError -> IO.Stdout.print "UNDERFLOW"
  OverflowError -> IO.Stdout.print "OVERFLOW"
