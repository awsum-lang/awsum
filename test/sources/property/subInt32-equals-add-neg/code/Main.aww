-- Property: `subInt32 a b == addInt32 a (negInt32 b)` whenever every
-- intermediate value (negB, subResult, addResult) stays in Int32
-- range. Input format: "a:b". The Haskell-side generator picks
-- pairs constructively, so neither UNDERFLOW nor OVERFLOW is
-- expected to fire.
import IO.Stdout
import IO.Stdin

parseInput : String -> Either ParseError (Tuple2 Int32 Int32)
parseInput raw = case splitOnFirst ":" raw of
  Nothing -> Left ParseError
  Just (Tuple2 aStr bStr) -> do
    a <- parseInt32 aStr
    b <- parseInt32 bStr
    pureEither (Tuple2 a b)

property : Int32 -> Int32 -> Either (UnderflowError | OverflowError) Bool
property a b = do
  negB <- negInt32 b
  subResult <- subInt32 a b
  addResult <- addInt32 a negB
  pureEither (eqInt32 subResult addResult)

runMain : Either (StringTooLong | UnpairedUtf16Surrogate) String -> IO Never Unit
runMain rawArg =
  let res : Either (StringTooLong | UnpairedUtf16Surrogate | ParseError | UnderflowError | OverflowError) Bool = (do
        raw <- rawArg
        Tuple2 a b <- parseInput raw
        property a b
      )
   in case res of
        Left e -> case e of
          StringTooLong -> IO.Stdout.print "STRING_TOO_LONG"
          UnpairedUtf16Surrogate -> IO.Stdout.print "UNPAIRED_UTF16_SURROGATE"
          ParseError -> IO.Stdout.print "PARSE_ERROR"
          UnderflowError -> IO.Stdout.print "UNDERFLOW"
          OverflowError -> IO.Stdout.print "OVERFLOW"
        Right True -> IO.Stdout.print "OK"
        Right False -> IO.Stdout.print "FAIL"

main : IO Never Unit
main = IO.Stdin.readAll
  |> andThenIO (\s -> runMain (Right s))
  |> handleErrorIO (\e -> runMain (Left e))
