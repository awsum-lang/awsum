-- Property: `splitOnFirst sep s == Nothing` whenever `sep` is not a
-- substring of `s`. The Haskell-side generator picks `sep` from
-- `[A-Z]+` and `s` from `[a-z]*` — disjoint alphabets guarantee
-- non-occurrence by construction.
import IO.Stdout
import IO.Stdin

parseInput : String -> Either ParseError (Tuple2 String String)
parseInput raw = case splitOnFirst ":" raw of
  Nothing -> Left ParseError
  Just (Tuple2 sep s) -> Right (Tuple2 sep s)

property : String -> String -> Bool
property sep s = case splitOnFirst sep s of
  Nothing -> True
  Just _ -> False

runMain : Either (StringTooLong | UnpairedUtf16Surrogate) String -> IO Never Unit
runMain rawArg =
  let res : Either (StringTooLong | UnpairedUtf16Surrogate | ParseError) Bool = (do
        raw <- rawArg
        Tuple2 sep s <- parseInput raw
        pureEither (property sep s)
      )
   in case res of
        Left e -> case e of
          StringTooLong -> IO.Stdout.print "STRING_TOO_LONG"
          UnpairedUtf16Surrogate -> IO.Stdout.print "UNPAIRED_UTF16_SURROGATE"
          ParseError -> IO.Stdout.print "PARSE_ERROR"
        Right True -> IO.Stdout.print "OK"
        Right False -> IO.Stdout.print "FAIL"

main : IO Never Unit
main = IO.Stdin.readAll
  |> andThenIO (\s -> runMain (Right s))
  |> handleErrorIO (\e -> runMain (Left e))
