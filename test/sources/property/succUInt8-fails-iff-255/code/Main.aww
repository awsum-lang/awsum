-- Property: `succUInt8 x` fails iff `x == 255` (the UInt8 max). Both
-- branches must be exercised, so the Haskell-side generator biases
-- towards 255 to make the boundary case appear in 100-test runs.
import IO.Stdout

property : UInt8 -> Bool
property x = case succUInt8 x of
  Left _ -> eqUInt8 x maxUInt8
  Right _ -> not (eqUInt8 x maxUInt8)

main : String -> IO Unit
main raw =
  let res : Either ParseError Bool = do
        x <- parseUInt8 raw
        pureEither (property x)
   in case res of
        Left _ -> IO.Stdout.print "PARSE_ERROR"
        Right True -> IO.Stdout.print "OK"
        Right False -> IO.Stdout.print "FAIL"
