{- Property: `not (not b) == b` for every Bool. Bool comes in as a decimal
   "0" / "1" string (Awsum has no String->Bool builtin); the property emits
   "T" / "F". -}

import IO.Stdout
import IO.Stdin

intToBool : UInt8 -> Bool
intToBool n = case eqUInt8 n 0 of
  True -> False
  False -> True

boolToStr : Bool -> String
boolToStr b = case b of
  True -> "T"
  False -> "F"

property : UInt8 -> String
property n = boolToStr (not (not (intToBool n)))

main : IO Never Unit
main = IO.Stdin.readAllString
  |> andThenIO (\raw -> eitherToIO (parseUInt8 raw))
  |> andThenIO (\n -> IO.Stdout.print (property n))
  |> handleErrorIO onError

onError : (StringTooLong | InvalidUtf8 | ParseError) -> IO Never Unit
onError e = case e of
  StringTooLong -> IO.Stdout.print "STRING_TOO_LONG"
  InvalidUtf8 -> IO.Stdout.print "INVALID_UTF8"
  ParseError -> IO.Stdout.print "PARSE_ERROR"
