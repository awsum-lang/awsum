-- Property: `not (not b) == b` for every Bool. Bool is encoded as a
-- decimal "0" / "1" string on the way in (Awsum has no String->Bool
-- builtin and no eqString); the property emits "T" / "F" so Haskell
-- can compare against its own boolPrint of the original input.
import IO.Stdout
import IO.Stdin

intToBool : UInt8 -> Bool
intToBool n = case eqUInt8 n 0 of
  True -> False
  False -> True

boolToStr : Bool -> String
boolToStr b = case b of
  True -> "T"
  False -> "F"

property : UInt8 -> String
property n = boolToStr (not (not (intToBool n)))

runMain : Either (StringTooLong | UnpairedUtf16Surrogate) String -> IO Never Unit
runMain rawArg =
  let res : Either (StringTooLong | UnpairedUtf16Surrogate | ParseError) String = (do
        raw <- rawArg
        n <- parseUInt8 raw
        pureEither (property n)
      )
   in case res of
        Left e -> case e of
          StringTooLong -> IO.Stdout.print "STRING_TOO_LONG"
          UnpairedUtf16Surrogate -> IO.Stdout.print "UNPAIRED_UTF16_SURROGATE"
          ParseError -> IO.Stdout.print "PARSE_ERROR"
        Right s -> IO.Stdout.print s

main : IO Never Unit
main = IO.Stdin.readAll
  |> andThenIO (\s -> runMain (Right s))
  |> handleErrorIO (\e -> runMain (Left e))
