-- Property: `mulUInt8 1 a == Right a`. Left-identity of one under
-- multiplication. Single UInt8 input. Multiplying by 1 is always in
-- range, so OVERFLOW cannot fire on a well-formed input.
import IO.Stdout

property : UInt8 -> Either OverflowError Bool
property a = do
  r <- mulUInt8 1 a
  pureEither (eqUInt8 r a)

main : String -> IO Unit
main raw =
  let res : Either (ParseError | OverflowError) Bool = do
        a <- parseUInt8 raw
        property a
   in case res of
        Left e -> case e of
          (_ : ParseError) -> IO.Stdout.print "PARSE_ERROR"
          (_ : OverflowError) -> IO.Stdout.print "OVERFLOW"
        Right True -> IO.Stdout.print "OK"
        Right False -> IO.Stdout.print "FAIL"
