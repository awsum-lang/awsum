-- Property: `(a ++ b) ++ c == a ++ (b ++ c)` for every triple of
-- Strings (over an alphabet that excludes ':'). Input: "a:b:c". Output:
-- both groupings separated by ':' so Haskell can verify each half
-- against an independently computed concatenation.
import IO.Stdout

unwrap3 : String -> Maybe (Tuple3 String String String)
unwrap3 raw = case splitOnFirst ":" raw of
  Nothing -> Nothing
  Just t1 -> case t1 of
    Tuple2 a rest -> case splitOnFirst ":" rest of
      Nothing -> Nothing
      Just t2 -> case t2 of
        Tuple2 b c -> Just (Tuple3 a b c)

main : String -> IOUnit
main raw = case unwrap3 raw of
  Nothing -> IO.Stdout.print "PARSE_ERROR"
  Just t -> case t of
    Tuple3 a b c -> IO.Stdout.print (((a ++ b) ++ c) ++ ":" ++ (a ++ (b ++ c)))
