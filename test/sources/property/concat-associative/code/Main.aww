-- Property: `(a ++ b) ++ c == a ++ (b ++ c)` for every triple of
-- Strings (over an alphabet that excludes ':'). Input: "a:b:c".
-- The property emits both groupings separated by ':' so Haskell
-- can verify each half against an independently computed
-- concatenation.
import IO.Stdout

parseInput : String -> Either ParseError (Tuple3 String String String)
parseInput raw = case splitOnFirst ":" raw of
  Nothing -> Left ParseError
  Just (Tuple2 a rest) -> case splitOnFirst ":" rest of
    Nothing -> Left ParseError
    Just (Tuple2 b c) -> Right (Tuple3 a b c)

property : String -> String -> String -> Either StringTooLong String
property a b c = do
  ab <- a ++ b
  abc <- ab ++ c
  bc <- b ++ c
  aBc <- a ++ bc
  delim <- abc ++ ":"
  delim ++ aBc

main : Either (StringTooLong | UnpairedUtf16Surrogate) String -> IO Never Unit
main rawArg =
  let res : Either (StringTooLong | UnpairedUtf16Surrogate | ParseError) String = do
        raw <- rawArg
        Tuple3 a b c <- parseInput raw
        property a b c
   in case res of
        Left e -> case e of
          (_ : StringTooLong) -> IO.Stdout.print "STRING_TOO_LONG"
          (_ : UnpairedUtf16Surrogate) -> IO.Stdout.print "UNPAIRED_UTF16_SURROGATE"
          (_ : ParseError) -> IO.Stdout.print "PARSE_ERROR"
        Right s -> IO.Stdout.print s
