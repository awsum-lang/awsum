{- Property: `(a ++ b) ++ c == a ++ (b ++ c)` for every triple of
   Strings (over an alphabet that excludes ':'). Input: "a:b:c".
   The property emits both groupings separated by ':' so each half
   can be checked against an independently computed
   concatenation. -}

import IO.Stdout
import IO.Stdin

parseInput : String -> Either ParseError (Tuple3 String String String)
parseInput raw = case splitOnFirst ":" raw of
  Nothing -> Left ParseError
  Just (Tuple2 a rest) -> case splitOnFirst ":" rest of
    Nothing -> Left ParseError
    Just (Tuple2 b c) -> Right (Tuple3 a b c)

property : String -> String -> String -> Either StringTooLong String
property a b c = do
  ab <- a ++ b
  abc <- ab ++ c
  bc <- b ++ c
  aBc <- a ++ bc
  delim <- abc ++ ":"
  delim ++ aBc

main : IO Never Unit
main = IO.Stdin.readAllString
  |> andThenIO (\raw -> eitherToIO (parseInput raw))
  |> andThenIO (\(Tuple3 a b c) -> eitherToIO (property a b c))
  |> andThenIO IO.Stdout.print
  |> handleErrorIO onError

onError : (StringTooLong | InvalidUtf8 | ParseError) -> IO Never Unit
onError e = case e of
  StringTooLong -> IO.Stdout.print "STRING_TOO_LONG"
  InvalidUtf8 -> IO.Stdout.print "INVALID_UTF8"
  ParseError -> IO.Stdout.print "PARSE_ERROR"
