{- Property: when (a, b) is a no-overflow pair, `addInt32 a b ==
   Right (a + b)` with the result matching what Haskell's i32
   addition produces. Stronger than commutativity: closes the
   "all backends agree but every backend agrees on the wrong
   value" gap. The property prints the computed sum as a decimal
   string; Haskell expects `show (a + b)`. -}

import IO.Stdout
import IO.Stdin

parseInput : String -> Either ParseError (Tuple2 Int32 Int32)
parseInput raw = case splitOnFirst ":" raw of
  Nothing -> Left ParseError
  Just (Tuple2 aStr bStr) -> do
    a <- parseInt32 aStr
    b <- parseInt32 bStr
    pureEither (Tuple2 a b)

property : Int32 -> Int32 -> Either (UnderflowError | OverflowError) String
property a b = do
  r <- addInt32 a b
  pureEither (showInt32 r)

runMain : Either (StringTooLong | InvalidUtf8) String -> IO Never Unit
runMain rawArg =
  let res : Either (StringTooLong | InvalidUtf8 | ParseError | UnderflowError | OverflowError) String = (do
        raw <- rawArg
        Tuple2 a b <- parseInput raw
        property a b
      )
   in case res of
        Left e -> case e of
          StringTooLong -> IO.Stdout.print "STRING_TOO_LONG"
          InvalidUtf8 -> IO.Stdout.print "INVALID_UTF8"
          ParseError -> IO.Stdout.print "PARSE_ERROR"
          UnderflowError -> IO.Stdout.print "UNDERFLOW"
          OverflowError -> IO.Stdout.print "OVERFLOW"
        Right s -> IO.Stdout.print s

main : IO Never Unit
main = IO.Stdin.readAllString
  |> andThenIO (\s -> runMain (Right s))
  |> handleErrorIO (\e -> runMain (Left e))
