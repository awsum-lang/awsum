-- Property: `addUInt32 a b == addUInt32 b a` whenever the sum stays in
-- range. Input format: "a:b". The Haskell-side generator picks pairs
-- constructively from the no-overflow region, so OVERFLOW is never
-- expected to fire on a well-formed input.
import IO.Stdout

parseInput : String -> Either ParseError (Tuple2 UInt32 UInt32)
parseInput raw = case splitOnFirst ":" raw of
  Nothing -> Left ParseError
  Just (Tuple2 aStr bStr) -> do
    a <- parseUInt32 aStr
    b <- parseUInt32 bStr
    pureEither (Tuple2 a b)

property : UInt32 -> UInt32 -> Either OverflowError Bool
property a b = do
  ab <- addUInt32 a b
  ba <- addUInt32 b a
  pureEither (eqUInt32 ab ba)

main : Either (StringTooLong | UnpairedUtf16Surrogate) String -> IO Never Unit
main rawArg =
  let res : Either (StringTooLong | UnpairedUtf16Surrogate | ParseError | OverflowError) Bool = (do
        raw <- rawArg
        Tuple2 a b <- parseInput raw
        property a b
      )
   in case res of
        Left e -> case e of
          StringTooLong -> IO.Stdout.print "STRING_TOO_LONG"
          UnpairedUtf16Surrogate -> IO.Stdout.print "UNPAIRED_UTF16_SURROGATE"
          ParseError -> IO.Stdout.print "PARSE_ERROR"
          OverflowError -> IO.Stdout.print "OVERFLOW"
        Right True -> IO.Stdout.print "OK"
        Right False -> IO.Stdout.print "FAIL"
