-- Property: `predInt32 x` fails iff `x == minInt32`. Symmetric to
-- `succInt32-fails-iff-max`. Property uses the result of `predInt32`
-- as data (success-vs-failure), so it doesn't desugar through `do`
-- — the inner `case` inspects the `Either` directly.
import IO.Stdout
import IO.Stdin

property : Int32 -> Bool
property x = case predInt32 x of
  Left _ -> eqInt32 x minInt32
  Right _ -> not (eqInt32 x minInt32)

runMain : Either (StringTooLong | UnpairedUtf16Surrogate) String -> IO Never Unit
runMain rawArg =
  let res : Either (StringTooLong | UnpairedUtf16Surrogate | ParseError) Bool = (do
        raw <- rawArg
        x <- parseInt32 raw
        pureEither (property x)
      )
   in case res of
        Left e -> case e of
          StringTooLong -> IO.Stdout.print "STRING_TOO_LONG"
          UnpairedUtf16Surrogate -> IO.Stdout.print "UNPAIRED_UTF16_SURROGATE"
          ParseError -> IO.Stdout.print "PARSE_ERROR"
        Right True -> IO.Stdout.print "OK"
        Right False -> IO.Stdout.print "FAIL"

main : IO Never Unit
main = IO.Stdin.readAll
  |> andThenIO (\s -> runMain (Right s))
  |> handleErrorIO (\e -> runMain (Left e))
