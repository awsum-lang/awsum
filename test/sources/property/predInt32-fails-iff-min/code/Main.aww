{- Property: `predInt32 x` fails iff `x == minInt32`. Symmetric to
   `succInt32-fails-iff-max`. Single Int32 input; the only error path
   is a parse failure. -}

import IO.Stdout
import IO.Stdin

property : Int32 -> Bool
property x = case predInt32 x of
  Left _ -> eqInt32 x minInt32
  Right _ -> not (eqInt32 x minInt32)

showOutcome : Bool -> String
showOutcome holds = case holds of
  True -> "OK"
  False -> "FAIL"

main : IO Never Unit
main = IO.Stdin.readAllString
  |> andThenIO (\raw -> eitherToIO (parseInt32 raw))
  |> andThenIO (\x -> IO.Stdout.print (showOutcome (property x)))
  |> handleErrorIO onError

onError : (StringTooLong | InvalidUtf8 | ParseError) -> IO Never Unit
onError e = case e of
  StringTooLong -> IO.Stdout.print "STRING_TOO_LONG"
  InvalidUtf8 -> IO.Stdout.print "INVALID_UTF8"
  ParseError -> IO.Stdout.print "PARSE_ERROR"
