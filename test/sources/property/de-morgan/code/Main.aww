-- Property: `not (and a b) == or (not a) (not b)`. The property
-- emits `boolToStr (not (and a b)) ++ boolToStr (or (not a) (not b))`
-- — both halves should equal Haskell's `not (a && b)`. Input
-- format: "a:b" with a, b as "0" / "1" decimal strings.
import IO.Stdout
import IO.Args

intToBool : UInt8 -> Bool
intToBool n = case eqUInt8 n 0 of
  True -> False
  False -> True

boolToStr : Bool -> String
boolToStr b = case b of
  True -> "T"
  False -> "F"

parseInput : String -> Either ParseError (Tuple2 UInt8 UInt8)
parseInput raw = case splitOnFirst ":" raw of
  Nothing -> Left ParseError
  Just (Tuple2 sa sb) -> do
    na <- parseUInt8 sa
    nb <- parseUInt8 sb
    pureEither (Tuple2 na nb)

property : UInt8 -> UInt8 -> Either StringTooLong String
property na nb =
  let a = intToBool na
      b = intToBool nb
   in boolToStr (not (and a b)) ++ boolToStr (or (not a) (not b))

runMain : Either (StringTooLong | UnpairedUtf16Surrogate) String -> IO Never Unit
runMain rawArg =
  let res : Either (StringTooLong | UnpairedUtf16Surrogate | ParseError) String = (do
        raw <- rawArg
        Tuple2 na nb <- parseInput raw
        property na nb
      )
   in case res of
        Left e -> case e of
          StringTooLong -> IO.Stdout.print "STRING_TOO_LONG"
          UnpairedUtf16Surrogate -> IO.Stdout.print "UNPAIRED_UTF16_SURROGATE"
          ParseError -> IO.Stdout.print "PARSE_ERROR"
        Right s -> IO.Stdout.print s

main : IO Never Unit
main =
  IO.Args.getArgs
    |> andThenIO (\s -> runMain (Right s))
    |> handleErrorIO (\e -> runMain (Left e))
