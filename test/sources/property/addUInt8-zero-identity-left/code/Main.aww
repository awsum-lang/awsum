{- Property: `addUInt8 0 a == Right a`. Left-identity of zero under
   addition. Single UInt8 input. Adding 0 is always in range, so
   OVERFLOW cannot fire on a well-formed input. -}

import IO.Stdout
import IO.Stdin

property : UInt8 -> Either OverflowError Bool
property a = do
  r <- addUInt8 0 a
  pureEither (eqUInt8 r a)

runMain : Either (StringTooLong | InvalidUtf8) String -> IO Never Unit
runMain rawArg =
  let res : Either (StringTooLong | InvalidUtf8 | ParseError | OverflowError) Bool = (do
        raw <- rawArg
        a <- parseUInt8 raw
        property a
      )
   in case res of
        Left e -> case e of
          StringTooLong -> IO.Stdout.print "STRING_TOO_LONG"
          InvalidUtf8 -> IO.Stdout.print "INVALID_UTF8"
          ParseError -> IO.Stdout.print "PARSE_ERROR"
          OverflowError -> IO.Stdout.print "OVERFLOW"
        Right True -> IO.Stdout.print "OK"
        Right False -> IO.Stdout.print "FAIL"

main : IO Never Unit
main = IO.Stdin.readAllString
  |> andThenIO (\s -> runMain (Right s))
  |> handleErrorIO (\e -> runMain (Left e))
