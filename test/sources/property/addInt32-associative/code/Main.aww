{- Property: `addInt32 (addInt32 a b) c == addInt32 a (addInt32 b c)`
   whenever every intermediate sum stays in range. Input format:
   "a:b:c" with Int32 decimal literals. The Haskell-side generator
   picks triples constructively from the no-overflow region, so
   neither UNDERFLOW nor OVERFLOW is expected to fire. -}

import IO.Stdout
import IO.Stdin

parseInput : String -> Either ParseError (Tuple3 Int32 Int32 Int32)
parseInput raw = case splitOnFirst ":" raw of
  Nothing -> Left ParseError
  Just (Tuple2 aStr rest) -> case splitOnFirst ":" rest of
    Nothing -> Left ParseError
    Just (Tuple2 bStr cStr) -> do
      a <- parseInt32 aStr
      b <- parseInt32 bStr
      c <- parseInt32 cStr
      pureEither (Tuple3 a b c)

property : Int32 -> Int32 -> Int32 -> Either (UnderflowError | OverflowError) Bool
property a b c = do
  ab <- addInt32 a b
  abc <- addInt32 ab c
  bc <- addInt32 b c
  aBc <- addInt32 a bc
  pureEither (eqInt32 abc aBc)

runMain : Either (StringTooLong | UnpairedUtf16Surrogate) String -> IO Never Unit
runMain rawArg =
  let res : Either (StringTooLong | UnpairedUtf16Surrogate | ParseError | UnderflowError | OverflowError) Bool = (do
        raw <- rawArg
        Tuple3 a b c <- parseInput raw
        property a b c
      )
   in case res of
        Left e -> case e of
          StringTooLong -> IO.Stdout.print "STRING_TOO_LONG"
          UnpairedUtf16Surrogate -> IO.Stdout.print "UNPAIRED_UTF16_SURROGATE"
          ParseError -> IO.Stdout.print "PARSE_ERROR"
          UnderflowError -> IO.Stdout.print "UNDERFLOW"
          OverflowError -> IO.Stdout.print "OVERFLOW"
        Right True -> IO.Stdout.print "OK"
        Right False -> IO.Stdout.print "FAIL"

main : IO Never Unit
main = IO.Stdin.readAll
  |> andThenIO (\s -> runMain (Right s))
  |> handleErrorIO (\e -> runMain (Left e))
