-- Property: `addInt32 (addInt32 a b) c == addInt32 a (addInt32 b c)`
-- whenever every intermediate sum stays in range. Input format:
-- "a:b:c" where a, b, c are decimal Int32 literals. The Haskell-side
-- generator picks triples constructively from the no-overflow region
-- (see `NoOverflowAddInt32Triple` in PropertySpec.hs), so the
-- OVERFLOW branch is never expected to fire.
import IO.Stdout

parseTriple : String -> Either ParseError (Tuple3 Int32 Int32 Int32)
parseTriple raw = case splitOnFirst ":" raw of
  Nothing -> Left ParseError
  Just t1 -> case t1 of
    Tuple2 aStr rest -> case splitOnFirst ":" rest of
      Nothing -> Left ParseError
      Just t2 -> case t2 of
        Tuple2 bStr cStr -> case parseInt32 aStr of
          Left e -> Left e
          Right a -> case parseInt32 bStr of
            Left e -> Left e
            Right b -> case parseInt32 cStr of
              Left e -> Left e
              Right c -> Right (Tuple3 a b c)

main : String -> IOUnit
main raw = case parseTriple raw of
  Left _ -> IO.Stdout.print "PARSE_ERROR"
  Right t -> case t of
    Tuple3 a b c -> case addInt32 a b of
      Left _ -> IO.Stdout.print "OVERFLOW"
      Right ab -> case addInt32 ab c of
        Left _ -> IO.Stdout.print "OVERFLOW"
        Right abc -> case addInt32 b c of
          Left _ -> IO.Stdout.print "OVERFLOW"
          Right bc -> case addInt32 a bc of
            Left _ -> IO.Stdout.print "OVERFLOW"
            Right aBc -> case eqInt32 abc aBc of
              True -> IO.Stdout.print "OK"
              False -> IO.Stdout.print ("FAIL: " ++ showInt32 abc ++ " /= " ++ showInt32 aBc)
