{- Property: `eqString s s == True` for every UTF-16 string. The two
   arguments are independently constructed values of the same content
   (passing the same name twice, which after defunctionalisation flows
   into '__eqString' as two heap pointers — equal-content but not
   guaranteed pointer-equal across backends). Single-string input, no
   separator. -}

import IO.Stdout
import IO.Stdin

property : String -> Bool
property s = eqString s s

printOutcome : Bool -> IO Never Unit
printOutcome holds = case holds of
  True -> IO.Stdout.print "OK"
  False -> IO.Stdout.print "FAIL"

main : IO Never Unit
main = IO.Stdin.readAllString
  |> andThenIO (\raw -> printOutcome (property raw))
  |> handleErrorIO onError

onError : (StringTooLong | InvalidUtf8) -> IO Never Unit
onError e = case e of
  StringTooLong -> IO.Stdout.print "STRING_TOO_LONG"
  InvalidUtf8 -> IO.Stdout.print "INVALID_UTF8"
