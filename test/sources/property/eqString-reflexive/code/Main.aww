{- Property: `eqString s s == True` for every UTF-16 string. The two
   arguments are independently constructed values of the same content
   (each `IO.Stdin.readAllString` call would return a fresh cell; here we
   pass the same name twice, which after defunctionalisation flows
   into '__eqString' as two heap pointers — equal-content but not
   guaranteed pointer-equal across backends). Single-string input, no
   separator. -}

import IO.Stdout
import IO.Stdin

property : String -> Bool
property s = eqString s s

runMain : Either (StringTooLong | InvalidUtf8) String -> IO Never Unit
runMain rawArg =
  let res : Either (StringTooLong | InvalidUtf8) Bool = (do
        s <- rawArg
        pureEither (property s)
      )
   in case res of
        Left e -> case e of
          StringTooLong -> IO.Stdout.print "STRING_TOO_LONG"
          InvalidUtf8 -> IO.Stdout.print "INVALID_UTF8"
        Right True -> IO.Stdout.print "OK"
        Right False -> IO.Stdout.print "FAIL"

main : IO Never Unit
main = IO.Stdin.readAllString
  |> andThenIO (\s -> runMain (Right s))
  |> handleErrorIO (\e -> runMain (Left e))
