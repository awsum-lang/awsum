{- Property: `eqInt32 a a == True` for every Int32. Single Int32 input; the
   only error path is a parse failure. -}

import IO.Stdout
import IO.Stdin

property : Int32 -> Bool
property a = eqInt32 a a

printOutcome : Bool -> IO Never Unit
printOutcome holds = case holds of
  True -> IO.Stdout.print "OK"
  False -> IO.Stdout.print "FAIL"

main : IO Never Unit
main = IO.Stdin.readAllString
  |> andThenIO (\raw -> eitherToIO (parseInt32 raw))
  |> andThenIO (\a -> printOutcome (property a))
  |> handleErrorIO onError

onError : (StringTooLong | InvalidUtf8 | ParseError) -> IO Never Unit
onError e = case e of
  StringTooLong -> IO.Stdout.print "STRING_TOO_LONG"
  InvalidUtf8 -> IO.Stdout.print "INVALID_UTF8"
  ParseError -> IO.Stdout.print "PARSE_ERROR"
