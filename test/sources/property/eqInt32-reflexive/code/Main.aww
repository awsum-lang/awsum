-- Property: `eqInt32 a a == True` for every Int32. Single Int32
-- input. The property has no failable inner ops, so the only
-- error path is a parse failure.
import IO.Stdout

property : Int32 -> Bool
property a = eqInt32 a a

main : String -> IO Unit
main raw =
  let res : Either ParseError Bool = do
        a <- parseInt32 raw
        pureEither (property a)
   in case res of
        Left _ -> IO.Stdout.print "PARSE_ERROR"
        Right True -> IO.Stdout.print "OK"
        Right False -> IO.Stdout.print "FAIL"
