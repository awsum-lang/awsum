-- Property: `eqUInt32 a b == eqUInt32 b a` for any (a, b). Both sides
-- must agree, even when `a /= b`. Input format: "a:b". The property
-- has no failable inner ops, so the only error path is a parse
-- failure.
import IO.Stdout
import IO.Args

parseInput : String -> Either ParseError (Tuple2 UInt32 UInt32)
parseInput raw = case splitOnFirst ":" raw of
  Nothing -> Left ParseError
  Just (Tuple2 aStr bStr) -> do
    a <- parseUInt32 aStr
    b <- parseUInt32 bStr
    pureEither (Tuple2 a b)

property : UInt32 -> UInt32 -> Bool
property a b = case eqUInt32 a b of
  True -> eqUInt32 b a
  False -> case eqUInt32 b a of
    True -> False
    False -> True

runMain : Either (StringTooLong | UnpairedUtf16Surrogate) String -> IO Never Unit
runMain rawArg =
  let res : Either (StringTooLong | UnpairedUtf16Surrogate | ParseError) Bool = (do
        raw <- rawArg
        Tuple2 a b <- parseInput raw
        pureEither (property a b)
      )
   in case res of
        Left e -> case e of
          StringTooLong -> IO.Stdout.print "STRING_TOO_LONG"
          UnpairedUtf16Surrogate -> IO.Stdout.print "UNPAIRED_UTF16_SURROGATE"
          ParseError -> IO.Stdout.print "PARSE_ERROR"
        Right True -> IO.Stdout.print "OK"
        Right False -> IO.Stdout.print "FAIL"

main : IO Never Unit
main =
  IO.Args.getArgs
    |> andThenIO (\s -> runMain (Right s))
    |> handleErrorIO (\e -> runMain (Left e))
