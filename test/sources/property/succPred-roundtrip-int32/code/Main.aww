{- Property: `succInt32 (predInt32 x) == Right x` for every Int32 with
   `x /= minInt32`. Mirror of `predSucc-roundtrip-int32` in the
   opposite direction. Inputs exclude minInt32, so neither pred nor
   succ fails on a well-formed input. -}

import IO.Stdout
import IO.Stdin

property : Int32 -> Either (UnderflowError | OverflowError) Bool
property x = do
  p <- predInt32 x
  s <- succInt32 p
  pureEither (eqInt32 s x)

showOutcome : Bool -> String
showOutcome holds = case holds of
  True -> "OK"
  False -> "FAIL"

main : IO Never Unit
main = IO.Stdin.readAllString
  |> andThenIO (\raw -> eitherToIO (parseInt32 raw))
  |> andThenIO (\x -> eitherToIO (property x))
  |> andThenIO (\holds -> IO.Stdout.print (showOutcome holds))
  |> handleErrorIO onError

onError : (StringTooLong | InvalidUtf8 | ParseError | UnderflowError | OverflowError) -> IO Never Unit
onError e = case e of
  StringTooLong -> IO.Stdout.print "STRING_TOO_LONG"
  InvalidUtf8 -> IO.Stdout.print "INVALID_UTF8"
  ParseError -> IO.Stdout.print "PARSE_ERROR"
  UnderflowError -> IO.Stdout.print "UNDERFLOW"
  OverflowError -> IO.Stdout.print "OVERFLOW"
