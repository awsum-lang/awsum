{- Property: `mulUInt8 (mulUInt8 a b) c == mulUInt8 a (mulUInt8 b c)`
   whenever every intermediate product stays in range. Input format:
   "a:b:c" where a, b, c are decimal UInt8 literals. Inputs stay in
   the no-overflow region, so the OVERFLOW branch never fires. -}

import IO.Stdout
import IO.Stdin

property : UInt8 -> UInt8 -> UInt8 -> Either OverflowError Bool
property a b c = do
  ab <- mulUInt8 a b
  abc <- mulUInt8 ab c
  bc <- mulUInt8 b c
  aBc <- mulUInt8 a bc
  pureEither (eqUInt8 abc aBc)

printOutcome : Bool -> IO Never Unit
printOutcome holds = case holds of
  True -> IO.Stdout.print "OK"
  False -> IO.Stdout.print "FAIL"

main : IO Never Unit
main = IO.Stdin.readAllString
  |> andThenIO (\raw -> eitherToIO (parseInput raw))
  |> andThenIO (\(Tuple3 a b c) -> eitherToIO (property a b c))
  |> andThenIO printOutcome
  |> handleErrorIO onError

parseInput : String -> Either ParseError (Tuple3 UInt8 UInt8 UInt8)
parseInput raw = case splitOnFirst ":" raw of
  Nothing -> Left ParseError
  Just (Tuple2 aStr rest) -> case splitOnFirst ":" rest of
    Nothing -> Left ParseError
    Just (Tuple2 bStr cStr) -> do
      a <- parseUInt8 aStr
      b <- parseUInt8 bStr
      c <- parseUInt8 cStr
      pureEither (Tuple3 a b c)

onError : (StringTooLong | InvalidUtf8 | ParseError | OverflowError) -> IO Never Unit
onError e = case e of
  StringTooLong -> IO.Stdout.print "STRING_TOO_LONG"
  InvalidUtf8 -> IO.Stdout.print "INVALID_UTF8"
  ParseError -> IO.Stdout.print "PARSE_ERROR"
  OverflowError -> IO.Stdout.print "OVERFLOW"
