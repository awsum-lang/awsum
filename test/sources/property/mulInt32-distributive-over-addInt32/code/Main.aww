-- Property: `mulInt32 a (addInt32 b c) == addInt32 (mulInt32 a b) (mulInt32 a c)`
-- whenever every intermediate value (b+c, a*b, a*c, a*(b+c)) stays in
-- Int32 range. Input format: "a:b:c" — Int32 decimal literals. The
-- Haskell-side generator (NoOverflowMulDistribInt32 in PropertySpec.hs)
-- picks triples constructively from the joint no-overflow region, so
-- the OVERFLOW branch is never expected to fire.
import IO.Stdout

parseTriple : String -> Either ParseError (Tuple3 Int32 Int32 Int32)
parseTriple raw = case splitOnFirst ":" raw of
  Nothing -> Left ParseError
  Just t1 -> case t1 of
    Tuple2 aStr rest -> case splitOnFirst ":" rest of
      Nothing -> Left ParseError
      Just t2 -> case t2 of
        Tuple2 bStr cStr -> case parseInt32 aStr of
          Left e -> Left e
          Right a -> case parseInt32 bStr of
            Left e -> Left e
            Right b -> case parseInt32 cStr of
              Left e -> Left e
              Right c -> Right (Tuple3 a b c)

main : String -> IOUnit
main raw = case parseTriple raw of
  Left _ -> IO.Stdout.print "PARSE_ERROR"
  Right t -> case t of
    Tuple3 a b c -> case addInt32 b c of
      Left _ -> IO.Stdout.print "OVERFLOW"
      Right bc -> case mulInt32 a bc of
        Left _ -> IO.Stdout.print "OVERFLOW"
        Right lhs -> case mulInt32 a b of
          Left _ -> IO.Stdout.print "OVERFLOW"
          Right ab -> case mulInt32 a c of
            Left _ -> IO.Stdout.print "OVERFLOW"
            Right ac -> case addInt32 ab ac of
              Left _ -> IO.Stdout.print "OVERFLOW"
              Right rhs -> case eqInt32 lhs rhs of
                True -> IO.Stdout.print "OK"
                False -> IO.Stdout.print ("FAIL: " ++ showInt32 lhs ++ " /= " ++ showInt32 rhs)
