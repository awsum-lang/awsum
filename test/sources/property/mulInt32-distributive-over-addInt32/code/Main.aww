{- Property: `mulInt32 a (addInt32 b c) == addInt32 (mulInt32 a b) (mulInt32 a c)`
   whenever every intermediate value (b+c, a*b, a*c, a*(b+c)) stays
   in Int32 range. Input format: "a:b:c". Inputs stay in the joint
   no-overflow region, so neither UNDERFLOW nor OVERFLOW fires. -}

import IO.Stdout
import IO.Stdin

property : Int32 -> Int32 -> Int32 -> Either (UnderflowError | OverflowError) Bool
property a b c = do
  bc <- addInt32 b c
  lhs <- mulInt32 a bc
  ab <- mulInt32 a b
  ac <- mulInt32 a c
  rhs <- addInt32 ab ac
  pureEither (eqInt32 lhs rhs)

printOutcome : Bool -> IO Never Unit
printOutcome holds = case holds of
  True -> IO.Stdout.print "OK"
  False -> IO.Stdout.print "FAIL"

main : IO Never Unit
main = IO.Stdin.readAllString
  |> andThenIO (\raw -> eitherToIO (parseInput raw))
  |> andThenIO (\(Tuple3 a b c) -> eitherToIO (property a b c))
  |> andThenIO printOutcome
  |> handleErrorIO onError

parseInput : String -> Either ParseError (Tuple3 Int32 Int32 Int32)
parseInput raw = case splitOnFirst ":" raw of
  Nothing -> Left ParseError
  Just (Tuple2 aStr rest) -> case splitOnFirst ":" rest of
    Nothing -> Left ParseError
    Just (Tuple2 bStr cStr) -> do
      a <- parseInt32 aStr
      b <- parseInt32 bStr
      c <- parseInt32 cStr
      pureEither (Tuple3 a b c)

onError : (StringTooLong | InvalidUtf8 | ParseError | UnderflowError | OverflowError) -> IO Never Unit
onError e = case e of
  StringTooLong -> IO.Stdout.print "STRING_TOO_LONG"
  InvalidUtf8 -> IO.Stdout.print "INVALID_UTF8"
  ParseError -> IO.Stdout.print "PARSE_ERROR"
  UnderflowError -> IO.Stdout.print "UNDERFLOW"
  OverflowError -> IO.Stdout.print "OVERFLOW"
