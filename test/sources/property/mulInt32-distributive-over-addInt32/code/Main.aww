-- Property: `mulInt32 a (addInt32 b c) == addInt32 (mulInt32 a b) (mulInt32 a c)`
-- whenever every intermediate value (b+c, a*b, a*c, a*(b+c)) stays
-- in Int32 range. Input format: "a:b:c". The Haskell-side generator
-- (`NoOverflowMulDistribInt32` in PropertySpec.hs) picks triples
-- constructively from the joint no-overflow region, so neither
-- UNDERFLOW nor OVERFLOW is expected to fire.
import IO.Stdout

parseInput : String -> Either ParseError (Tuple3 Int32 Int32 Int32)
parseInput raw = case splitOnFirst ":" raw of
  Nothing -> Left ParseError
  Just (Tuple2 aStr rest) -> case splitOnFirst ":" rest of
    Nothing -> Left ParseError
    Just (Tuple2 bStr cStr) -> do
      a <- parseInt32 aStr
      b <- parseInt32 bStr
      c <- parseInt32 cStr
      pureEither (Tuple3 a b c)

property : Int32 -> Int32 -> Int32 -> Either (UnderflowError | OverflowError) Bool
property a b c = do
  bc <- addInt32 b c
  lhs <- mulInt32 a bc
  ab <- mulInt32 a b
  ac <- mulInt32 a c
  rhs <- addInt32 ab ac
  pureEither (eqInt32 lhs rhs)

main : Either (StringTooLong | UnpairedUtf16Surrogate) String -> IO Never Unit
main rawArg =
  let res : Either (StringTooLong | UnpairedUtf16Surrogate | ParseError | UnderflowError | OverflowError) Bool = (do
        raw <- rawArg
        Tuple3 a b c <- parseInput raw
        property a b c
      )
   in case res of
        Left e -> case e of
          StringTooLong -> IO.Stdout.print "STRING_TOO_LONG"
          UnpairedUtf16Surrogate -> IO.Stdout.print "UNPAIRED_UTF16_SURROGATE"
          ParseError -> IO.Stdout.print "PARSE_ERROR"
          UnderflowError -> IO.Stdout.print "UNDERFLOW"
          OverflowError -> IO.Stdout.print "OVERFLOW"
        Right True -> IO.Stdout.print "OK"
        Right False -> IO.Stdout.print "FAIL"
