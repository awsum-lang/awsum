{- Property: `mulUInt32 a 1 == Right a`. Right-identity of one under
   multiplication. Single UInt32 input. Multiplying by 1 is always in
   range, so OVERFLOW cannot fire on a well-formed input. -}

import IO.Stdout
import IO.Stdin

property : UInt32 -> Either OverflowError Bool
property a = do
  r <- mulUInt32 a 1
  pureEither (eqUInt32 r a)

runMain : Either (StringTooLong | InvalidUtf8) String -> IO Never Unit
runMain rawArg =
  let res : Either (StringTooLong | InvalidUtf8 | ParseError | OverflowError) Bool = (do
        raw <- rawArg
        a <- parseUInt32 raw
        property a
      )
   in case res of
        Left e -> case e of
          StringTooLong -> IO.Stdout.print "STRING_TOO_LONG"
          InvalidUtf8 -> IO.Stdout.print "INVALID_UTF8"
          ParseError -> IO.Stdout.print "PARSE_ERROR"
          OverflowError -> IO.Stdout.print "OVERFLOW"
        Right True -> IO.Stdout.print "OK"
        Right False -> IO.Stdout.print "FAIL"

main : IO Never Unit
main = IO.Stdin.readAllString
  |> andThenIO (\s -> runMain (Right s))
  |> handleErrorIO (\e -> runMain (Left e))
