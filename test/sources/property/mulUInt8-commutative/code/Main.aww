{- Property: `mulUInt8 a b == mulUInt8 b a` whenever the product stays
   in range. Input format: "a:b". The Haskell-side generator picks
   pairs constructively from the no-overflow region, so OVERFLOW is
   never expected to fire on a well-formed input. -}

import IO.Stdout
import IO.Stdin

parseInput : String -> Either ParseError (Tuple2 UInt8 UInt8)
parseInput raw = case splitOnFirst ":" raw of
  Nothing -> Left ParseError
  Just (Tuple2 aStr bStr) -> do
    a <- parseUInt8 aStr
    b <- parseUInt8 bStr
    pureEither (Tuple2 a b)

property : UInt8 -> UInt8 -> Either OverflowError Bool
property a b = do
  ab <- mulUInt8 a b
  ba <- mulUInt8 b a
  pureEither (eqUInt8 ab ba)

runMain : Either (StringTooLong | InvalidUtf8) String -> IO Never Unit
runMain rawArg =
  let res : Either (StringTooLong | InvalidUtf8 | ParseError | OverflowError) Bool = (do
        raw <- rawArg
        Tuple2 a b <- parseInput raw
        property a b
      )
   in case res of
        Left e -> case e of
          StringTooLong -> IO.Stdout.print "STRING_TOO_LONG"
          InvalidUtf8 -> IO.Stdout.print "INVALID_UTF8"
          ParseError -> IO.Stdout.print "PARSE_ERROR"
          OverflowError -> IO.Stdout.print "OVERFLOW"
        Right True -> IO.Stdout.print "OK"
        Right False -> IO.Stdout.print "FAIL"

main : IO Never Unit
main = IO.Stdin.readAllString
  |> andThenIO (\s -> runMain (Right s))
  |> handleErrorIO (\e -> runMain (Left e))
