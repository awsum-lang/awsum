{- Property: `mulUInt8 a b == mulUInt8 b a` whenever the product stays
   in range. Input format: "a:b". Inputs stay in the no-overflow
   region, so OVERFLOW never fires on a well-formed input. -}

import IO.Stdout
import IO.Stdin

property : UInt8 -> UInt8 -> Either OverflowError Bool
property a b = do
  ab <- mulUInt8 a b
  ba <- mulUInt8 b a
  pureEither (eqUInt8 ab ba)

printOutcome : Bool -> IO Never Unit
printOutcome holds = case holds of
  True -> IO.Stdout.print "OK"
  False -> IO.Stdout.print "FAIL"

main : IO Never Unit
main = IO.Stdin.readAllString
  |> andThenIO (\raw -> eitherToIO (parseInput raw))
  |> andThenIO (\(Tuple2 a b) -> eitherToIO (property a b))
  |> andThenIO printOutcome
  |> handleErrorIO onError

parseInput : String -> Either ParseError (Tuple2 UInt8 UInt8)
parseInput raw = case splitOnFirst ":" raw of
  Nothing -> Left ParseError
  Just (Tuple2 aStr bStr) -> do
    a <- parseUInt8 aStr
    b <- parseUInt8 bStr
    pureEither (Tuple2 a b)

onError : (StringTooLong | InvalidUtf8 | ParseError | OverflowError) -> IO Never Unit
onError e = case e of
  StringTooLong -> IO.Stdout.print "STRING_TOO_LONG"
  InvalidUtf8 -> IO.Stdout.print "INVALID_UTF8"
  ParseError -> IO.Stdout.print "PARSE_ERROR"
  OverflowError -> IO.Stdout.print "OVERFLOW"
