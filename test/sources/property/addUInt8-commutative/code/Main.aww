-- Property: `addUInt8 a b == addUInt8 b a` whenever the sum stays in
-- range. Input format: "a:b". The Haskell-side generator picks pairs
-- constructively from the no-overflow region, so OVERFLOW is never
-- expected to fire on a well-formed input.
import IO.Stdout

parseInput : String -> Either ParseError (Tuple2 UInt8 UInt8)
parseInput raw = case splitOnFirst ":" raw of
  Nothing -> Left ParseError
  Just (Tuple2 aStr bStr) -> do
    a <- parseUInt8 aStr
    b <- parseUInt8 bStr
    pureEither (Tuple2 a b)

property : UInt8 -> UInt8 -> Either OverflowError Bool
property a b = do
  ab <- addUInt8 a b
  ba <- addUInt8 b a
  pureEither (eqUInt8 ab ba)

main : String -> IO Unit
main raw =
  let res : Either (ParseError | OverflowError) Bool = do
        Tuple2 a b <- parseInput raw
        property a b
   in case res of
        Left e -> case e of
          (_ : ParseError) -> IO.Stdout.print "PARSE_ERROR"
          (_ : OverflowError) -> IO.Stdout.print "OVERFLOW"
        Right True -> IO.Stdout.print "OK"
        Right False -> IO.Stdout.print "FAIL"
