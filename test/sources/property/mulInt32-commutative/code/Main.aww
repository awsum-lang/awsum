-- Property: `mulInt32 a b == mulInt32 b a` whenever the product stays
-- in range. Input format: "a:b" with Int32 decimal literals. The
-- Haskell-side generator picks pairs constructively from the
-- no-overflow region, so neither UNDERFLOW nor OVERFLOW is expected
-- to fire.
import IO.Stdout

parseInput : String -> Either ParseError (Tuple2 Int32 Int32)
parseInput raw = case splitOnFirst ":" raw of
  Nothing -> Left ParseError
  Just (Tuple2 aStr bStr) -> do
    a <- parseInt32 aStr
    b <- parseInt32 bStr
    pureEither (Tuple2 a b)

property : Int32 -> Int32 -> Either (UnderflowError | OverflowError) Bool
property a b = do
  ab <- mulInt32 a b
  ba <- mulInt32 b a
  pureEither (eqInt32 ab ba)

main : Either (StringTooLong | UnpairedUtf16Surrogate) String -> IO Never Unit
main rawArg =
  let res : Either (StringTooLong | UnpairedUtf16Surrogate | ParseError | UnderflowError | OverflowError) Bool = (do
        raw <- rawArg
        Tuple2 a b <- parseInput raw
        property a b
      )
   in case res of
        Left e -> case e of
          (_ : StringTooLong) -> IO.Stdout.print "STRING_TOO_LONG"
          (_ : UnpairedUtf16Surrogate) -> IO.Stdout.print "UNPAIRED_UTF16_SURROGATE"
          (_ : ParseError) -> IO.Stdout.print "PARSE_ERROR"
          (_ : UnderflowError) -> IO.Stdout.print "UNDERFLOW"
          (_ : OverflowError) -> IO.Stdout.print "OVERFLOW"
        Right True -> IO.Stdout.print "OK"
        Right False -> IO.Stdout.print "FAIL"
