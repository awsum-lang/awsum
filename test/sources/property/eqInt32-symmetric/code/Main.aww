-- Property: `eqInt32 a b == eqInt32 b a` for any (a, b). Both sides
-- must agree, regardless of whether a == b or not. The four cases of
-- (eq a b, eq b a) are decomposed manually since Awsum has no eqBool
-- builtin yet — only the (true, true) and (false, false) corners are
-- success outcomes.
import IO.Stdout

parsePair : String -> Either ParseError (Tuple2 Int32 Int32)
parsePair raw = case splitOnFirst ":" raw of
  Nothing -> Left ParseError
  Just t -> case t of
    Tuple2 aStr bStr -> case parseInt32 aStr of
      Left e -> Left e
      Right a -> case parseInt32 bStr of
        Left e -> Left e
        Right b -> Right (Tuple2 a b)

main : String -> IO Unit
main raw = case parsePair raw of
  Left _ -> IO.Stdout.print "PARSE_ERROR"
  Right t -> case t of
    Tuple2 a b -> case eqInt32 a b of
      True -> case eqInt32 b a of
        True -> IO.Stdout.print "OK"
        False -> IO.Stdout.print "FAIL: ab=true, ba=false"
      False -> case eqInt32 b a of
        True -> IO.Stdout.print "FAIL: ab=false, ba=true"
        False -> IO.Stdout.print "OK"
