{- Property: `eqInt32 a b == eqInt32 b a` for any (a, b). Both sides
   must agree, even when `a /= b`. Input format: "a:b". The property
   has no failable inner ops, so the only error path is a parse
   failure. -}

import IO.Stdout
import IO.Stdin

property : Int32 -> Int32 -> Bool
property a b = case eqInt32 a b of
  True -> eqInt32 b a
  False -> case eqInt32 b a of
    True -> False
    False -> True

printOutcome : Bool -> IO Never Unit
printOutcome holds = case holds of
  True -> IO.Stdout.print "OK"
  False -> IO.Stdout.print "FAIL"

main : IO Never Unit
main = IO.Stdin.readAllString
  |> andThenIO (\raw -> eitherToIO (parseInput raw))
  |> andThenIO (\(Tuple2 a b) -> printOutcome (property a b))
  |> handleErrorIO onError

parseInput : String -> Either ParseError (Tuple2 Int32 Int32)
parseInput raw = case splitOnFirst ":" raw of
  Nothing -> Left ParseError
  Just (Tuple2 aStr bStr) -> do
    a <- parseInt32 aStr
    b <- parseInt32 bStr
    pureEither (Tuple2 a b)

onError : (StringTooLong | InvalidUtf8 | ParseError) -> IO Never Unit
onError e = case e of
  StringTooLong -> IO.Stdout.print "STRING_TOO_LONG"
  InvalidUtf8 -> IO.Stdout.print "INVALID_UTF8"
  ParseError -> IO.Stdout.print "PARSE_ERROR"
