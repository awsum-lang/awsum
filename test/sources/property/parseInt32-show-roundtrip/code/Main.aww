-- Property: `parseInt32 (showInt32 x) == Right x` for any Int32. Tests
-- that the show / parse pair round-trips. The property reads the
-- input, parses, and re-shows; Haskell expects the same input
-- back. If the generator picks a value Awsum can't parse or print
-- correctly, the discrepancy shows up immediately on the failing
-- backend.
import IO.Stdout

property : Int32 -> String
property v = showInt32 v

main : Either (StringTooLong | UnpairedUtf16Surrogate) String -> IO Unit
main rawArg =
  let res : Either (StringTooLong | UnpairedUtf16Surrogate | ParseError) String = do
        raw <- rawArg
        v <- parseInt32 raw
        pureEither (property v)
   in case res of
        Left e -> case e of
          (_ : StringTooLong) -> IO.Stdout.print "STRING_TOO_LONG"
          (_ : UnpairedUtf16Surrogate) -> IO.Stdout.print "UNPAIRED_UTF16_SURROGATE"
          (_ : ParseError) -> IO.Stdout.print "PARSE_ERROR"
        Right s -> IO.Stdout.print s
