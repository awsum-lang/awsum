-- Property: `parseInt32 (showInt32 x) == Right x` for any Int32. Tests
-- that the show / parse pair round-trips byte-for-byte. Awsum reads the
-- input, parses, re-shows; Haskell expects the same input back. If the
-- generator picks a value Awsum can't parse or print correctly, the
-- discrepancy shows up immediately on the failing backend.
import IO.Stdout

main : String -> IOUnit
main raw = case parseInt32 raw of
  Left _ -> IO.Stdout.print "PARSE_ERROR"
  Right v -> IO.Stdout.print (showInt32 v)
