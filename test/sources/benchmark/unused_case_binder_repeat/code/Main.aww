{- Walks a list counting elements, repeated. The case-binder '_h'
   is bound from each 'Cons' cell's slot 1 but never referenced —
   stresses 'Awsum.Lifetime.insertDrops' on the unused-binder path
   (its placement of 'CDrop' must keep the boxed Int32 reachable
   for the cascade-free of 'xs' and dec the binder itself after).

   Hot loop:

     case xs of
       Nil -> acc
       Cons _h t -> length t (succInt32 acc)

   Steady-state peak RSS at iters * listLen = 10^7:
     * LLVM       ~2 MiB
     * JVM        ~500 MiB (baseline JVM heap)
     * CLR        ~45 MiB
     * WASM       ~14 MiB
     * JS         ~115 MiB (V8 baseline)

   Output: cumulative element count, printed once via 'showInt32'.
   1000 outer * 10000 per pass = 10^7. -}

import IO.Stdout

zero : Int32
zero = 0

type IntList = Nil | Cons Int32 IntList

-- Tail-recursive build: each iter consumes 'n' and 'acc' (both

-- transferred into 'Cons n acc'), and the new 'm' becomes the

-- next 'n'. No build-side leak.

build : Int32 -> IntList -> IntList
build n acc = case eqInt32 n zero of
  True -> acc
  False -> case predInt32 n of
    Left _e -> acc
    Right m -> build m (Cons n acc)

-- Walks the list counting elements; '_h' is bound from each

-- 'Cons' cell's slot 1 but never referenced. Tail-recursive so

-- 'xs' and 'acc' are loop accumulators dropped by Phase B; '_h'

-- is a case-pattern binder, not a parameter, and leaks.

length : IntList -> Int32 -> Int32
length xs acc = case xs of
  Nil -> acc
  Cons _h t -> case succInt32 acc of
    Left _e -> acc
    Right a -> length t a

-- Outer loop: build a fresh list, walk it counting elements,

-- accumulate the count. 'iters * listLen' Cons cells walked,

-- equal number of boxed Int32 cells leaked on LLVM/WASM.

runN : Int32 -> Int32 -> Int32 -> Int32
runN iters listLen accSum = case eqInt32 iters zero of
  True -> accSum
  False -> case predInt32 iters of
    Left _e -> accSum
    Right i -> case addInt32 accSum (length (build listLen Nil) zero) of
      Left _e -> accSum
      Right s -> runN i listLen s

main : IO Never Unit
main = IO.Stdout.print (showInt32 (runN 1_000 10_000 zero))
