{- Cell-reuse benchmark — accumulator-based list reverse, repeated.

   The hot loop is the Lean-4 canonical cell-reuse pattern:

     revInto acc lst = case lst of
       Nil -> acc
       Cons h t -> revInto (Cons h acc) t

   At every recursive step the matched-out 'Cons h t' cell is
   linear (its only use is the case scrutinee), and the arm body
   constructs a 'Cons h acc' cell of the same arity in tail
   position. 'Awsum.Reuse' detects this shape and rewrites the
   inner 'CCon 20 [h, acc]' to 'CReuse "lst" 20 [h, acc]' — in-
   place stores on the existing cell rather than '__alloc' /
   '__free' on every iter. Visible via 'awsum core'.

   On LLVM/WASM the rewrite eliminates the freelist churn: one
   '__alloc' pop + one '__free' push per cell becomes one tail-
   field write. On JVM/CLR/JS the codegen still emits a fresh
   cell allocation — managed GCs promote it to stack via escape
   analysis once the hot loop is alloc-free.

   Sizing: 'repeat 100000 1' builds a 100 000-element list of 1s;
   'revN 1000' reverses it 1 000 times. Cumulative cell traffic
   = 1e5 × 1e3 = 1e8 reuse rewrites. 'sumList' walks the final
   reversed list to force the result through addInt32 (so the
   optimiser cannot elide the recursion). -}

import IO.Stdout

zero : Int32
zero = 0

type IntList = Nil | Cons Int32 IntList

repeat : Int32 -> Int32 -> IntList
repeat n value = case eqInt32 n zero of
  True -> Nil
  False -> case predInt32 n of
    Left _e -> Nil
    Right m -> Cons value (repeat m value)

revInto : IntList -> IntList -> IntList
revInto acc lst = case lst of
  Nil -> acc
  Cons h t -> revInto (Cons h acc) t

revN : Int32 -> IntList -> IntList
revN times lst = case eqInt32 times zero of
  True -> lst
  False -> case predInt32 times of
    Left _e -> lst
    Right m -> revN m (revInto Nil lst)

sumList : IntList -> Int32 -> Int32
sumList lst acc = case lst of
  Nil -> acc
  Cons x xs -> case addInt32 acc x of
    Left _e -> acc
    Right next -> sumList xs next

main : IO Never Unit
main =
  let original : IntList = repeat 100_000 1
      reversed : IntList = revN 1_000 original
   in IO.Stdout.print (showInt32 (sumList reversed zero))
