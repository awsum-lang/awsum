{- Multi-child non-tail recursion benchmark.

   'mirror' has two non-tail self-calls in one expression:

     mirror (Node l v r) = Node (mirror r) v (mirror l)

   Cps allocates one K_i per call (so each Node visited produces two K
   cells on the heap), and an earlier K_i's apply arm tail-calls
   '$cps$mirror' to start the next call — a '$cps$mirror' ⇄
   '$apply$mirror' mutual cycle that the second SCC-merge pass fuses
   into one self-recursive function before TCO. This benchmark
   exercises that path under heavy memory pressure.

   Shape: a left-spine tree of depth 10_000 is mirrored 1000 times.
   Mirror is its own inverse, so 1000 (even) mirrors return the
   original tree; output is the value at the deepest left position
   (always '1' here, since 'buildLeft' fills every Node with 1).

   Per iter: 10_000 fresh Node cells (the new mirror tree) + ~20_000
   K cells (two per Node visited). Steady-state live set with proper
   refcount reclaim: two trees (~10_000 Node cells each) + at most
   D K cells along the current call chain — a few hundred KiB. Without
   reclaim: 1000 × 30_000 ≈ 30M cells stay live, ~1 GiB.

   Output: '1', cumulative allocation 30M cells. -}
import IO.Stdout

zero : Int32
zero = 0

type Tree
  = Leaf
  | Node Tree Int32 Tree

buildLeft : Int32 -> Tree -> Either UnderflowError Tree
buildLeft n acc = case eqInt32 n zero of
  True -> Right acc
  False -> case predInt32 n of
    Left e -> Left e
    Right m -> buildLeft m (Node acc 1 Leaf)

mirror : Tree -> Tree
mirror t = case t of
  Leaf -> Leaf
  Node l v r -> Node (mirror r) v (mirror l)

repeatMirror : Int32 -> Tree -> Tree
repeatMirror n t = case eqInt32 n zero of
  True -> t
  False -> case predInt32 n of
    Left _e -> t
    Right m -> repeatMirror m (mirror t)

spineLast : Tree -> Int32 -> Int32
spineLast t lastV = case t of
  Leaf -> lastV
  Node l v _r -> spineLast l v

main : IO Never Unit
main = case buildLeft 10_000 Leaf of
  Left _e -> IO.Stdout.print "UNDERFLOW"
  Right t -> IO.Stdout.print (showInt32 (spineLast (repeatMirror 1000 t) zero))
