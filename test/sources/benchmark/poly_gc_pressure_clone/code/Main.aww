{- Polymorphic variant of 'gc_pressure_clone'. Same reclaim-pressure
   shape (build a list, deep-clone many times, walk final clone) but
   the list type is polymorphic ('List a') instead of monomorphic
   ('IntList'). All instantiations at 'a = Int32', so the runtime
   cell shape after lowering should be identical. Any divergence in
   peak RSS / wall isolates compiler overhead from polymorphic
   instantiation under heavy clone+discard pressure.

   Sizing identical to 'gc_pressure_clone': 'repeat 100000 1', then
   'cloneN 3000', then 'sumList' of final. -}
import IO.Stdout

zero : Int32
zero = 0

type List a = Nil | Cons a (List a)

repeat : Int32 -> Int32 -> List Int32
repeat n value = case eqInt32 n zero of
  True -> Nil
  False -> case predInt32 n of
    Left _e -> Nil
    Right m -> Cons value (repeat m value)

clone : List Int32 -> List Int32
clone lst = case lst of
  Nil -> Nil
  Cons x xs -> Cons x (clone xs)

cloneN : Int32 -> List Int32 -> List Int32
cloneN times lst = case eqInt32 times zero of
  True -> lst
  False -> case predInt32 times of
    Left _e -> lst
    Right m -> cloneN m (clone lst)

sumList : List Int32 -> Int32 -> Int32
sumList lst acc = case lst of
  Nil -> acc
  Cons x xs -> case addInt32 acc x of
    Left _e -> acc
    Right next -> sumList xs next

main : IO Never Unit
main =
  let original : List Int32 = repeat 100_000 1
      cloned : List Int32 = cloneN 3_000 original
   in IO.Stdout.print (showInt32 (sumList cloned zero))
