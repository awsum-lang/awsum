{- In-place reconstruction applies only to cells that can be reused.

   `swap`'s inner case scrutinises a binder read twice (the `One` arm returns it
   directly), so its `Pair` cell is not a reuse target even though the `Two` arm
   rebuilds a same-arity `Pair`.

   `spin` cases on its own parameter and rebuilds a same-arity cell in each loop
   arm — that cell is reuse-eligible, so the reconstruction happens in place.

   `make` and `eat` are loops so their argument and result stay runtime-opaque,
   keeping any case from folding at compile time. Prints `ba`. -}

import IO.Stdout

type Pair = Two String String | One String

type Wrap = Wrap Pair

make : Int32 -> Wrap
make n = case eqInt32 n 0 of
  True -> Wrap (Two "a" "b")
  False -> case predInt32 n of
    Left _u -> Wrap (One "u")
    Right m -> make m

swap : Wrap -> Pair
swap w = case w of
  Wrap p -> case p of
    One _s -> p
    Two x y -> Two y x

eat : Int32 -> Pair -> String
eat k q = case eqInt32 k 0 of
  True -> case q of
    One s2 -> s2
    Two x2 _y2 -> x2
  False -> case predInt32 k of
    Left _u2 -> "u"
    Right j -> eat j q

spin : Int32 -> Pair -> Pair
spin c q2 = case eqInt32 c 0 of
  True -> q2
  False -> case predInt32 c of
    Left _u3 -> q2
    Right m2 -> case q2 of
      One s3 -> spin m2 (One s3)
      Two x3 y3 -> spin m2 (Two y3 x3)

main : IO Never Unit
main = IO.Stdout.print (eat 1 (swap (make 1))) |> andThenIO (\_u4 -> IO.Stdout.print (eat 0 (spin 1 (swap (make 0)))))
