{- `succUInt32`: `Left OverflowError` at 4294967295; `succUInt32 2147483647` traps high-bit signedness on JVM/CLR. -}

import IO.Stdout

render : Either OverflowError UInt32 -> Either StringTooLong String
render r = case r of
  Left e -> "overflow: " ++ showOverflowError e
  Right v -> "ok: " ++ showUInt32 v

res : Either StringTooLong String
res = do
  a <- render (succUInt32 maxUInt32)
  b <- render (succUInt32 4_294_967_294)
  c <- render (succUInt32 2_147_483_647)
  d <- render (succUInt32 minUInt32)
  s0 <- a ++ ", "
  s1 <- s0 ++ b
  s2 <- s1 ++ ", "
  s3 <- s2 ++ c
  s4 <- s3 ++ ", "
  s4 ++ d

main : IO Never Unit
main = eitherToIO res
  |> andThenIO IO.Stdout.print
  |> handleErrorIO onError

onError : StringTooLong -> IO Never Unit
onError e = case e of
  StringTooLong -> IO.Stdout.print "STRING_TOO_LONG"
