{- `succUInt32`: `Left OverflowError` at 4294967295; `succUInt32 2147483647` traps high-bit signedness on JVM/CLR. -}
import IO.Stdout

render : Either OverflowError UInt32 -> Either StringTooLong String
render r = case r of
  Left e -> "overflow: " ++ showOverflowError e
  Right v -> "ok: " ++ showUInt32 v

main : Either (StringTooLong | UnpairedUtf16Surrogate) String -> IO Unit
main _input =
  let res : Either StringTooLong String = do
        a <- render (succUInt32 maxUInt32)
        b <- render (succUInt32 4294967294)
        c <- render (succUInt32 2147483647)
        d <- render (succUInt32 minUInt32)
        s0 <- a ++ ", "
        s1 <- s0 ++ b
        s2 <- s1 ++ ", "
        s3 <- s2 ++ c
        s4 <- s3 ++ ", "
        s4 ++ d
   in case res of
        Left _ -> IO.Stdout.print "STRING_TOO_LONG"
        Right s -> IO.Stdout.print s
