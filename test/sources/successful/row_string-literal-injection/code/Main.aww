{- String-literal injection into a structural sum `(Int32 | String)` across
   several positions: a value-def body (`sv`), a `case`-arm result (`pick`),
   and a `let` RHS (`fromLet`). A consumer reads each injected value back via
   a row `case`. Prints `S`, `9`, `T`, `1`, `L` in order. -}

import IO.Stdout

sv : Int32 | String
sv = "S"

iv : Int32 | String
iv = 9

d : (Int32 | String) -> String
d x = case x of
  (n : Int32) -> showInt32 n
  (s : String) -> s

pick : Bool -> (Int32 | String)
pick b = case b of
  True -> "T"
  False -> 1

fromLet : Bool -> String
fromLet _b =
  let lv : Int32 | String = "L"
   in d lv

main : IO Never Unit
main = IO.Stdout.print (d sv)
  |> andThenIO (\_u -> IO.Stdout.print (d iv))
  |> andThenIO (\_u -> IO.Stdout.print (d (pick True)))
  |> andThenIO (\_u -> IO.Stdout.print (d (pick False)))
  |> andThenIO (\_u -> IO.Stdout.print (fromLet True))
