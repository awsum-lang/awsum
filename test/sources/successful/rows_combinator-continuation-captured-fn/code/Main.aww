{- A row combinator (`bindEither`) whose inline continuation applies a
   captured function-typed parameter (`\n -> k n`) — the row-typed form of
   the closure-capture case.

   Defunctionalising the enclosing HOF must resolve the captured `k` (a
   value, not a callee) to the incoming closure, or the row-monomorphised
   `bindEither` specialisation references a dangling free `k` and every
   backend crashes / reads undefined.

   `oa = Right 1`, so `bindEither` runs the continuation `k 1`; `cont`
   returns `Left EB`, so every backend prints `B`. -}

import IO.Stdout

type EA = EA

type EB = EB

oa : Either EA Int32
oa = Right 1

cont : Int32 -> Either EB Int32
cont _n = Left EB

poly : (Int32 -> Either EB Int32) -> Either (EA | EB) Int32
poly k = bindEither oa (\n -> k n)

describe : Either (EA | EB) Int32 -> String
describe r = case r of
  Left (_a : EA) -> "A"
  Left (_b : EB) -> "B"
  Right v -> showInt32 v

main : IO Never Unit
main = IO.Stdout.print (describe (poly cont))
