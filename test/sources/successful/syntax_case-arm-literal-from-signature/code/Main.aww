{- Bidirectional check: bare literal in a case-arm picks up its type
   from the enclosing function's return signature. -}

import IO.Stdout

firstZero : Maybe (Maybe Int32) -> Int32
firstZero x = case x of
  Just (Just n) -> n
  Just Nothing -> 0
  Nothing -> 0

main : IO Never Unit
main = IO.Stdout.print (showInt32 (firstZero Nothing))
