-- Test: parametric ADT with one data constructor and one nullary constructor
import IO.Stdout

type Lookup a = Found a | NotFound

unwrap : Lookup String -> String
unwrap x = case x of
  Found value -> value
  NotFound -> "not found"

main : String -> IOUnit
main _input = IO.Stdout.print (unwrap (Found "hello") ++ ", " ++ unwrap NotFound)
