-- Stress test: tail-recursive countDown from 100_000 to 0 over Int32.
-- 100_000 frames would blow the system stack on every target without
-- TCO (V8 default is ~13k, JVM ~16k, stock libc threads 8k pages), so
-- if this program prints "right: 0" on all five backends the compiler
-- is actually eliminating the self-tail call and turning it into a
-- jump. Paired with @countdown-int32-stress@ (non-tail counterpart),
-- which exercises the CPS + defunctionalization pass at the same depth.
--
-- The body uses @eqInt32 n 0@ instead of an integer-literal pattern
-- because integer-literal patterns are not implemented yet; once they
-- are, the termination check can collapse to @case n of 0 -> ...@.
-- @countDown@'s result is an @Either UnderflowError Int32@ to keep
-- @predInt32@'s full shape threaded through — the @Left@ arm is
-- unreachable for any positive input (we hit zero long before
-- @predInt32@ could ever see @minInt32@), but it is still pattern-
-- matched so the type system is satisfied without unsafe casts.
import IO.Stdout

zero : Int32
zero = 0

countDown : Int32 -> Either UnderflowError Int32
countDown n = case eqInt32 n zero of
  True -> Right zero
  False -> case predInt32 n of
    Left e -> Left e
    Right m -> countDown m

showResult : Either UnderflowError Int32 -> String
showResult r = case r of
  Left e -> "left: " ++ showUnderflowError e
  Right v -> "right: " ++ showInt32 v

start : Int32
start = 100000

main : String -> IOUnit
main _input = IO.Stdout.print (showResult (countDown start))
