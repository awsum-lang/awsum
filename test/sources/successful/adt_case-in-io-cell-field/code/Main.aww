{- A multi-arm `case` used directly as the argument to `IO.Stdout.print`, so
   the case sits inside a constructor field. Compiles and runs on every
   backend; prints `1`. -}

import IO.Stdout

f : Maybe Int32 -> IO Never Unit
f x = IO.Stdout.print (case x of
  Nothing -> "n"
  Just n -> showInt32 n
)

main : IO Never Unit
main = f (Just (1 : Int32))
