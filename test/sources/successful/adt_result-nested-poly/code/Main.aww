{- Nested polymorphic Result; flat 4-arm inline patterns. -}

import IO.Stdout

type Result a e = Ok a | Err e

unwrap : Result (Result a a) (Result a a) -> a
unwrap r = case r of
  Ok (Ok value) -> value
  Ok (Err value) -> value
  Err (Ok value) -> value
  Err (Err value) -> value

res : Either StringTooLong String
res = do
  s0 <- unwrap (Ok (Ok "1")) ++ ","
  s1 <- s0 ++ unwrap (Ok (Err "2"))
  s2 <- s1 ++ ","
  s3 <- s2 ++ unwrap (Err (Ok "3"))
  s4 <- s3 ++ ","
  s4 ++ unwrap (Err (Err "4"))

main : IO Never Unit
main = eitherToIO res
  |> andThenIO IO.Stdout.print
  |> handleErrorIO onError

onError : StringTooLong -> IO Never Unit
onError e = case e of
  StringTooLong -> IO.Stdout.print "STRING_TOO_LONG"
