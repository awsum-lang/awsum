{- Nested polymorphic Result; flat 4-arm inline patterns. -}
import IO.Stdout

type Result a e = Ok a | Err e

unwrap : Result (Result a a) (Result a a) -> a
unwrap r = case r of
  Ok (Ok value) -> value
  Ok (Err value) -> value
  Err (Ok value) -> value
  Err (Err value) -> value

main : String -> IO Unit
main _input = IO.Stdout.print (unwrap (Ok (Ok "1")) ++ "," ++ unwrap (Ok (Err "2")) ++ "," ++ unwrap (Err (Ok "3")) ++ "," ++ unwrap (Err (Err "4")))
