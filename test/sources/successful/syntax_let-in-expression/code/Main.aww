{- Standalone `let n = e in body`: multi-binding layout form, inner
   binding referencing outer, and `let` used in argument position. -}

import IO.Stdout

pad : String -> Either StringTooLong String
pad s = do
  p <- "[" ++ s
  q <- p ++ "]"
  q ++ q

main : IO Never Unit
main =
  let res : Either StringTooLong String = (do
        padded <- pad "hi"
        s0 <- "<" ++ padded
        s0 ++ ">"
      )
   in eitherToIO res
        |> andThenIO IO.Stdout.print
        |> handleErrorIO onError

onError : StringTooLong -> IO Never Unit
onError e = case e of
  StringTooLong -> IO.Stdout.print "STRING_TOO_LONG"
