{- Standalone `let n = e in body`: multi-binding layout form, inner
   binding referencing outer, and `let` used in argument position. -}
import IO.Stdout

pad : String -> Either StringTooLong String
pad s = do
  p <- "[" ++ s
  q <- p ++ "]"
  q ++ q

main : Either (StringTooLong | UnpairedUtf16Surrogate) String -> IO Never Unit
main _input =
  let res : Either StringTooLong String = (do
        padded <- pad "hi"
        s0 <- "<" ++ padded
        s0 ++ ">"
      )
   in case res of
        Left _ -> IO.Stdout.print "STRING_TOO_LONG"
        Right s -> IO.Stdout.print s
