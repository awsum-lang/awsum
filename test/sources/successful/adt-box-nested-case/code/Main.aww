-- Test: nested Box with sequential case expressions instead of inline patterns
import IO.Stdout

type Box a = Box a

unwrap : Box (Box (Box String)) -> String
unwrap b = case b of
  Box b2 -> case b2 of
    Box b3 -> case b3 of
      Box value -> value

main : String -> IOUnit
main input = IO.Stdout.print (unwrap (Box (Box (Box "hello"))))
