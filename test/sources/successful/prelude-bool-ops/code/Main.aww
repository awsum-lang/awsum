-- Test: Bool operators `not`, `and`, `or` from the prelude.
-- No `showBool` in the prelude, so we case-of to stringify.
import IO.Stdout

showBool : Bool -> String
showBool b = case b of
  True -> "T"
  False -> "F"

main : String -> IOUnit
main _input = IO.Stdout.print (showBool (not True) ++ showBool (not False) ++ showBool (and True False) ++ showBool (and True True) ++ showBool (or False False) ++ showBool (or True False))
