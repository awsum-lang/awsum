{- Multi-child non-tail self-recursion at depth 100_000: `sumTree` makes
   the inner `sumTree l …` a non-tail argument to the outer tail
   `sumTree r …`, so two non-tail self-calls run on every Node. Runs in
   bounded stack on every backend. -}

import IO.Stdout

type Tree = Leaf | Node Tree Int32 Tree

{- Build a left-spine tree of depth n tail-recursively. Every value is 1
   so the total sum equals the depth. -}

buildLeft : Int32 -> Tree -> Either UnderflowError Tree
buildLeft n acc = case eqInt32 n 0 of
  True -> Right acc
  False -> case predInt32 n of
    Left e -> Left e
    Right m -> buildLeft m (Node acc 1 Leaf)

{- Total Int32 sum of all values in the tree never exceeds the input
   depth here, so 'addInt32' cannot overflow on this input. -}

addOr0 : Int32 -> Int32 -> Int32
addOr0 a b = case addInt32 a b of
  Left _e -> 0
  Right v -> v

{- Double-recursive sum: both the inner 'sumTree l ...' (non-tail,
   passes its result as the outer call's second argument) and the outer
   'sumTree r ...' run on every Node. -}

sumTree : Tree -> Int32 -> Int32
sumTree t acc = case t of
  Leaf -> acc
  Node l v r -> sumTree r (sumTree l (addOr0 acc v))

main : IO Never Unit
main = eitherToIO (buildLeft 100_000 Leaf)
  |> andThenIO (\t -> IO.Stdout.print (showInt32 (sumTree t 0)))
  |> handleErrorIO onError

onError : UnderflowError -> IO Never Unit
onError e = case e of
  UnderflowError -> IO.Stdout.print "UNDERFLOW"
