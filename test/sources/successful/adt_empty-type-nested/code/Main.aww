{- Uninhabited type detected through deep nesting. -}
import IO.Stdout

type Box a = Box a

type Result a e = Ok a | Err e

unwrap : Result String (Box (Box (Box Never))) -> String
unwrap r = case r of
  Ok value -> value

main : Either (StringTooLong | UnpairedUtf16Surrogate) String -> IO Never Unit
main _input = IO.Stdout.print (unwrap (Ok "hello"))
