-- A 'do' block whose three '<-' steps each return 'Either' with a
-- different error label, and whose overall error type is the row-
-- semantic union of all three. The trailing 'pureEither c' produces
-- a 'Right' carrying the last bind's value.
--
-- Runtime: this test exercises the failure path (op2 fails with
-- 'ErrorC'). The result short-circuits at the first 'Left' and
-- bubbles up through the desugared 'bindEither' chain. The dispatch
-- on the row error uses the same FNV-1a tag-by-name protocol that
-- powers the rest of the structural-sums runtime, so the consumer
-- ('describe') routes to the correct arm by hash regardless of
-- which alternative the value was originally constructed under.
import IO.Stdout

type ErrorA = ErrorA

type ErrorB = ErrorB

type ErrorC = ErrorC

op1 : Either ErrorA Int32
op1 = Right 1

op2 : Either (ErrorB | ErrorC) Int32
op2 = Left ErrorC

op3 : Either ErrorB Int32
op3 = Right 3

f : Either (ErrorA | ErrorB | ErrorC) Int32
f = do
  a <- op1
  b <- op2
  c <- op3
  pureEither c

describe : Either (ErrorA | ErrorB | ErrorC) Int32 -> String
describe r = case r of
  Left e -> case e of
    (_a : ErrorA) -> "ErrorA"
    (_b : ErrorB) -> "ErrorB"
    (_c : ErrorC) -> "ErrorC"
  Right n -> "Ok " ++ showInt32 n

main : String -> IO Unit
main _input = IO.Stdout.print (describe f)
