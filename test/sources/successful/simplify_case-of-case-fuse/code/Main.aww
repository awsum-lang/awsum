{- A `case` whose scrutinee is another `case` (a tower of `and b True`): the
   compiler fuses the nested dispatch into a single `case` per level. A runtime
   seed keeps the scrutinee from folding to a constant. Prints `T`. -}

import IO.Stdout

chain : Bool -> Bool
chain b = and (and (and b True) True) True

label : Bool -> String
label b = case chain b of
  True -> "T"
  False -> "F"

main : IO Never Unit
main = IO.Stdout.print (label (eqUInt32 (lengthUtf8Bytes "ab") 2))
