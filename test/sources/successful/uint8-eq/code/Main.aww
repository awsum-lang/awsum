-- Test: `eqUInt8` returns `True` for matching UInt8 values and `False`
-- otherwise. Covers the range boundaries (`0` vs `0`, `255` vs `255`)
-- and a couple of mixed cases. The JVM backend requires an & 0xFF mask
-- on UInt8 operations, so equality at the upper boundary is the
-- strongest smoke test of the mask being in place.
import IO.Stdout

render : Bool -> String
render b = case b of
  True -> "T"
  False -> "F"

main : String -> IOUnit
main _input = IO.Stdout.print (render (eqUInt8 0 0) ++ render (eqUInt8 255 255) ++ render (eqUInt8 255 0) ++ render (eqUInt8 128 127))
