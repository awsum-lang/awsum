{- `succInt32`: ordinary `Right (x+1)`; `Left OverflowError` at `maxInt32`. -}

import IO.Stdout

render : Either OverflowError Int32 -> Either StringTooLong String
render r = case r of
  Left e -> "overflow: " ++ showOverflowError e
  Right v -> "ok: " ++ showInt32 v

res : Either StringTooLong String
res = do
  a <- render (succInt32 42)
  b <- render (succInt32 maxInt32)
  s0 <- a ++ ", "
  s0 ++ b

main : IO Never Unit
main = eitherToIO res
  |> andThenIO IO.Stdout.print
  |> handleErrorIO onError

onError : StringTooLong -> IO Never Unit
onError e = case e of
  StringTooLong -> IO.Stdout.print "STRING_TOO_LONG"
