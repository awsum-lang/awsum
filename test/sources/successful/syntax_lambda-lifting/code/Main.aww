{- Closed lambdas in two shapes: one passed to a HOF (`apply (\n -> n) 42`),
   and a `do`-block sequencing `Either` steps. Prints `42 / Ok 1`. -}

import IO.Stdout

apply : (a -> b) -> a -> b
apply f x = f x

inc42 : Int32
inc42 = apply (\n -> n) 42

type ErrA = ErrA

type ErrB = ErrB

op1 : Either ErrA Int32
op1 = Right 1

op2WithA : Int32 -> Either ErrB Int32
op2WithA n = Right n

g : Either (ErrA | ErrB) Int32
g = do
  a <- op1
  b <- op2WithA a
  pureEither b

describe : Either (ErrA | ErrB) Int32 -> Either StringTooLong String
describe r = case r of
  Left e -> case e of
    ErrA -> Right "ErrA"
    ErrB -> Right "ErrB"
  Right n -> "Ok " ++ showInt32 n

res : Either StringTooLong String
res = do
  d <- describe g
  s0 <- showInt32 inc42 ++ " / "
  s0 ++ d

main : IO Never Unit
main = eitherToIO res
  |> andThenIO IO.Stdout.print
  |> handleErrorIO onError

onError : StringTooLong -> IO Never Unit
onError e = case e of
  StringTooLong -> IO.Stdout.print "STRING_TOO_LONG"
