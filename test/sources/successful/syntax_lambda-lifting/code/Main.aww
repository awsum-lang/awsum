{- Lambda lifting at lowering: closed lambda passed to a HOF, and a
   `do`-block whose desugaring leaves a real lambda for the lifter. -}
import IO.Stdout

apply : (a -> b) -> a -> b
apply f x = f x

inc42 : Int32
inc42 = apply (\n -> n) 42

type ErrA = ErrA

type ErrB = ErrB

op1 : Either ErrA Int32
op1 = Right 1

op2WithA : Int32 -> Either ErrB Int32
op2WithA n = Right n

g : Either (ErrA | ErrB) Int32
g = do
  a <- op1
  b <- op2WithA a
  pureEither b

describe : Either (ErrA | ErrB) Int32 -> Either StringTooLong String
describe r = case r of
  Left e -> case e of
    (_ : ErrA) -> Right "ErrA"
    (_ : ErrB) -> Right "ErrB"
  Right n -> "Ok " ++ showInt32 n

main : Either (StringTooLong | UnpairedUtf16Surrogate) String -> IO Unit
main _input =
  let res : Either StringTooLong String = do
        d <- describe g
        s0 <- showInt32 inc42 ++ " / "
        s0 ++ d
   in case res of
        Left _ -> IO.Stdout.print "STRING_TOO_LONG"
        Right s -> IO.Stdout.print s
