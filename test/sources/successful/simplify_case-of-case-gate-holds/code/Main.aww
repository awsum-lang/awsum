{- A `case` whose scrutinee is another `case` where the compiler declines to
   fuse: both inner arms select the same outer arm, but that arm contains
   cases of its own, so fusing would duplicate it without resolving anything.
   The nested dispatch stays as written. Prints `abc`. -}

import IO.Stdout

big : Bool -> String
big b = case or b True of
  True -> case "a" ++ "b" of
    Left _e -> "overflow"
    Right ab -> case ab ++ "c" of
      Left _e2 -> "overflow2"
      Right abc -> abc
  False -> "no"

main : IO Never Unit
main = IO.Stdout.print (big (eqUInt32 (lengthUtf8Bytes "x") 9))
