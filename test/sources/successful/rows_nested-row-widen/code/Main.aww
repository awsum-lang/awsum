{- A value bound at a narrow row flows into a wider one where a shared label
   is a nominal head whose inner row grew (`Maybe Bool` into
   `Maybe (Bool | Unit)`). `narrow = Just True`, widened and matched back by
   nested row `case`, so it prints `T`. -}

import IO.Stdout

type A = A

narrow : Maybe Bool | A
narrow = Just True

widened : Maybe (Bool | Unit) | A
widened = narrow

describe : (Maybe (Bool | Unit) | A) -> String
describe x = case x of
  (_a : A) -> "A"
  (m : Maybe (Bool | Unit)) -> case m of
    Nothing -> "N"
    Just inner -> case inner of
      (b : Bool) -> case b of
        True -> "T"
        False -> "F"
      (_u : Unit) -> "U"

main : IO Never Unit
main = IO.Stdout.print (describe widened)
