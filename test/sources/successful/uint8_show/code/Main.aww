{- `showUInt8`: full range; values 128..255 trap signed-byte divergence on JVM. -}
import IO.Stdout

main : Either (StringTooLong | UnpairedUtf16Surrogate) String -> IO Never Unit
main _input =
  let res : Either StringTooLong String = do
        s0 <- showUInt8 minUInt8 ++ ", "
        s1 <- s0 ++ showUInt8 42
        s2 <- s1 ++ ", "
        s3 <- s2 ++ showUInt8 200
        s4 <- s3 ++ ", "
        s4 ++ showUInt8 maxUInt8
   in case res of
        Left _ -> IO.Stdout.print "STRING_TOO_LONG"
        Right s -> IO.Stdout.print s
