{- A lambda used directly as the head of an application: '(\x -> x) 5'.

   Before this iteration this hit the saturated synthesis form (lambdas
   only typechecked against a known expected type, e.g. inside a HOF
   argument slot). After enabling lambda synthesis the head's type is
   synthesised with span-unique fresh tyvars and bidirectional unify
   with the EApp's expected result type pins them — the bare integer
   literal '5' reaches codegen with 'Int32' fixed by the outer
   signature. Cross-backend stdout asserts the same answer everywhere. -}
import IO.Stdout

runMe : Int32
runMe = (\x -> x) 5

doubled : Int32
doubled = (\n -> n) runMe

main : String -> IO Unit
main _input = IO.Stdout.print (showInt32 doubled)
