{- Exercises the `|>` pipe operator (`x |> f` is `f x`) in three shapes:
   a basic chain, a left-associative chain, and a lambda on the right of
   `|>`. Prints one line combining all three results (`42|42|42`). -}

import IO.Stdout

n : Int32
n = 42

basic : String
basic = n |> showInt32

chained : String
chained = n
  |> showInt32
  |> wrap
  |> wrap

viaLambda : String
viaLambda = n |> (\i -> showInt32 i)

wrap : String -> String
wrap s = s

joined : Either StringTooLong String
joined = do
  a <- basic ++ "|"
  b <- a ++ chained
  c <- b ++ "|"
  c ++ viaLambda

main : IO Never Unit
main = eitherToIO joined
  |> andThenIO IO.Stdout.print
  |> handleErrorIO onError

onError : StringTooLong -> IO Never Unit
onError e = case e of
  StringTooLong -> IO.Stdout.print "STRING_TOO_LONG"
