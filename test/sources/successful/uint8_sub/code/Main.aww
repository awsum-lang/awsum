{- `subUInt8`: `Left UnderflowError` when `a < b`; `0 - 255` traps sign-extension on JVM/CLR. -}
import IO.Stdout

render : Either UnderflowError UInt8 -> Either StringTooLong String
render r = case r of
  Left e -> "underflow: " ++ showUnderflowError e
  Right v -> "ok: " ++ showUInt8 v

main : Either (StringTooLong | UnpairedUtf16Surrogate) String -> IO Never Unit
main _input =
  let res : Either StringTooLong String = (do
        a <- render (subUInt8 5 5)
        b <- render (subUInt8 maxUInt8 minUInt8)
        c <- render (subUInt8 minUInt8 1)
        d <- render (subUInt8 minUInt8 maxUInt8)
        s0 <- a ++ ", "
        s1 <- s0 ++ b
        s2 <- s1 ++ ", "
        s3 <- s2 ++ c
        s4 <- s3 ++ ", "
        s4 ++ d
      )
   in case res of
        Left _ -> IO.Stdout.print "STRING_TOO_LONG"
        Right s -> IO.Stdout.print s
