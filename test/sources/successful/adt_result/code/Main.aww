{- Both branches unify to the same type variable (`Result a a -> a`). -}

import IO.Stdout

type Result a e = Ok a | Err e

unwrap : Result a a -> a
unwrap r = case r of
  Ok value -> value
  Err value -> value

main : IO Never Unit
main =
  let res : Either StringTooLong String = (do
        s0 <- unwrap (Ok "1") ++ ","
        s0 ++ unwrap (Err "2")
      )
   in case res of
        Left _ -> IO.Stdout.print "STRING_TOO_LONG"
        Right s -> IO.Stdout.print s
