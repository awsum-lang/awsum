{- Nested ADT with inline nested pattern (single arm). -}
import IO.Stdout

type Box a = Box a

unwrap : Box (Box (Box String)) -> String
unwrap b = case b of
  Box (Box (Box value)) -> value

main : Either (StringTooLong | UnpairedUtf16Surrogate) String -> IO Unit
main _input = IO.Stdout.print (unwrap (Box (Box (Box "hello"))))
