{- `mulUInt8`: `Left OverflowError` above 255; `255 * 255` traps sign-extension on JVM/CLR. -}
import IO.Stdout

render : Either OverflowError UInt8 -> String
render r = case r of
  Left e -> "overflow: " ++ showOverflowError e
  Right v -> "ok: " ++ showUInt8 v

main : String -> IO Unit
main _input = IO.Stdout.print (render (mulUInt8 15 17) ++ ", " ++ render (mulUInt8 16 16) ++ ", " ++ render (mulUInt8 maxUInt8 maxUInt8) ++ ", " ++ render (mulUInt8 minUInt8 200) ++ ", " ++ render (mulUInt8 1 200))
