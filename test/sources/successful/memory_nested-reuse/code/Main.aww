{- A binder whose sole use is the scrutinee of an inner case dies with
   that dispatch: Awsum.Lifetime sinks its drop into the arms, and
   Awsum.Reuse rewrites the same-arity reconstruction nested inside the
   pack rebuild — core.txt has CReuse on the pack and, inside its field,
   CReuse on the list cell (with a self-move on the kept head). Pack and
   Stack are user types, so both reuses are ReuseGuarded: LLVM/WASM run
   the loop allocation-free through the uniqueness check (the cells are
   genuinely linear here), the managed backends allocate.

   make is a loop so the list stays runtime-opaque; the first print is
   the unreversed top, so a reversal that silently stopped reusing or
   reordering shows in stdout. -}

import IO.Stdout

type Stack = Empty | Push String Stack

type Pack = Pack Stack Stack

make : Int32 -> Stack -> Stack
make n acc = case eqInt32 n 0 of
  True -> acc
  False -> case predInt32 n of
    Left _u -> acc
    Right m -> make m (Push (showInt32 n) acc)

rev : Pack -> Stack
rev pk = case pk of
  Pack st acc2 -> case st of
    Empty -> acc2
    Push s rest -> rev (Pack rest (Push s acc2))

top : Stack -> String
top st2 = case st2 of
  Empty -> "empty"
  Push s2 _rest2 -> s2

main : IO Never Unit
main =
  IO.Stdout.print (top (make 3 Empty))
    |> andThenIO (\_u2 -> IO.Stdout.print (top (rev (Pack (make 3 Empty) Empty))))
