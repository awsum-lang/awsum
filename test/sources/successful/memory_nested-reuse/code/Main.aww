{- A loop that reverses a stack while rebuilding a pack of two stacks,
   so the inner list cell is rebuilt inside the pack rebuild — two nested
   same-shape reconstructions in one iteration. `make` is a loop, so the
   list stays opaque at compile time; the first print is the unreversed
   top, so a reversal that reordered or corrupted cells would show in
   stdout. Identical stdout on every backend is the check. -}

import IO.Stdout

type Stack = Empty | Push String Stack

type Pack = Pack Stack Stack

make : Int32 -> Stack -> Stack
make n acc = case eqInt32 n 0 of
  True -> acc
  False -> case predInt32 n of
    Left _u -> acc
    Right m -> make m (Push (showInt32 n) acc)

rev : Pack -> Stack
rev pk = case pk of
  Pack st acc2 -> case st of
    Empty -> acc2
    Push s rest -> rev (Pack rest (Push s acc2))

top : Stack -> String
top st2 = case st2 of
  Empty -> "empty"
  Push s2 _rest2 -> s2

main : IO Never Unit
main = IO.Stdout.print (top (make 3 Empty)) |> andThenIO (\_u2 -> IO.Stdout.print (top (rev (Pack (make 3 Empty) Empty))))
