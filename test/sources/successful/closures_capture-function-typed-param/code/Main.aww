{- A higher-order function `poly` captures its own function-typed parameter
   `k` inside a nested lambda (`\n -> k n`) and passes that closure to
   another HOF (`applyOnce`). `poly (\m -> m)` applies the identity to 5.
   Prints `5`. -}

import IO.Stdout

applyOnce : (Int32 -> Int32) -> Int32 -> Int32
applyOnce f x = f x

poly : (Int32 -> Int32) -> Int32
poly k = applyOnce (\n -> k n) 5

main : IO Never Unit
main = IO.Stdout.print (showInt32 (poly (\m -> m)))
