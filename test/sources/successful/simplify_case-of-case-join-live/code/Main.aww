{- A `case` whose scrutinee is another `case`, where the outer arms reference
   an enclosing binder (`s`): the fused dispatch keeps the binder live across
   the shared path. Prints `abc`. -}

import IO.Stdout

describe : String -> String
describe s = case (case eqUInt32 (lengthUtf8Bytes s) 0 of
  True -> False
  False -> eqUInt32 (lengthUtf8Bytes s) 3
) of
  True -> s
  False -> "other"

main : IO Never Unit
main = IO.Stdout.print (describe "abc")
