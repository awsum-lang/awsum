{- `succUInt8`: `Left OverflowError` at 255; `succUInt8 254` traps signed-byte clipping on JVM. -}
import IO.Stdout

render : Either OverflowError UInt8 -> String
render r = case r of
  Left e -> "overflow: " ++ showOverflowError e
  Right v -> "ok: " ++ showUInt8 v

main : String -> IO Unit
main _input = IO.Stdout.print (render (succUInt8 maxUInt8) ++ ", " ++ render (succUInt8 254) ++ ", " ++ render (succUInt8 minUInt8))
