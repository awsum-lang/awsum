{- A bifunctor map over `Either` applies a row-widening function (`Bool`
   into `(Bool | Unit)`) to whichever side is present. The input shape
   comes from argv, so the map runs at runtime. Prints `right-bool`. -}

import IO.Stdout
import IO.Args

inject : Bool -> (Bool | Unit)
inject b = b

bimapEither : (a -> c) -> (b -> d) -> Either a b -> Either c d
bimapEither f g e = case e of
  Left a -> Left (f a)
  Right b -> Right (g b)

build : List String -> Either Bool Bool
build args = case headList args of
  Nothing -> Left True
  Just _s -> Right True

describe : Either (Bool | Unit) (Bool | Unit) -> String
describe e = case e of
  Left bu -> case bu of
    (_x : Bool) -> "left-bool"
    (_u : Unit) -> "left-unit"
  Right bu -> case bu of
    (_x : Bool) -> "right-bool"
    (_u : Unit) -> "right-unit"

run2 : List String -> IO Never Unit
run2 args = IO.Stdout.print (describe (bimapEither inject inject (build args)))

onError : (StringTooLong | UnpairedUtf16Surrogate) -> IO Never Unit
onError e = case e of
  (_l : StringTooLong) -> IO.Stdout.print "STRING_TOO_LONG"
  (_u : UnpairedUtf16Surrogate) -> IO.Stdout.print "UNPAIRED_UTF16_SURROGATE"

main : IO Never Unit
main = IO.Args.getArgs
  |> andThenIO run2
  |> handleErrorIO onError
