{- A named top-level function (`kk`) passed as the continuation of a
   row-unioning combinator (`bindEither oa kk`). The errors compose into
   `(EA | EB)`. `oa = Left EA`, so the chain short-circuits to `EA` and
   prints `A`. -}

import IO.Stdout

type EA = EA

type EB = EB

oa : Either EA Int32
oa = Left EA

kk : Int32 -> Either EB Int32
kk _n = Right 7

r : Either (EA | EB) Int32
r = bindEither oa kk

de : Either (EA | EB) Int32 -> String
de x = case x of
  Left (_a : EA) -> "A"
  Left (_b : EB) -> "B"
  Right n -> showInt32 n

main : IO Never Unit
main = IO.Stdout.print (de r)
