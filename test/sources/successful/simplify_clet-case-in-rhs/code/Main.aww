{- A `let` whose right-hand side is a multi-arm `case`, used inside a print
   argument. Prints `64`. -}

import IO.Stdout

double : UInt32 -> String
double n = case addUInt32 n n of
  Left _o -> "OVERFLOW"
  Right d -> showUInt32 d

pick : Bool -> UInt32
pick flag = case flag of
  True -> lengthUtf8Bytes "abc"
  False -> lengthUtf8Bytes "zz"

main : IO Never Unit
main = IO.Stdout.print (double (pick (eqUInt32 (lengthUtf8Bytes "one") 3))) |> andThenIO (\_u -> IO.Stdout.print (double (pick (eqUInt32 (lengthUtf8Bytes "no") 3))))
