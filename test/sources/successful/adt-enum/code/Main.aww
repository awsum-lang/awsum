-- Test: simple enum (three nullary constructors) with exhaustive pattern matching
import IO.Stdout

type Color = Red | Green | Blue

show : Color -> String
show c = case c of
  Red -> "Red"
  Green -> "Green"
  Blue -> "Blue"

main : String -> IOUnit
main _input = IO.Stdout.print (show Red ++ ", " ++ show Green ++ ", " ++ show Blue)
