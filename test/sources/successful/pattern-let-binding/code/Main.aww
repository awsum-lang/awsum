-- Pattern on the LHS of a let-binding: `let (Tuple3 a b c) =
-- expr in body` destructures in place. Awsum.Desugar rewrites
-- non-PVar lets to a single-arm `case` before typecheck:
--
--     let (Tuple3 a b c) = expr in body
--   ⇝ case expr of Tuple3 a b c -> body
--
-- Standard exhaustiveness validates the rewrite — single-
-- constructor types pass, refutable patterns raise
-- `NonExhaustiveCase`. Type ascription on a destructuring let
-- (`let (Tuple3 ...) : T = e`) is rejected at desugar time with
-- `PatternLetAscription` — the ascription belongs on the
-- right-hand side instead.
--
-- Both standalone `let-in` and `do { let pat = e; rest }` go
-- through the same rewrite, so the pattern syntax works
-- uniformly in either context.
import IO.Stdout

threeAndDouble : Int32 -> Tuple2 Int32 Int32
threeAndDouble n = case mulInt32 n 2 of
  Left _ -> Tuple2 n n
  Right d -> Tuple2 n d

show : Tuple2 Int32 Int32 -> String
show pair =
  let (Tuple2 a b) = pair
   in "[" ++ showInt32 a ++ ", " ++ showInt32 b ++ "]"

main : String -> IO Unit
main _input = IO.Stdout.print (show (threeAndDouble 5))
