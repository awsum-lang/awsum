{- A nested `case`-of-`case` tower in `showInt32`'s argument, over a runtime
   value taken from the first command-line argument (or `3` when absent).
   With argument `5` it prints `9`; with no argument (value `3`) it
   prints `1`. -}

import IO.Stdout
import IO.Args

type MyList = MyNil | MyCons Int32 MyList

mklist : Int32 -> MyList
mklist a = case eqInt32 a 0 of
  True -> MyNil
  False -> case predInt32 a of
    Left _e -> MyNil
    Right b -> MyCons a (mklist b)

mkmb : Int32 -> Maybe Int32
mkmb c = case eqInt32 c 0 of
  True -> Nothing
  False -> case predInt32 c of
    Left _e2 -> Nothing
    Right d -> case mkmb d of
      Nothing -> Just c
      Just w -> Just w

run : List String -> IO Never Unit
run args =
  let k2 : Int32 = case headList args of
        Nothing -> 3
        Just s -> case parseInt32 s of
          Left _e3 -> 4
          Right m -> m
   in IO.Stdout.print (showInt32 (case (case (case eqInt32 k2 5 of
        True -> Nothing
        False -> mkmb k2
      ) of
        Nothing -> MyCons 9 (MyCons 2 (MyCons 3 (MyCons 4 (MyCons 5 (MyCons 6 (MyCons 7 (MyCons 8 MyNil)))))))
        Just v -> mklist v
      ) of
        MyCons h _t -> h
        MyNil -> 0
      )
      )

onError : (StringTooLong | UnpairedUtf16Surrogate) -> IO Never Unit
onError e = case e of
  StringTooLong -> IO.Stdout.print "STRING_TOO_LONG"
  UnpairedUtf16Surrogate -> IO.Stdout.print "UNPAIRED"

main : IO Never Unit
main = IO.Args.getArgs
  |> andThenIO run
  |> handleErrorIO onError
