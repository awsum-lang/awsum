{- A local binder may share a bare name with a top-level declaration: the
   user top-level `cont` coexists with a same-named binder the prelude
   introduces inside its `bindIO`. Cross-module shadowing is legal;
   within-module shadowing is not. `getArgs` succeeds with no arguments,
   the continuation fails with `EB`, and the handler prints `EB`. -}

import IO.Stdout
import IO.Args

type EB = EB

cont : List String -> IO EB Int32
cont _args = failIO EB

showN : Int32 -> IO Never Unit
showN n = IO.Stdout.print (showInt32 n)

onError : (StringTooLong | UnpairedUtf16Surrogate | EB) -> IO Never Unit
onError e = case e of
  StringTooLong -> IO.Stdout.print "STRING_TOO_LONG"
  UnpairedUtf16Surrogate -> IO.Stdout.print "UNPAIRED_UTF16_SURROGATE"
  EB -> IO.Stdout.print "EB"

main : IO Never Unit
main = bindIO (bindIO IO.Args.getArgs cont) showN |> handleErrorIO onError
