{- The compiler constant-folds the integer equality built-ins over literal
   operands to `True` / `False`, and the case over the folded `Bool` collapses
   to the selected string. Prints `T;F;F`. -}

import IO.Stdout

eqI32True : String
eqI32True = case eqInt32 (-1) (-1) of
  True -> "T"
  False -> "F"

eqU8False : String
eqU8False = case eqUInt8 3 4 of
  True -> "T"
  False -> "F"

eqU32False : String
eqU32False = case eqUInt32 0 4_294_967_295 of
  True -> "T"
  False -> "F"

main : IO Never Unit
main = IO.Stdout.print eqI32True
  |> andThenIO (\_s1 -> IO.Stdout.print ";")
  |> andThenIO (\_p1 -> IO.Stdout.print eqU8False)
  |> andThenIO (\_s2 -> IO.Stdout.print ";")
  |> andThenIO (\_p2 -> IO.Stdout.print eqU32False)
