{- Two cases that the compiler declines to collapse. `multi` reads its binder
   twice, so the field stays a real read and the case stays. `rebuild`'s loop
   returns the same one-field cell from both arms of a case on its own
   parameter, and that reconstruction is reclaimed in place, so the case stays
   too. Prints `abab5`. -}

import IO.Stdout

multi : Tuple2 String String -> String
multi t = case t of
  Tuple2 a _b -> (case a ++ a of
    Left _e -> "TOO_LONG"
    Right r -> r
  )

rebuild : UInt32 -> Maybe UInt32 -> Maybe UInt32
rebuild k m = case eqUInt32 k 0 of
  True -> m
  False -> case predUInt32 k of
    Left _u -> m
    Right j -> case m of
      Just _n -> rebuild j (Just 5)
      Nothing -> rebuild j (Just 5)

maybeOf : String -> Maybe UInt32
maybeOf s = case eqUInt32 (lengthUtf8Bytes s) 1 of
  True -> Just 9
  False -> Nothing

render : Maybe UInt32 -> String
render m = case m of
  Just n -> showUInt32 n
  Nothing -> "none"

main : IO Never Unit
main = case multi (Tuple2 "ab" "cd") ++ render (rebuild 1 (maybeOf "x")) of
  Left _e2 -> IO.Stdout.print "TOO_LONG"
  Right out -> IO.Stdout.print out
