{- A row combinator nested inside another combinator's inline continuation,
   where the inner combinator uses a named continuation (`inner`) and a
   pure-like operand (`pureEither n`); the errors compose into
   `(EA | EB | EC)`. `oa = Right 3` runs the outer continuation; `inner`
   short-circuits to `Left EC`, so it prints `C`. -}

import IO.Stdout

type EA = EA

type EB = EB

type EC = EC

oa : Either EA Int32
oa = Right 3

inner : Int32 -> Either EC Int32
inner _z = Left EC

res : Either (EA | EB | EC) Int32
res = bindEither oa (\n -> bindEither (pureEither n) inner)

describe : Either (EA | EB | EC) Int32 -> String
describe r = case r of
  Left (_a : EA) -> "A"
  Left (_b : EB) -> "B"
  Left (_c : EC) -> "C"
  Right v -> showInt32 v

main : IO Never Unit
main = IO.Stdout.print (describe res)
