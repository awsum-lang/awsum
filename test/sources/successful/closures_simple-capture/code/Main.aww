{- Closure with a captured outer parameter.

   `captureFn k = apply (\n -> k) answer` — the lambda's body references
   `k`, which is a parameter of the enclosing function. After lifting,
   the closure flows into `apply`'s function-typed parameter as a partial
   application of `$lam$0` with one capture. Defunctionalisation specialises
   `apply` for that closure: the resulting `apply_$<helper>` takes the
   captured `k` as an explicit parameter and calls `$lam$0` directly. -}
import IO.Stdout

apply : (a -> b) -> a -> b
apply f x = f x

answer : Int32
answer = 42

captureFn : Int32 -> Int32
captureFn k = apply (\n -> k) answer

main : String -> IO Unit
main _input = IO.Stdout.print (showInt32 (captureFn 7))
