-- Test: non-tail self-recursion on UInt8 counting down from 255 to 0.
-- The recursive call `countDown m` sits inside a nested `case` that
-- unwraps its `Either UnderflowError String` result and prepends the
-- current index, so it is NOT in tail position — every frame keeps a
-- pending wrap + concat. Cross-backend stdout equivalence here exercises
-- 256 live frames on the system stack on every target, which is well
-- below any per-target limit but gives a concrete regression baseline
-- for the future heap-frames pass that will cover non-tail self-recursion.
--
-- `countDown`'s result is `Either UnderflowError String` — @predUInt8@'s
-- `Left` arm is unreachable here because the termination check
-- (@eqUInt8 n zero@) fires first, so we never call @predUInt8 0@. The
-- arm is still pattern-matched to keep the full shape threaded through,
-- and `showResult` renders the final value so the stdout layout matches
-- the other countdown tests.
import IO.Stdout

zero : UInt8
zero = 0

countDown : UInt8 -> Either UnderflowError String
countDown n = case eqUInt8 n zero of
  True -> Right (showUInt8 n)
  False -> case predUInt8 n of
    Left e -> Left e
    Right m -> case countDown m of
      Left e -> Left e
      Right s -> Right (showUInt8 n ++ "," ++ s)

showResult : Either UnderflowError String -> String
showResult r = case r of
  Left e -> "left: " ++ showUnderflowError e
  Right s -> "right: " ++ s

start : UInt8
start = 255

main : String -> IO Unit
main _input = IO.Stdout.print (showResult (countDown start))
