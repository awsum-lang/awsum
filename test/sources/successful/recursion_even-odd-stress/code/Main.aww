{- Two-way mutual tail recursion at depth 1_000_000 on Int32. Runs in
   bounded stack on every backend. -}

import IO.Stdout

evenInt : Int32 -> Either UnderflowError Bool
evenInt n = case eqInt32 n 0 of
  True -> Right True
  False -> case predInt32 n of
    Left e -> Left e
    Right m -> oddInt m

oddInt : Int32 -> Either UnderflowError Bool
oddInt n = case eqInt32 n 0 of
  True -> Right False
  False -> case predInt32 n of
    Left e -> Left e
    Right m -> evenInt m

showResult : Either UnderflowError Bool -> Either StringTooLong String
showResult r = case r of
  Left e -> "left: " ++ showUnderflowError e
  Right b -> "right: " ++ showBool b

res : Either StringTooLong String
res = showResult (evenInt 1_000_000)

main : IO Never Unit
main = eitherToIO res
  |> andThenIO IO.Stdout.print
  |> handleErrorIO onError

onError : StringTooLong -> IO Never Unit
onError e = case e of
  StringTooLong -> IO.Stdout.print "STRING_TOO_LONG"
