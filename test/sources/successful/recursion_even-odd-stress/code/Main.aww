{- Two-way mutual tail recursion at depth 1_000_000 on Int32; SCC must fuse
   the cluster into a single self-recursive function before TCO folds it. -}
import IO.Stdout

evenInt : Int32 -> Either UnderflowError Bool
evenInt n = case eqInt32 n 0 of
  True -> Right True
  False -> case predInt32 n of
    Left e -> Left e
    Right m -> oddInt m

oddInt : Int32 -> Either UnderflowError Bool
oddInt n = case eqInt32 n 0 of
  True -> Right False
  False -> case predInt32 n of
    Left e -> Left e
    Right m -> evenInt m

showResult : Either UnderflowError Bool -> Either StringTooLong String
showResult r = case r of
  Left e -> "left: " ++ showUnderflowError e
  Right b -> "right: " ++ showBool b

main : Either (StringTooLong | UnpairedUtf16Surrogate) String -> IO Never Unit
main _input =
  let res : Either StringTooLong String = showResult (evenInt 1_000_000)
   in case res of
        Left _ -> IO.Stdout.print "STRING_TOO_LONG"
        Right s -> IO.Stdout.print s
