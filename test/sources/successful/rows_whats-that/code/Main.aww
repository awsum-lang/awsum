{- Full row-polymorphic pattern repertoire on a single scrutinee:
   row arms, nominal arms (`Just`/`Nothing`) and a nested row inside `Just`. -}

import IO.Stdout

whatsThat : (Int32 | String | Maybe (Bool | Unit)) -> Either StringTooLong String
whatsThat x = case x of
  (n : Int32) -> "Int32 " ++ showInt32 n
  (s : String) -> "String " ++ s
  Nothing -> Right "Nothing"
  Just (b : Bool) -> case b of
    True -> Right "Just True"
    False -> Right "Just False"
  Just (u : Unit) -> "Just " ++ showUnit u

res : Either StringTooLong String
res = whatsThat (Just True)

main : IO Never Unit
main = eitherToIO res
  |> andThenIO IO.Stdout.print
  |> handleErrorIO onError

onError : StringTooLong -> IO Never Unit
onError e = case e of
  StringTooLong -> IO.Stdout.print "STRING_TOO_LONG"
