{- A `case` over a literal `Just` whose field carries computation
   (`showInt32 7`) and whose binder is read more than once: the compiler
   declines to substitute the field into each use, since that would re-run the
   computation. The case stays, the field computed once and read through the
   binder. Prints `77`. -}

import IO.Stdout

main : IO Never Unit
main = IO.Stdout.print (case Just (showInt32 (7 : Int32)) of
  Nothing -> "nothing"
  Just s -> case s ++ s of
    Left _e -> "too long"
    Right d -> d
)
