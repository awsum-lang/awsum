{- Direct test of `mapIOError`: rewrites the error type of an IO
   action while preserving the IO tree structure. Pairs with
   `failIO` to build a non-Never error row, then renames it. -}

import IO.Stdout

type ErrA = ErrA

type ErrB = ErrB

action : IO ErrA Unit
action = failIO ErrA

onError : ErrB -> IO Never Unit
onError e = case e of
  ErrB -> IO.Stdout.print "ErrB"

main : IO Never Unit
main =
  let renamed : IO ErrB Unit = mapIOError action (\_a -> ErrB)
   in renamed |> handleErrorIO onError
