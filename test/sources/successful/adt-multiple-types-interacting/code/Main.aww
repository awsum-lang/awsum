{- Tests: three user-defined ADTs (Color, Box a, Result a e) used together
   in a single program with nested pattern matching across types. -}
import IO.Stdout

type Color = Red | Green | Blue

type Box a = Box a

type Result a e = Ok a | Err e

colorName : Color -> String
colorName c = case c of
  Red -> "red"
  Green -> "green"
  Blue -> "blue"

showBoxedColor : Box Color -> String
showBoxedColor bc = case bc of
  Box c -> colorName c

showResult : Result (Box Color) String -> String
showResult r = case r of
  Ok box -> showBoxedColor box
  Err e -> e

main : String -> IOUnit
main input = IO.Stdout.print (showBoxedColor (Box Red) ++ " " ++ showResult (Ok (Box Green)))
