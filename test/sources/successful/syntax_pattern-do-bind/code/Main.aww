{- Pattern on the LHS of a do-bind: `Tuple3 a b c <- e`. -}

import IO.Stdout
import IO.Args

type NoArg = NoArg

opTuple : String -> Either ParseError (Tuple3 Int32 Int32 Int32)
opTuple _raw = Right (Tuple3 1 2 3)

compute : List String -> Either (NoArg | ParseError) String
compute args = do
  raw <- headList args |> nothingAsLeft NoArg
  Tuple3 a b c <- opTuple raw
  pureEither (showInt32 (case addInt32 a b of
    Left _ -> c
    Right ab -> case addInt32 ab c of
      Left _ -> c
      Right abc -> abc
  )
  )

onError : (StringTooLong | UnpairedUtf16Surrogate | NoArg | ParseError) -> IO Never Unit
onError e = case e of
  StringTooLong -> IO.Stdout.print "STRING_TOO_LONG"
  UnpairedUtf16Surrogate -> IO.Stdout.print "UNPAIRED_UTF16_SURROGATE"
  NoArg -> IO.Stdout.print "NO_ARG"
  ParseError -> IO.Stdout.print "PARSE_ERROR"

main : IO Never Unit
main = IO.Args.getArgs
  |> andThenIO (\args -> eitherToIO (compute args))
  |> andThenIO IO.Stdout.print
  |> handleErrorIO onError
