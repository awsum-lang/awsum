{- A boolean step the compiler declines to fold through: the consumer above it
   carries a case in every arm, so folding would duplicate a case-carrying arm
   on each path. The consumer stays a live case dispatching at runtime. Prints
   `TT`. -}

import IO.Stdout

mix : Bool -> Bool
mix b = case b of
  True -> eqUInt32 (lengthUtf8Bytes "xyz") 3
  False -> False

seed : Bool
seed = eqUInt32 (lengthUtf8Bytes (showInt32 42)) 2

other : Bool
other = eqUInt32 (lengthUtf8Bytes (showInt32 7)) 1

result : String
result =
  let s1 = and (mix seed) True
   in case s1 of
        True -> (case other of
          True -> "TT"
          False -> "TF"
        )
        False -> (case other of
          True -> "FT"
          False -> "FF"
        )

main : IO Never Unit
main = IO.Stdout.print result
