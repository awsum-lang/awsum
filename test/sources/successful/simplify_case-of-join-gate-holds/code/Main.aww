{- The duplication pricing of case-of-join holds. The `and` level fuses
   into a residual join; the consumer above it carries a case in every
   arm, so resolving it against the join's value tails would copy a
   case-carrying arm per tail — the strict gate declines, all-or-nothing,
   and the consumer stays where it was: a live case over the join node,
   dispatching at runtime. The pin: one `CJoin` in Core with the consumer
   case still scrutinising it. -}

import IO.Stdout

mix : Bool -> Bool
mix b = case b of
  True -> eqUInt32 (lengthUtf8Bytes "xyz") 3
  False -> False

seed : Bool
seed = eqUInt32 (lengthUtf8Bytes (showInt32 42)) 2

other : Bool
other = eqUInt32 (lengthUtf8Bytes (showInt32 7)) 1

result : String
result =
  let s1 = and (mix seed) True
   in case s1 of
        True -> (case other of
          True -> "TT"
          False -> "TF")
        False -> (case other of
          True -> "FT"
          False -> "FF")

main : IO Never Unit
main = IO.Stdout.print result
