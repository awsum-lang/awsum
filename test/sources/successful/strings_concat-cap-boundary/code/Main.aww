{- Exercises the runtime cap-check inside `(++)` end-to-end on every
   backend. Builds a string of exactly `maxStringLengthUtf16CodeUnits`
   UTF-16 code units via 20 doublings of a 128-CJK-code-unit literal
   (128 * 2^20 = 134_217_728 = cap), confirms the result lands on the
   `Right` branch with a length equal to the constant, then attempts
   one more `++ "!"` and confirms the language-fixed cap pushes that
   one over to `Left StringTooLong`.

   CJK content is the worst case for UTF-8 expansion (3 bytes per
   UTF-16 code unit for the BMP CJK range), so on UTF-8 backends the
   peak resident bytes during the 20th doubling are ~600 MiB. WASM
   handles this through the `__alloc` `memory.grow` loop documented
   in the WASM-Specific Details section of `docs/targets.md`. -}

import IO.Stdout

block : String
block = "你好世界你好世界你好世界你好世界你好世界你好世界你好世界你好世界你好世界你好世界你好世界你好世界你好世界你好世界你好世界你好世界你好世界你好世界你好世界你好世界你好世界你好世界你好世界你好世界你好世界你好世界你好世界你好世界你好世界你好世界你好世界你好世界"

{- Doubles `acc` `n` times via `acc ++ acc`. Threading through
   `bindEither` propagates a `Left StringTooLong` from any
   intermediate `(++)` overflow. With `n = 20` and a 128-code-unit
   block the result is exactly `cap`. -}
build : UInt32 -> String -> Either StringTooLong String
build n acc = case predUInt32 n of
  Left _ -> Right acc
  Right m -> bindEither (acc ++ acc) (\doubled -> build m doubled)

{- The program-level outcome:
   - `OK` if `build 20 block` returns `Right s` with
     `lengthUtf16CodeUnits s == maxStringLengthUtf16CodeUnits` AND
     `s ++ "!"` returns `Left StringTooLong`.
   - Otherwise a labelled `FAIL` so a regression points at the broken
     branch. Cross-backend stdout assertion catches per-target
     divergence. -}
runTest : String
runTest = case build 20 block of
  Left _ -> "FAIL: build returned Left at the cap"
  Right capStr -> case eqUInt32 (lengthUtf16CodeUnits capStr) maxStringLengthUtf16CodeUnits of
    False -> "FAIL: built string length is not at cap"
    True -> case capStr ++ "!" of
      Right _ -> "FAIL: cap + 1 returned Right"
      Left _ -> "OK"

main : Either (StringTooLong | UnpairedUtf16Surrogate) String -> IO Never Unit
main _input = IO.Stdout.print runTest
