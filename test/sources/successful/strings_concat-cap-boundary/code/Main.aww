{- Exercises the runtime cap-check inside `(++)`. Builds a string of
   exactly `maxStringLengthUtf16CodeUnits` UTF-16 code units via 20
   doublings of a 128-CJK-code-unit literal (128 * 2^20 = 134_217_728
   = cap), confirms the result lands on `Right` with a length equal to
   the constant, then attempts one more `++ "!"` and confirms the cap
   pushes that one over to `Left StringTooLong`. Prints `OK`. -}

import IO.Stdout

block : String
block = "你好世界你好世界你好世界你好世界你好世界你好世界你好世界你好世界你好世界你好世界你好世界你好世界你好世界你好世界你好世界你好世界你好世界你好世界你好世界你好世界你好世界你好世界你好世界你好世界你好世界你好世界你好世界你好世界你好世界你好世界你好世界你好世界"

{- Doubles `acc` `n` times via `acc ++ acc`. Threading through
   `andThenEither` propagates a `Left StringTooLong` from any
   intermediate `(++)` overflow. With `n = 20` and a 128-code-unit
   block the result is exactly `cap`. -}

build : UInt32 -> String -> Either StringTooLong String
build n acc = case predUInt32 n of
  Left _ -> Right acc
  Right m -> acc ++ acc |> andThenEither (\doubled -> build m doubled)

{- The program-level outcome:
   - `OK` if `build 20 block` returns `Right s` with
     `lengthUtf16CodeUnits s == maxStringLengthUtf16CodeUnits` AND
     `s ++ "!"` returns `Left StringTooLong`.
   - Otherwise a labelled `FAIL` so a regression points at the broken
     branch. -}

runTest : String
runTest = case build 20 block of
  Left _ -> "FAIL: build returned Left at the cap"
  Right capStr -> case eqUInt32 (lengthUtf16CodeUnits capStr) maxStringLengthUtf16CodeUnits of
    False -> "FAIL: built string length is not at cap"
    True -> case capStr ++ "!" of
      Right _ -> "FAIL: cap + 1 returned Right"
      Left _ -> "OK"

main : IO Never Unit
main = IO.Stdout.print runTest
