{- Mutual tail recursion with mismatched arities at depth 100_000;
   SCC's sum-typed args merge folds the cluster into a loop. -}
import IO.Stdout

pingOne : Int32 -> Either UnderflowError Int32
pingOne n = case eqInt32 n 0 of
  True -> Right 0
  False -> case predInt32 n of
    Left e -> Left e
    Right m -> pongTwo m 0

pongTwo : Int32 -> Int32 -> Either UnderflowError Int32
pongTwo n _acc = case eqInt32 n 0 of
  True -> Right 0
  False -> case predInt32 n of
    Left e -> Left e
    Right m -> pingOne m

showResult : Either UnderflowError Int32 -> String
showResult r = case r of
  Left e -> "left: " ++ showUnderflowError e
  Right v -> "right: " ++ showInt32 v

main : String -> IO Unit
main _input = IO.Stdout.print (showResult (pingOne 100000))
