{- Mutual tail recursion between two functions of different arities, at
   depth 100_000. Runs in bounded stack on every backend. -}

import IO.Stdout

pingOne : Int32 -> Either UnderflowError Int32
pingOne n = case eqInt32 n 0 of
  True -> Right 0
  False -> case predInt32 n of
    Left e -> Left e
    Right m -> pongTwo m 0

pongTwo : Int32 -> Int32 -> Either UnderflowError Int32
pongTwo n _acc = case eqInt32 n 0 of
  True -> Right 0
  False -> case predInt32 n of
    Left e -> Left e
    Right m -> pingOne m

showResult : Either UnderflowError Int32 -> Either StringTooLong String
showResult r = case r of
  Left e -> "left: " ++ showUnderflowError e
  Right v -> "right: " ++ showInt32 v

res : Either StringTooLong String
res = showResult (pingOne 100_000)

main : IO Never Unit
main = eitherToIO res
  |> andThenIO IO.Stdout.print
  |> handleErrorIO onError

onError : StringTooLong -> IO Never Unit
onError e = case e of
  StringTooLong -> IO.Stdout.print "STRING_TOO_LONG"
