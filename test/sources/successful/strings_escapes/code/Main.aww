{- Cross-backend snapshot test for the parser's string-literal escape
   sequences. All six escapes (see 'Awsum.Parser') are exercised here
   verbatim — `\n \t \r \" \\ \0`.

   Identical stdout bytes on every backend confirm both the parser's
   escape handling and the runtime's "print exactly" semantics; the
   no-stdin snapshot pins the exact byte sequence (including CR / LF /
   TAB / NUL characters that look unusual in text editors). The NUL
   case in particular verifies that strings are length-prefixed end-to-
   end on every backend — including LLVM and WASM, which moved off
   C-style null-terminated layout. -}
import IO.Stdout

main : IO Never Unit
main = IO.Stdout.print "BS=\\ DQ=\" CR=\r LF=\n TAB=\t NUL=\0 end"
