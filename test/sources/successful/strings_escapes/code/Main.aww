{- Exercises the parser's string-literal escape sequences —
   `\n \t \r \" \\ \0` — and prints them verbatim, so the exact bytes
   (including CR / LF / TAB / NUL) are checked. The NUL case confirms a
   NUL stays one byte inside a string rather than terminating it.

   `\0` appears twice, once before a digit (`\07`), to confirm a NUL
   adjacent to a digit stays one NUL byte. -}

import IO.Stdout

main : IO Never Unit
main = IO.Stdout.print "BS=\\ DQ=\" CR=\r LF=\n TAB=\t NUL=\0 NUL7=\07 end"
