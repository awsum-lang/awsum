{- Same row-tag-dispatch invariant as `rows_synth-app-ctor`, but the
   non-nullary constructor application reaches the case-binder through
   a `let`. `let m = Just "world"` requires `synthLabelType` on the
   RHS to resolve to `Maybe String`, which writes that into the
   binder's type entry and lets the inner `case m of Just x -> …`
   recover `x : String`.

   Without the EApp synth fix, `m`'s type would fall back to the
   `_letBind` placeholder, the inner case-binder `x` would type at
   `TyVar "a"`, and `dispatch x` would dispatch against the first
   row label (`Int32`) regardless of `x`'s actual runtime type. -}
import IO.Stdout

dispatch : (Int32 | String) -> String
dispatch x = case x of
  (_n : Int32) -> "i"
  (_s : String) -> "s"

main : IO Never Unit
main =
  let m = Just "world"
   in case m of
        Nothing -> IO.Stdout.print "n"
        Just x -> IO.Stdout.print (dispatch x)
