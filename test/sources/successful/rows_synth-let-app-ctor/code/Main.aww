{- A case-binder destructured from a non-nullary constructor that reaches
   the case through a `let` (`let m = Just "world"`), then dispatched into
   a row `(Int32 | String)`. `m` holds `Just "world"`, so `x : String` and
   `dispatch x` takes the `String` alternative — it prints `s`. -}

import IO.Stdout

dispatch : (Int32 | String) -> String
dispatch x = case x of
  (_n : Int32) -> "i"
  (_s : String) -> "s"

main : IO Never Unit
main =
  let m = Just "world"
   in case m of
        Nothing -> IO.Stdout.print "n"
        Just x -> IO.Stdout.print (dispatch x)
