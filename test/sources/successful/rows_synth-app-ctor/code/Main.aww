{- A case-binder destructured from a non-nullary constructor (`Just x`)
   then dispatched into a multi-alternative row `(Int32 | String)`. The
   scrutinee is `Just "hello"`, so `x : String` and `dispatch x` takes the
   `String` alternative — it prints `s`. -}

import IO.Stdout

dispatch : (Int32 | String) -> String
dispatch x = case x of
  (_n : Int32) -> "i"
  (_s : String) -> "s"

main : IO Never Unit
main = case Just "hello" of
  Nothing -> IO.Stdout.print "n"
  Just x -> IO.Stdout.print (dispatch x)
