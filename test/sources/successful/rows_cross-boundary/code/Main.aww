{- Non-row values flow into row-typed slots; lift helpers must reconstruct
   under the target row shape. Three shapes: direct nominal wrap, recursive
   ADT (memoised), deep nesting through `Either`/`Maybe`. -}

import IO.Stdout

type ErrA = ErrA

type Lst a = Nil | Cons a (Lst a)

defaultJust : Maybe Bool
defaultJust = Just True

defaultBools : Lst Bool
defaultBools = Cons True (Cons False Nil)

defaultRight : Either ErrA (Maybe Bool)
defaultRight = Right (Just False)

dispatchInner : (Bool | Unit) -> String
dispatchInner x = case x of
  (b : Bool) -> case b of
    True -> "T"
    False -> "F"
  (u : Unit) -> showUnit u

describeMaybe : Maybe (Bool | Unit) -> Either StringTooLong String
describeMaybe m = case m of
  Nothing -> Right "N"
  Just inner -> "J" ++ dispatchInner inner

describeLst : Lst (Bool | Unit) -> Either StringTooLong String
describeLst xs = case xs of
  Nil -> Right ""
  Cons h t -> do
    rest <- describeLst t
    dispatchInner h ++ rest

describeEither : Either ErrA (Maybe (Bool | Unit)) -> Either StringTooLong String
describeEither r = case r of
  Left _e -> Right "ErrA"
  Right m -> describeMaybe m

summary : Either StringTooLong String
summary = do
  a <- describeMaybe defaultJust
  b <- describeLst defaultBools
  c <- describeEither defaultRight
  s0 <- a ++ " / "
  s1 <- s0 ++ b
  s2 <- s1 ++ " / "
  s2 ++ c

main : IO Never Unit
main =
  let res : Either StringTooLong String = summary
   in case res of
        Left _ -> IO.Stdout.print "STRING_TOO_LONG"
        Right s -> IO.Stdout.print s
