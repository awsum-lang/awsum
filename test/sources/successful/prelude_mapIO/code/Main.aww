{- `mapIO` rewrites the success value of an IO action, composed with
   `bindIO` whose continuation is the platform built-in `IO.Stdout.print`
   passed as a value. Prints `after`. -}

import IO.Stdout

source : IO Never String
source = pureIO "before"

main : IO Never Unit
main = bindIO (mapIO source (\_s -> "after")) IO.Stdout.print
