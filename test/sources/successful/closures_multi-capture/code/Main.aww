{- Closure capturing two outer parameters at once. -}

import IO.Stdout

apply : (a -> b) -> a -> b
apply f x = f x

zero : Int32
zero = 0

both : Int32 -> Int32 -> Either StringTooLong String
both a b = apply (\_n -> bothBody a b) zero

bothBody : Int32 -> Int32 -> Either StringTooLong String
bothBody a b = do
  s0 <- showInt32 a ++ "/"
  s0 ++ showInt32 b

res : Either StringTooLong String
res = both 11 22

main : IO Never Unit
main = eitherToIO res
  |> andThenIO IO.Stdout.print
  |> handleErrorIO onError

onError : StringTooLong -> IO Never Unit
onError e = case e of
  StringTooLong -> IO.Stdout.print "STRING_TOO_LONG"
