{- Closure capturing two outer parameters at once. -}
import IO.Stdout

apply : (a -> b) -> a -> b
apply f x = f x

zero : Int32
zero = 0

both : Int32 -> Int32 -> Either StringTooLong String
both a b = apply (\_n -> bothBody a b) zero

bothBody : Int32 -> Int32 -> Either StringTooLong String
bothBody a b = do
  s0 <- showInt32 a ++ "/"
  s0 ++ showInt32 b

main : Either (StringTooLong | UnpairedUtf16Surrogate) String -> IO Unit
main _input =
  let res : Either StringTooLong String = both 11 22
   in case res of
        Left _ -> IO.Stdout.print "STRING_TOO_LONG"
        Right s -> IO.Stdout.print s
