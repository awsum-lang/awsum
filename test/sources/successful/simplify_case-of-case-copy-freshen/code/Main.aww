{- Inlining a function whose body is a `case` (`inner`) into another's
   scrutinee position makes a `case`-of-`case`, which the compiler fuses.
   The `MkA` arm shares a binding (from `dup`'s doubled argument) that must
   be freshened when the arm is copied. `run True 3` builds `Tuple2 7 7`
   (sum 14); `run False 4` builds `Tuple2 4 4` (sum 8). Prints `148`. -}

import IO.Stdout

type T = MkA | MkB

{- Recursive, so never inlined. -}
g : Int32 -> Int32
g n = case eqInt32 n 0 of
  True -> 7
  False -> case subInt32 n 1 of
    Left _e -> 7
    Right m -> g m

{- Recursive, so never inlined; returns MkA on one path so that arm stays live. -}
mk2 : Int32 -> T
mk2 n = case eqInt32 n 0 of
  True -> MkB
  False -> case subInt32 n 1 of
    Left _e -> MkA
    Right m -> mk2 m

{- Small, so inlines; its parameter is used twice. -}
dup : Int32 -> Tuple2 Int32 Int32
dup n = Tuple2 n n

{- Small, so inlines; its body is a case. -}
inner : Bool -> Int32 -> T
inner b x = case b of
  True -> MkA
  False -> mk2 x

run : Bool -> Int32 -> Tuple2 Int32 Int32
run b x = case inner b x of
  MkA -> dup (g x)
  MkB -> Tuple2 x x

sumPair : Tuple2 Int32 Int32 -> Int32
sumPair (Tuple2 a b) = case addInt32 a b of
  Left _e -> 0
  Right s -> s

main : IO Never Unit
main = IO.Stdout.print (showInt32 (sumPair (run True 3))) |> andThenIO (\_u -> IO.Stdout.print (showInt32 (sumPair (run False 4))))
