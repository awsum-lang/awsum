{- A function whose result row is partially concrete with an open tail —
   `Either (EZ | e) Int32` — used where the row is widened by two further
   labels (`Either (EA | EB | EZ) Int32`). The tail variable `e` occurs
   only in the result, so it is a genuinely-polymorphic output tail. The
   body injects `EZ`, so it prints `Z`. -}

import IO.Stdout

type EA = EA

type EB = EB

type EZ = EZ

zeroOr : Int32 -> Either (EZ | e) Int32
zeroOr _n = Left EZ

called : Either (EA | EB | EZ) Int32
called = zeroOr 9

describe : Either (EA | EB | EZ) Int32 -> String
describe r = case r of
  Left (_a : EA) -> "A"
  Left (_b : EB) -> "B"
  Left (_z : EZ) -> "Z"
  Right v -> showInt32 v

main : IO Never Unit
main = IO.Stdout.print (describe called)
