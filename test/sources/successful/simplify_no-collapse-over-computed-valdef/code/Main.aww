{- A `case` over a top-level value whose field carries computation
   (`lengthUtf8Bytes`, which doesn't constant-fold): the compiler declines to
   collapse it, since substituting the field would re-run the computation. The
   case stays. Prints `3`. -}

import IO.Stdout

computed : Maybe UInt32
computed = Just (lengthUtf8Bytes "abc")

main : IO Never Unit
main = IO.Stdout.print (case computed of
  Nothing -> "nothing"
  Just n -> showUInt32 n
)
