-- Test: `predInt32` returns `Right (x - 1)` on ordinary values and
-- `Left UnderflowError` on `minInt32`. The case-of unwraps both arms
-- to `String` so the result can be printed through the same
-- `IO.Stdout.print` path on every backend.
import IO.Stdout

render : Either UnderflowError Int32 -> String
render r = case r of
  Left e -> "underflow: " ++ showUnderflowError e
  Right v -> "ok: " ++ showInt32 v

minInt32 : Int32
minInt32 = -2147483648

ordinary : Int32
ordinary = 42

main : String -> IOUnit
main _input = IO.Stdout.print (render (predInt32 ordinary) ++ ", " ++ render (predInt32 minInt32))
