{- A text buffer on a finger tree measured by line and UTF-16 offset counts.
   The argument is `line/line/...;command;command`; the commands navigate
   between lines and offsets, insert, delete, and paste the whole buffer onto
   itself. Prints every command's answer, comma-separated. -}

import IO.Stdout
import IO.Args

type Digit a
  = One a
  | Two a a
  | Three a a a
  | Four a a a a

type Node v a = Node2 v a a | Node3 v a a a

type FingerTree v a
  = Empty
  | Single a
  | Deep v (Digit a) (FingerTree v (Node v a)) (Digit a)

type Measure v a = Measure (a -> v) (v -> v -> v) v

type Split f a = Split f a f

measure : Measure v a -> a -> v
measure (Measure f _ _) x = f x

combine : Measure v a -> v -> v -> v
combine (Measure _ c _) x y = c x y

unit : Measure v a -> v
unit (Measure _ _ u) = u

nodeValue : Node v a -> v
nodeValue n = case n of
  Node2 v _ _ -> v
  Node3 v _ _ _ -> v

atNodes : Measure v a -> Measure v (Node v a)
atNodes (Measure _ c u) = Measure nodeValue c u

node2 : Measure v a -> a -> a -> Node v a
node2 m x y = Node2 (combine m (measure m x) (measure m y)) x y

node3 : Measure v a -> a -> a -> a -> Node v a
node3 m x y z = Node3 (combine m (combine m (measure m x) (measure m y)) (measure m z)) x y z

measureDigit : Measure v a -> Digit a -> v
measureDigit m digit = case digit of
  One a -> measure m a
  Two a b -> combine m (measure m a) (measure m b)
  Three a b c -> combine m (measure m a) (combine m (measure m b) (measure m c))
  Four a b c d -> combine m (measure m a) (combine m (measure m b) (combine m (measure m c) (measure m d)))

measureTree : Measure v a -> FingerTree v a -> v
measureTree m t = case t of
  Empty -> unit m
  Single x -> measure m x
  Deep v _ _ _ -> v

deep : Measure v a -> Digit a -> FingerTree v (Node v a) -> Digit a -> FingerTree v a
deep m pr mid sf = Deep (combine m (measureDigit m pr) (combine m (measureTree (atNodes m) mid) (measureDigit m sf))) pr mid sf

cons : Measure v a -> a -> FingerTree v a -> FingerTree v a
cons m x t = case t of
  Empty -> Single x
  Single y -> deep m (One x) Empty (One y)
  Deep _ (One a) mid sf -> deep m (Two x a) mid sf
  Deep _ (Two a b) mid sf -> deep m (Three x a b) mid sf
  Deep _ (Three a b c) mid sf -> deep m (Four x a b c) mid sf
  Deep _ (Four a b c d) mid sf -> deep m (Two x a) (cons (atNodes m) (node3 m b c d) mid) sf

snoc : Measure v a -> FingerTree v a -> a -> FingerTree v a
snoc m t x = case t of
  Empty -> Single x
  Single y -> deep m (One y) Empty (One x)
  Deep _ pr mid (One a) -> deep m pr mid (Two a x)
  Deep _ pr mid (Two a b) -> deep m pr mid (Three a b x)
  Deep _ pr mid (Three a b c) -> deep m pr mid (Four a b c x)
  Deep _ pr mid (Four a b c d) -> deep m pr (snoc (atNodes m) mid (node3 m a b c)) (Two d x)

consAll : Measure v a -> List a -> FingerTree v a -> FingerTree v a
consAll m xs t = case xs of
  Nil -> t
  Cons x rest -> cons m x (consAll m rest t)

snocAll : Measure v a -> FingerTree v a -> List a -> FingerTree v a
snocAll m t xs = case xs of
  Nil -> t
  Cons x rest -> snocAll m (snoc m t x) rest

nodeDigit : Node v a -> Digit a
nodeDigit n = case n of
  Node2 _ a b -> Two a b
  Node3 _ a b c -> Three a b c

digitTree : Measure v a -> Digit a -> FingerTree v a
digitTree m digit = case digit of
  One a -> Single a
  Two a b -> deep m (One a) Empty (One b)
  Three a b c -> deep m (Two a b) Empty (One c)
  Four a b c d -> deep m (Two a b) Empty (Two c d)

partTree : Measure v a -> Maybe (Digit a) -> FingerTree v a
partTree m part = case part of
  Nothing -> Empty
  Just digit -> digitTree m digit

viewFront : Measure v a -> FingerTree v a -> Maybe (Tuple2 a (FingerTree v a))
viewFront m t = case t of
  Empty -> Nothing
  Single x -> Just (Tuple2 x Empty)
  Deep _ (One a) mid sf -> Just (Tuple2 a (deepL m Nothing mid sf))
  Deep _ (Two a b) mid sf -> Just (Tuple2 a (deep m (One b) mid sf))
  Deep _ (Three a b c) mid sf -> Just (Tuple2 a (deep m (Two b c) mid sf))
  Deep _ (Four a b c d) mid sf -> Just (Tuple2 a (deep m (Three b c d) mid sf))

viewBack : Measure v a -> FingerTree v a -> Maybe (Tuple2 (FingerTree v a) a)
viewBack m t = case t of
  Empty -> Nothing
  Single x -> Just (Tuple2 Empty x)
  Deep _ pr mid (One a) -> Just (Tuple2 (deepR m pr mid Nothing) a)
  Deep _ pr mid (Two a b) -> Just (Tuple2 (deep m pr mid (One a)) b)
  Deep _ pr mid (Three a b c) -> Just (Tuple2 (deep m pr mid (Two a b)) c)
  Deep _ pr mid (Four a b c d) -> Just (Tuple2 (deep m pr mid (Three a b c)) d)

deepL : Measure v a -> Maybe (Digit a) -> FingerTree v (Node v a) -> Digit a -> FingerTree v a
deepL m part mid sf = case part of
  Just pr -> deep m pr mid sf
  Nothing -> case viewFront (atNodes m) mid of
    Nothing -> digitTree m sf
    Just (Tuple2 n rest) -> deep m (nodeDigit n) rest sf

deepR : Measure v a -> Digit a -> FingerTree v (Node v a) -> Maybe (Digit a) -> FingerTree v a
deepR m pr mid part = case part of
  Just sf -> deep m pr mid sf
  Nothing -> case viewBack (atNodes m) mid of
    Nothing -> digitTree m pr
    Just (Tuple2 rest n) -> deep m pr rest (nodeDigit n)

digitFirst : Digit a -> Tuple2 a (List a)
digitFirst digit = case digit of
  One a -> Tuple2 a Nil
  Two a b -> Tuple2 a (Cons b Nil)
  Three a b c -> Tuple2 a (Cons b (Cons c Nil))
  Four a b c d -> Tuple2 a (Cons b (Cons c (Cons d Nil)))

digitLast : Digit a -> Tuple2 (List a) a
digitLast digit = case digit of
  One a -> Tuple2 Nil a
  Two a b -> Tuple2 (Cons a Nil) b
  Three a b c -> Tuple2 (Cons a (Cons b Nil)) c
  Four a b c d -> Tuple2 (Cons a (Cons b (Cons c Nil))) d

appendList : List a -> List a -> List a
appendList xs ys = case xs of
  Nil -> ys
  Cons x rest -> Cons x (appendList rest ys)

nodes : Measure v a -> a -> List a -> a -> List (Node v a)
nodes m start inner end = case inner of
  Nil -> Cons (node2 m start end) Nil
  Cons a Nil -> Cons (node3 m start a end) Nil
  Cons a (Cons b Nil) -> Cons (node2 m start a) (Cons (node2 m b end) Nil)
  Cons a (Cons b (Cons c more)) -> Cons (node3 m start a b) (nodes m c more end)

glue : Measure v a -> Digit a -> List a -> Digit a -> List (Node v a)
glue m sf between pr = case digitFirst sf of
  Tuple2 start afterStart -> case digitLast pr of
    Tuple2 beforeEnd end -> nodes m start (appendList afterStart (appendList between beforeEnd)) end

app3 : Measure v a -> FingerTree v a -> List a -> FingerTree v a -> FingerTree v a
app3 m l between r = case l of
  Empty -> consAll m between r
  Single x -> cons m x (consAll m between r)
  Deep _ pr1 mid1 sf1 -> case r of
    Empty -> snocAll m l between
    Single y -> snoc m (snocAll m l between) y
    Deep _ pr2 mid2 sf2 -> deep m pr1 (app3 (atNodes m) mid1 (glue m sf1 between pr2) mid2) sf2

splitDigit : Measure v a -> (v -> Bool) -> v -> Digit a -> Split (Maybe (Digit a)) a
splitDigit m p acc digit = case digit of
  One a -> Split Nothing a Nothing
  Two a b -> case p (combine m acc (measure m a)) of
    True -> Split Nothing a (Just (One b))
    False -> Split (Just (One a)) b Nothing
  Three a b c -> let va = combine m acc (measure m a)
   in case p va of
        True -> Split Nothing a (Just (Two b c))
        False -> case p (combine m va (measure m b)) of
          True -> Split (Just (One a)) b (Just (One c))
          False -> Split (Just (Two a b)) c Nothing
  Four a b c d -> let va = combine m acc (measure m a)
   in case p va of
        True -> Split Nothing a (Just (Three b c d))
        False -> let vb = combine m va (measure m b)
         in case p vb of
              True -> Split (Just (One a)) b (Just (Two c d))
              False -> case p (combine m vb (measure m c)) of
                True -> Split (Just (Two a b)) c (Just (One d))
                False -> Split (Just (Three a b c)) d Nothing

splitTree : Measure v a -> (v -> Bool) -> v -> FingerTree v a -> Maybe (Split (FingerTree v a) a)
splitTree m p acc t = case t of
  Empty -> Nothing
  Single x -> Just (Split Empty x Empty)
  Deep _ pr mid sf -> let vpr = combine m acc (measureDigit m pr)
   in case p vpr of
        True -> case splitDigit m p acc pr of
          Split l x r -> Just (Split (partTree m l) x (deepL m r mid sf))
        False -> let vmid = combine m vpr (measureTree (atNodes m) mid)
         in case p vmid of
              False -> case splitDigit m p vmid sf of
                Split l x r -> Just (Split (deepR m pr mid l) x (partTree m r))
              True -> case splitTree (atNodes m) p vpr mid of
                Nothing -> Nothing
                Just (Split ml n mr) -> let vml = combine m vpr (measureTree (atNodes m) ml)
                 in case splitDigit m p vml (nodeDigit n) of
                      Split l x r -> Just (Split (deepR m pr ml l) x (deepL m r mr sf))

foldDigit : (a -> r -> r) -> Digit a -> r -> r
foldDigit f digit acc = case digit of
  One a -> f a acc
  Two a b -> f a (f b acc)
  Three a b c -> f a (f b (f c acc))
  Four a b c d -> f a (f b (f c (f d acc)))

foldNode : (a -> r -> r) -> Node v a -> r -> r
foldNode f n acc = foldDigit f (nodeDigit n) acc

foldTree : (a -> r -> r) -> FingerTree v a -> r -> r
foldTree f t acc = case t of
  Empty -> acc
  Single x -> f x acc
  Deep _ pr mid sf -> foldDigit f pr (foldTree (foldNode f) mid (foldDigit f sf acc))

type Stats = Stats UInt32 UInt32

saturatingAdd : UInt32 -> UInt32 -> UInt32
saturatingAdd x y = case addUInt32 x y of
  Left _ -> maxUInt32
  Right z -> z

addStats : Stats -> Stats -> Stats
addStats (Stats l1 c1) (Stats l2 c2) = Stats (saturatingAdd l1 l2) (saturatingAdd c1 c2)

lineStats : String -> Stats
lineStats text = Stats 1 (saturatingAdd (lengthUtf16CodeUnits text) 1)

noStats : Stats
noStats = Stats 0 0

lineMeasure : Measure Stats String
lineMeasure = Measure lineStats addStats noStats

linesOf : Stats -> UInt32
linesOf (Stats ls _) = ls

unitsOf : Stats -> UInt32
unitsOf (Stats _ cs) = cs

isBelow : UInt32 -> UInt32 -> Bool
isBelow x y = case subUInt32 x y of
  Left _ -> True
  Right _ -> False

pastLine : UInt32 -> Stats -> Bool
pastLine i s = isBelow i (linesOf s)

pastUnit : UInt32 -> Stats -> Bool
pastUnit c s = isBelow c (unitsOf s)

splitBuffer : (Stats -> Bool) -> FingerTree Stats String -> Maybe (Split (FingerTree Stats String) String)
splitBuffer p doc = case p (measureTree lineMeasure doc) of
  False -> Nothing
  True -> splitTree lineMeasure p noStats doc

statsBefore : (Stats -> Bool) -> FingerTree Stats String -> Maybe Stats
statsBefore p doc = case splitBuffer p doc of
  Nothing -> Nothing
  Just (Split before _ _) -> Just (measureTree lineMeasure before)

insertLine : UInt32 -> String -> FingerTree Stats String -> Maybe (FingerTree Stats String)
insertLine i text doc = case splitBuffer (pastLine i) doc of
  Just (Split before x after) -> Just (app3 lineMeasure before (Cons text (Cons x Nil)) after)
  Nothing -> case eqUInt32 i (linesOf (measureTree lineMeasure doc)) of
    True -> Just (snoc lineMeasure doc text)
    False -> Nothing

deleteLine : UInt32 -> FingerTree Stats String -> Maybe (FingerTree Stats String)
deleteLine i doc = case splitBuffer (pastLine i) doc of
  Nothing -> Nothing
  Just (Split before _ after) -> Just (app3 lineMeasure before Nil after)

joinOnto : String -> List String -> Either StringTooLong String
joinOnto acc ls = case ls of
  Nil -> Right acc
  Cons line rest -> do
    withSlash <- acc ++ "/"
    next <- withSlash ++ line
    joinOnto next rest

render : FingerTree Stats String -> Either StringTooLong String
render doc = case foldTree Cons doc Nil of
  Nil -> Right ""
  Cons line rest -> joinOnto line rest

splitAll : String -> String -> List String
splitAll sep src = case splitOnFirst sep src of
  Nothing -> Cons src Nil
  Just (Tuple2 piece rest) -> Cons piece (splitAll sep rest)

type MissingScript = MissingScript

type NoSuchLine = NoSuchLine

type BadCommand = BadCommand

type Outcome = Edited (FingerTree Stats String) | Answer String

answerFrom : (UInt32 -> FingerTree Stats String -> Maybe Stats) -> (Stats -> UInt32) -> String -> FingerTree Stats String -> Either (ParseError | NoSuchLine) Outcome
answerFrom locate project arg doc = do
  n <- parseUInt32 arg
  s <- nothingAsLeft NoSuchLine (locate n doc)
  pureEither (Answer (showUInt32 (project s)))

byLine : UInt32 -> FingerTree Stats String -> Maybe Stats
byLine i doc = statsBefore (pastLine i) doc

byUnit : UInt32 -> FingerTree Stats String -> Maybe Stats
byUnit c doc = statsBefore (pastUnit c) doc

performIns : String -> FingerTree Stats String -> Either (BadCommand | ParseError | NoSuchLine) Outcome
performIns arg doc = do
  Tuple2 numArg text <- nothingAsLeft BadCommand (splitOnFirst " " arg)
  i <- parseUInt32 numArg
  edited <- nothingAsLeft NoSuchLine (insertLine i text doc)
  pureEither (Edited edited)

performDel : String -> FingerTree Stats String -> Either (ParseError | NoSuchLine) Outcome
performDel arg doc = do
  i <- parseUInt32 arg
  edited <- nothingAsLeft NoSuchLine (deleteLine i doc)
  pureEither (Edited edited)

performWith : String -> String -> FingerTree Stats String -> Either (BadCommand | ParseError | NoSuchLine) Outcome
performWith verb arg doc = case eqString verb "offset" of
  True -> answerFrom byLine unitsOf arg doc
  False -> case eqString verb "line" of
    True -> answerFrom byUnit linesOf arg doc
    False -> case eqString verb "ins" of
      True -> performIns arg doc
      False -> case eqString verb "del" of
        True -> performDel arg doc
        False -> Left BadCommand

perform : String -> FingerTree Stats String -> Either (BadCommand | ParseError | NoSuchLine | StringTooLong) Outcome
perform cmd doc = case splitOnFirst " " cmd of
  Just (Tuple2 verb arg) -> performWith verb arg doc
  Nothing -> case eqString cmd "dup" of
    True -> Right (Edited (app3 lineMeasure doc Nil doc))
    False -> case eqString cmd "show" of
      True -> mapRight (render doc) Answer
      False -> Left BadCommand

appendAnswer : String -> String -> Either StringTooLong String
appendAnswer out answer = case eqString out "" of
  True -> Right answer
  False -> do
    withComma <- out ++ ","
    withComma ++ answer

runAll : FingerTree Stats String -> List String -> String -> Either (BadCommand | ParseError | NoSuchLine | StringTooLong) String
runAll doc cmds out = case cmds of
  Nil -> Right out
  Cons cmd rest -> do
    outcome <- perform cmd doc
    (case outcome of
      Edited edited -> runAll edited rest out
      Answer answer -> do
        next <- appendAnswer out answer
        runAll doc rest next
    )

compute : List String -> Either (MissingScript | BadCommand | ParseError | NoSuchLine | StringTooLong) String
compute args = case headList args of
  Nothing -> Left MissingScript
  Just arg -> case splitOnFirst ";" arg of
    Nothing -> Left MissingScript
    Just (Tuple2 docSrc script) -> runAll (snocAll lineMeasure Empty (splitAll "/" docSrc)) (splitAll ";" script) ""

onError : (StringTooLong | UnpairedUtf16Surrogate | MissingScript | BadCommand | ParseError | NoSuchLine) -> IO Never Unit
onError e = case e of
  StringTooLong -> IO.Stdout.print "STRING_TOO_LONG"
  UnpairedUtf16Surrogate -> IO.Stdout.print "UNPAIRED_UTF16_SURROGATE"
  MissingScript -> IO.Stdout.print "MISSING_SCRIPT"
  BadCommand -> IO.Stdout.print "BAD_COMMAND"
  ParseError -> IO.Stdout.print "PARSE_ERROR"
  NoSuchLine -> IO.Stdout.print "NO_SUCH_LINE"

main : IO Never Unit
main = IO.Args.getArgs
  |> andThenIO (\args -> eitherToIO (compute args))
  |> andThenIO IO.Stdout.print
  |> handleErrorIO onError
