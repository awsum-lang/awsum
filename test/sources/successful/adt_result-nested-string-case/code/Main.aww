{- Nested monomorphic Result; sequential case-of (no nested patterns). -}
import IO.Stdout

type Result a e = Ok a | Err e

unwrap : Result (Result String String) (Result String String) -> String
unwrap r = case r of
  Ok r2 -> case r2 of
    Ok value -> value
    Err value -> value
  Err r2 -> case r2 of
    Ok value -> value
    Err value -> value

main : Either (StringTooLong | UnpairedUtf16Surrogate) String -> IO Never Unit
main _input =
  let res : Either StringTooLong String = do
        s0 <- unwrap (Ok (Ok "1")) ++ ","
        s1 <- s0 ++ unwrap (Ok (Err "2"))
        s2 <- s1 ++ ","
        s3 <- s2 ++ unwrap (Err (Ok "3"))
        s4 <- s3 ++ ","
        s4 ++ unwrap (Err (Err "4"))
   in case res of
        Left _ -> IO.Stdout.print "STRING_TOO_LONG"
        Right s -> IO.Stdout.print s
