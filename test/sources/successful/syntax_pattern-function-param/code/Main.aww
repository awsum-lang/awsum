-- Pattern on a function parameter: `f (Tuple3 a b c) = body`
-- destructures the argument in the parameter binding itself.
-- Awsum.Desugar rewrites every `ParamPat` parameter to a fresh
-- 'Param' plus a single-arm `case` wrapping the body:
--
--     f (Tuple3 a b c) = body
--   ⇝ f $arg_<sp> = case $arg_<sp> of Tuple3 a b c -> body
--
-- Same rewrite for lambda parameters: `\(Just x) -> e` becomes
-- `\$arg -> case $arg of Just x -> e`. The synthetic name uses
-- the parameter's source span so multiple destructuring params
-- in the same function don't collide.
--
-- Parens are syntactically required at the parameter position to
-- distinguish a destructuring pattern from a sequence of bare
-- names — `f Tuple3 a b c` would mean four parameters, not one
-- pattern with three fields.
import IO.Stdout

sumTriple : Tuple3 Int32 Int32 Int32 -> Int32
sumTriple (Tuple3 a b c) = case addInt32 a b of
  Left _ -> 0
  Right ab -> case addInt32 ab c of
    Left _ -> 0
    Right abc -> abc

apply : (Tuple2 Int32 Int32 -> Int32) -> Tuple2 Int32 Int32 -> Int32
apply f t = f t

sumPair : Tuple2 Int32 Int32 -> Int32
sumPair (Tuple2 a b) = case addInt32 a b of
  Left _ -> 0
  Right s -> s

triple : Tuple3 Int32 Int32 Int32
triple = Tuple3 10 20 30

pair : Tuple2 Int32 Int32
pair = Tuple2 100 200

main : String -> IO Unit
main _input =
  let n = sumTriple triple
      m = apply (\(Tuple2 a b) -> sumPair (Tuple2 a b)) pair
   in IO.Stdout.print (showInt32 n ++ " / " ++ showInt32 m)
