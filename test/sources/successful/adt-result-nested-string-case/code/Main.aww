-- Test: nested monomorphic Result with sequential case expressions (not flat)
import IO.Stdout

type Result a e = Ok a | Err e

unwrap : Result (Result String String) (Result String String) -> String
unwrap r = case r of
  Ok r2 -> case r2 of
    Ok value -> value
    Err value -> value
  Err r2 -> case r2 of
    Ok value -> value
    Err value -> value

main : String -> IOUnit
main _input = IO.Stdout.print (unwrap (Ok (Ok "1")) ++ "," ++ unwrap (Ok (Err "2")) ++ "," ++ unwrap (Err (Ok "3")) ++ "," ++ unwrap (Err (Err "4")))
