{- Error-row widening on the IO side: `failIO E1 : IO E1 a` flows into
   `IO (E1 | E2) Unit`, then a handler dispatches on the row. Prints
   `h-E1`. -}

import IO.Stdout

type E1 = E1

type E2 = E2

act : IO (E1 | E2) Unit
act = failIO E1

onError : (E1 | E2) -> IO Never Unit
onError e = case e of
  E1 -> IO.Stdout.print "h-E1"
  E2 -> IO.Stdout.print "h-E2"

main : IO Never Unit
main = act |> handleErrorIO onError
