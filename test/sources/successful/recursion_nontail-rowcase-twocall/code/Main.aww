{- Two non-tail self-calls in a single expression under a structural-sum (row)
   case arm, at depth 200_000. `addInt32 (sumTree l) (sumTree r)` buries two
   non-tail self-calls inside the `(n : Int32)` and `(_s : String)` arms of a
   `case` on the node's `(Int32 | String)` value. `Awsum.Cps` allocates one K
   per call and a later K's apply tail-calls `$cps$sumTree`, so `$cps$` and
   `$apply$` end up mutually recursive and the second `Scc`-merge fuses them —
   all reached only because `goTail` now descends into the row-case arm. A
   deep left-spine tree forces bounded stack on every backend. -}

import IO.Stdout

type Tree = Leaf | Node Tree (Int32 | String) Tree

buildLeft : Int32 -> Tree -> Tree
buildLeft n acc = case eqInt32 n 0 of
  True -> acc
  False -> case predInt32 n of
    Left _e -> acc
    Right m -> buildLeft m (Node acc 1 Leaf)

sumTree : Tree -> Int32
sumTree t = case t of
  Leaf -> 0
  Node l v r -> case v of
    (n : Int32) -> case addInt32 (sumTree l) (sumTree r) of
      Left _e -> 0
      Right s -> case addInt32 s n of
        Left _e -> 0
        Right s2 -> s2
    (_s : String) -> case addInt32 (sumTree l) (sumTree r) of
      Left _e -> 0
      Right s -> s

main : IO Never Unit
main = IO.Stdout.print (showInt32 (sumTree (buildLeft 200000 Leaf)))
