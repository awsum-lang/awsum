{- A multi-arm `case` sitting in a tail self-call's argument, inside a
   function that becomes a loop. Compiles and runs on every backend;
   prints the boolean result. -}

import IO.Stdout

go : Int32 -> Bool -> String
go n flag = case eqInt32 n (0 : Int32) of
  True -> showBool flag
  False -> case predInt32 n of
    Left _e -> "underflow"
    Right m -> go m (case flag of
      True -> False
      False -> True
    )

main : IO Never Unit
main = IO.Stdout.print (go (3 : Int32) True)
