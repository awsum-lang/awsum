{- Non-tail self-recursion on UInt8 from 255 to 0; recursive call wrapped
   in `case`, frames stay live until termination. -}

import IO.Stdout

countDown : UInt8 -> Either (UnderflowError | StringTooLong) String
countDown n = case eqUInt8 n 0 of
  True -> Right (showUInt8 n)
  False -> case predUInt8 n of
    Left e -> Left e
    Right m -> case countDown m of
      Left e -> Left e
      Right s -> case showUInt8 n ++ "," of
        Left e -> Left e
        Right s0 -> s0 ++ s

showResult : Either (UnderflowError | StringTooLong) String -> Either StringTooLong String
showResult r = case r of
  Left e -> case e of
    (u : UnderflowError) -> "left: " ++ showUnderflowError u
    StringTooLong -> Right "STRING_TOO_LONG"
  Right s -> "right: " ++ s

res : Either StringTooLong String
res = showResult (countDown 255)

main : IO Never Unit
main = eitherToIO res
  |> andThenIO IO.Stdout.print
  |> handleErrorIO onError

onError : StringTooLong -> IO Never Unit
onError e = case e of
  StringTooLong -> IO.Stdout.print "STRING_TOO_LONG"
