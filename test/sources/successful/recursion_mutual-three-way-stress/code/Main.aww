{- Three-way mutual tail recursion at depth 1_000_000. Runs in bounded
   stack on every backend. -}

import IO.Stdout

stepA : Int32 -> Either UnderflowError Int32
stepA n = case eqInt32 n 0 of
  True -> Right 0
  False -> case predInt32 n of
    Left e -> Left e
    Right m -> stepB m

stepB : Int32 -> Either UnderflowError Int32
stepB n = case eqInt32 n 0 of
  True -> Right 0
  False -> case predInt32 n of
    Left e -> Left e
    Right m -> stepC m

stepC : Int32 -> Either UnderflowError Int32
stepC n = case eqInt32 n 0 of
  True -> Right 0
  False -> case predInt32 n of
    Left e -> Left e
    Right m -> stepA m

main : IO Never Unit
main = eitherToIO (stepA 1_000_000)
  |> andThenIO (\v -> IO.Stdout.print (showInt32 v))
  |> handleErrorIO onError

onError : UnderflowError -> IO Never Unit
onError e = case e of
  UnderflowError -> IO.Stdout.print (showUnderflowError e)
