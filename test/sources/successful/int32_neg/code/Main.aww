{- `negInt32`: ordinary `Right (-x)`; `Left OverflowError` only at `minInt32` (negation doesn't fit). -}

import IO.Stdout

render : Either OverflowError Int32 -> Either StringTooLong String
render r = case r of
  Left e -> "overflow: " ++ showOverflowError e
  Right v -> "ok: " ++ showInt32 v

res : Either StringTooLong String
res = do
  a <- render (negInt32 5)
  b <- render (negInt32 (-5))
  c <- render (negInt32 0)
  d <- render (negInt32 maxInt32)
  e <- render (negInt32 minInt32)
  s0 <- a ++ ", "
  s1 <- s0 ++ b
  s2 <- s1 ++ ", "
  s3 <- s2 ++ c
  s4 <- s3 ++ ", "
  s5 <- s4 ++ d
  s6 <- s5 ++ ", "
  s6 ++ e

main : IO Never Unit
main = eitherToIO res
  |> andThenIO IO.Stdout.print
  |> handleErrorIO onError

onError : StringTooLong -> IO Never Unit
onError e = case e of
  StringTooLong -> IO.Stdout.print "STRING_TOO_LONG"
