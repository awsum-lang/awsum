{- `predInt32`: ordinary `Right (x-1)`; `Left UnderflowError` at `minInt32`. -}
import IO.Stdout

render : Either UnderflowError Int32 -> Either StringTooLong String
render r = case r of
  Left e -> "underflow: " ++ showUnderflowError e
  Right v -> "ok: " ++ showInt32 v

main : Either (StringTooLong | UnpairedUtf16Surrogate) String -> IO Never Unit
main _input =
  let res : Either StringTooLong String = (do
        a <- render (predInt32 42)
        b <- render (predInt32 minInt32)
        s0 <- a ++ ", "
        s0 ++ b
      )
   in case res of
        Left _ -> IO.Stdout.print "STRING_TOO_LONG"
        Right s -> IO.Stdout.print s
