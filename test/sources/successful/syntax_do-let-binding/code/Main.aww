{- `let` between two `<-` binds: lifted helper must capture both the
   previous bind and the let-binder, and keep the let in scope through
   the rest of the do-block. -}
import IO.Stdout

step1 : Int32 -> Either String Int32
step1 n = case addInt32 n 10 of
  Left _e -> Left "overflow"
  Right m -> Right m

step2 : Int32 -> Either String Int32
step2 n = case mulInt32 n 2 of
  Left _e -> Left "overflow"
  Right m -> Right m

run : Int32 -> Either (String | StringTooLong) String
run start = do
  a <- step1 start
  let prefix = "answer="
  b <- step2 a
  prefix ++ showInt32 b

renderErr : (String | StringTooLong) -> Either StringTooLong String
renderErr e = case e of
  (s : String) -> "err: " ++ s
  StringTooLong -> Right "STRING_TOO_LONG"

main : IO Never Unit
main = case run 5 of
  Left e -> case renderErr e of
    Left _ -> IO.Stdout.print "STRING_TOO_LONG"
    Right out -> IO.Stdout.print out
  Right s -> IO.Stdout.print s
