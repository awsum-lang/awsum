{- Closure capturing two distinct outer parameters. The lambda body
   references `a` and `b` (both `Int32` parameters of the enclosing
   function); after lifting, the helper takes both captures up front
   and the call site passes them as runtime arguments to the
   specialised `apply`. -}
import IO.Stdout

apply : (a -> b) -> a -> b
apply f x = f x

zero : Int32
zero = 0

both : Int32 -> Int32 -> String
both a b = apply (\_n -> showInt32 a ++ "/" ++ showInt32 b) zero

main : String -> IO Unit
main _input = IO.Stdout.print (both 11 22)
