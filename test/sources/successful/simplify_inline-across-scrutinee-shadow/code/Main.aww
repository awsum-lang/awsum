{- Inlining a single-use case binder must not capture a name shadowed deeper in
   the arm: `a` is bound by the outer match and read in the inner arm, where the
   field read it folds into must still refer to the outer cell, not the
   identically-named inner one. `splitOnFirst` on "X:Y:Z" gives `Tuple2 "X"
   "Y:Z"`, then `Tuple2 "Y" "Z"`, so `pick "X:Y:Z"` is the first field. Prints
   `X`. -}

import IO.Stdout

pick : String -> String
pick raw = case splitOnFirst ":" raw of
  Nothing -> "NO_OUTER"
  Just (Tuple2 a rest) -> case splitOnFirst ":" rest of
    Nothing -> "NO_INNER"
    Just (Tuple2 _b _c) -> a

main : IO Never Unit
main = IO.Stdout.print (pick "X:Y:Z")
