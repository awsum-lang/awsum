{- A helper too big to always inline but called exactly once: the compiler
   inlines it and drops the definition. A runtime seed (string built-ins don't
   constant-fold) keeps the inlined chain running at run time. Prints `eleven`. -}

import IO.Stdout

describe : UInt32 -> String
describe n = case eqUInt32 n 0 of
  True -> "zero"
  False -> case eqUInt32 n 1 of
    True -> "one"
    False -> case eqUInt32 n 2 of
      True -> "two"
      False -> case eqUInt32 n 11 of
        True -> "eleven"
        False -> showUInt32 n

main : IO Never Unit
main = IO.Stdout.print (describe (lengthUtf8Bytes (showInt32 (-2_000_000_000))))
