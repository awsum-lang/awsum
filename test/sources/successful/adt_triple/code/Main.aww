{- ADT with 3 type parameters and a 3-field constructor. -}
import IO.Stdout

type Triple a b c = Triple a b c

showTriple : Triple String String String -> Either StringTooLong String
showTriple t = case t of
  Triple a b c -> h0 a b c

main : Either (StringTooLong | UnpairedUtf16Surrogate) String -> IO Never Unit
main _input =
  let res : Either StringTooLong String = showTriple (Triple "one" "two" "three")
   in case res of
        Left _ -> IO.Stdout.print "STRING_TOO_LONG"
        Right s -> IO.Stdout.print s

h0 : String -> String -> String -> Either StringTooLong String
h0 a b c =
  do
    s0 <- a ++ " "
    s1 <- s0 ++ b
    s2 <- s1 ++ " "
    s2 ++ c
