{- ADT with 3 type parameters and a 3-field constructor. -}

import IO.Stdout

type Triple a b c = Triple a b c

showTriple : Triple String String String -> Either StringTooLong String
showTriple t = case t of
  Triple a b c -> h0 a b c

res : Either StringTooLong String
res = showTriple (Triple "one" "two" "three")

main : IO Never Unit
main = eitherToIO res
  |> andThenIO IO.Stdout.print
  |> handleErrorIO onError

onError : StringTooLong -> IO Never Unit
onError e = case e of
  StringTooLong -> IO.Stdout.print "STRING_TOO_LONG"

h0 : String -> String -> String -> Either StringTooLong String
h0 a b c = do
  s0 <- a ++ " "
  s1 <- s0 ++ b
  s2 <- s1 ++ " "
  s2 ++ c
