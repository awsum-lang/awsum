{- Polymorphic `identity`, `compose`; `const` from prelude. -}
import IO.Stdout

main : IO Never Unit
main =
  let res : Either StringTooLong String = (do
        ax <- appendX (const "a" "b")
        identity (appendY ax)
      )
   in case res of
        Left _ -> IO.Stdout.print "STRING_TOO_LONG"
        Right s -> IO.Stdout.print s

identity : a -> a
identity x = x

appendX : String -> Either StringTooLong String
appendX s = s ++ "x"

appendY : String -> Either StringTooLong String
appendY s = s ++ "y"
