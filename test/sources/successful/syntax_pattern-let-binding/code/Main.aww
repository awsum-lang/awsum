{- Pattern on the LHS of a `let`: `let (Tuple2 a b) = e in …`. -}

import IO.Stdout

threeAndDouble : Int32 -> Tuple2 Int32 Int32
threeAndDouble n = case mulInt32 n 2 of
  Left _ -> Tuple2 n n
  Right d -> Tuple2 n d

show : Tuple2 Int32 Int32 -> Either StringTooLong String
show pair =
  let (Tuple2 a b) = pair
   in do
        s0 <- "[" ++ showInt32 a
        s1 <- s0 ++ ", "
        s2 <- s1 ++ showInt32 b
        s2 ++ "]"

res : Either StringTooLong String
res = show (threeAndDouble 5)

main : IO Never Unit
main = eitherToIO res
  |> andThenIO IO.Stdout.print
  |> handleErrorIO onError

onError : StringTooLong -> IO Never Unit
onError e = case e of
  StringTooLong -> IO.Stdout.print "STRING_TOO_LONG"
