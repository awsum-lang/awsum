{- Nested ADT unwrapped via sequential case-of (not nested patterns). -}
import IO.Stdout

type Box a = Box a

unwrap : Box (Box (Box String)) -> String
unwrap b = case b of
  Box b2 -> case b2 of
    Box b3 -> case b3 of
      Box value -> value

main : Either (StringTooLong | UnpairedUtf16Surrogate) String -> IO Unit
main _input = IO.Stdout.print (unwrap (Box (Box (Box "hello"))))
