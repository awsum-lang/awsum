{- Function-typed parameter flows through one HOF into another. -}

import IO.Stdout

apply : (a -> b) -> a -> b
apply f x = f x

applyTwice : (a -> a) -> a -> a
applyTwice f x = apply f (apply f x)

incr : Int32 -> Int32
incr n = n

main : IO Never Unit
main = IO.Stdout.print (showInt32 (applyTwice incr 7))
