{- Reads all of stdin as strict UTF-8 (RFC 3629) with
   `IO.Stdin.readAllString` and prints it; malformed bytes give
   `InvalidUtf8`, input past the length cap gives `StringTooLong`. -}

import IO.Stdout
import IO.Stdin

onError : (StringTooLong | InvalidUtf8) -> IO Never Unit
onError e = case e of
  StringTooLong -> IO.Stdout.print "STRING_TOO_LONG"
  InvalidUtf8 -> IO.Stdout.print "INVALID_UTF8"

main : IO Never Unit
main = IO.Stdin.readAllString
  |> andThenIO IO.Stdout.print
  |> handleErrorIO onError
