{- Prints a string literal containing a supplementary-plane code point
   (U+1F525, 🔥) — one Unicode scalar, two UTF-16 code units, four UTF-8
   bytes. The input arrives via 'main' but is ignored; only the literal
   is sent to stdout.

   This isolates the stdout-encoding path from the argv-decoding path:
   a backend whose stdout layer mishandles supplementary characters
   (e.g. routing through the host's ANSI code page on Windows) will
   diverge from the others, while a backend whose argv decoder is
   broken — but whose stdout is fine — will still match. -}
import IO.Stdout

main : Either (StringTooLong | UnpairedUtf16Surrogate) String -> IO Unit
main _input = IO.Stdout.print "🔥"
