{- `subUInt32`: `Left UnderflowError` when `a < b`; `0 - 2147483648` traps signed wrap on JVM/CLR. -}
import IO.Stdout

render : Either UnderflowError UInt32 -> Either StringTooLong String
render r = case r of
  Left e -> "underflow: " ++ showUnderflowError e
  Right v -> "ok: " ++ showUInt32 v

main : Either (StringTooLong | UnpairedUtf16Surrogate) String -> IO Never Unit
main _input =
  let res : Either StringTooLong String = do
        a <- render (subUInt32 5 5)
        b <- render (subUInt32 maxUInt32 minUInt32)
        c <- render (subUInt32 minUInt32 1)
        d <- render (subUInt32 minUInt32 2147483648)
        e <- render (subUInt32 2147483648 2147483647)
        s0 <- a ++ ", "
        s1 <- s0 ++ b
        s2 <- s1 ++ ", "
        s3 <- s2 ++ c
        s4 <- s3 ++ ", "
        s5 <- s4 ++ d
        s6 <- s5 ++ ", "
        s6 ++ e
   in case res of
        Left _ -> IO.Stdout.print "STRING_TOO_LONG"
        Right s -> IO.Stdout.print s
