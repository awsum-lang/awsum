{- Three ADTs interacting; pattern matches threaded across them. -}

import IO.Stdout

type Color
  = Red
  | Green
  | Blue

type Box a = Box a

type Result a e = Ok a | Err e

colorName : Color -> String
colorName c = case c of
  Red -> "red"
  Green -> "green"
  Blue -> "blue"

showBoxedColor : Box Color -> String
showBoxedColor bc = case bc of
  Box c -> colorName c

showResult : Result (Box Color) String -> String
showResult r = case r of
  Ok box -> showBoxedColor box
  Err e -> e

main : IO Never Unit
main =
  let res : Either StringTooLong String = (do
        s0 <- showBoxedColor (Box Red) ++ " "
        s0 ++ showResult (Ok (Box Green))
      )
   in case res of
        Left _ -> IO.Stdout.print "STRING_TOO_LONG"
        Right s -> IO.Stdout.print s
