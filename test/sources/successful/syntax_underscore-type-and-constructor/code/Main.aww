{- `_` prefix on type names: intentionally-unused type compiles. -}
import IO.Stdout

type _A = X | Y

type B = One | Two

show : B -> String
show x = case x of
  One -> "one"
  Two -> "two"

main : Either (StringTooLong | UnpairedUtf16Surrogate) String -> IO Never Unit
main _input = IO.Stdout.print (show One)
