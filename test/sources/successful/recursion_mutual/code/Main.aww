{- Mutual recursion: forward references resolve across both functions. -}
import IO.Stdout

type Step = StepA | StepB | StepC | Done

handleA : Step -> Either StringTooLong String
handleA step = case step of
  StepA -> do
    rest <- handleB StepB
    "A" ++ rest
  StepB -> handleB step
  StepC -> handleB step
  Done -> Right ""

handleB : Step -> Either StringTooLong String
handleB step = case step of
  StepB -> do
    rest <- handleA StepC
    "B" ++ rest
  StepA -> handleA step
  StepC -> do
    rest <- handleA Done
    "C" ++ rest
  Done -> Right ""

main : Either (StringTooLong | UnpairedUtf16Surrogate) String -> IO Unit
main _input =
  let res : Either StringTooLong String = handleA StepA
   in case res of
        Left _ -> IO.Stdout.print "STRING_TOO_LONG"
        Right s -> IO.Stdout.print s
