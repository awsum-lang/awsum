{- Mutual recursion: forward references resolve across both functions. -}

import IO.Stdout

type Step
  = StepA
  | StepB
  | StepC
  | Done

handleA : Step -> Either StringTooLong String
handleA step = case step of
  StepA -> do
    rest <- handleB StepB
    "A" ++ rest
  StepB -> handleB step
  StepC -> handleB step
  Done -> Right ""

handleB : Step -> Either StringTooLong String
handleB step = case step of
  StepB -> do
    rest <- handleA StepC
    "B" ++ rest
  StepA -> handleA step
  StepC -> do
    rest <- handleA Done
    "C" ++ rest
  Done -> Right ""

res : Either StringTooLong String
res = handleA StepA

main : IO Never Unit
main = eitherToIO res
  |> andThenIO IO.Stdout.print
  |> handleErrorIO onError

onError : StringTooLong -> IO Never Unit
onError e = case e of
  StringTooLong -> IO.Stdout.print "STRING_TOO_LONG"
