{- Non-tail self-recursion at depth 100_000 on Int32, with the recursive
   call inside `case … of`. Runs in bounded stack on every backend. -}

import IO.Stdout

countDown : Int32 -> Either UnderflowError Int32
countDown n = case eqInt32 n 0 of
  True -> Right 0
  False -> case predInt32 n of
    Left e -> Left e
    Right m -> case countDown m of
      Left e -> Left e
      Right v -> Right v

showResult : Either UnderflowError Int32 -> Either StringTooLong String
showResult r = case r of
  Left e -> "left: " ++ showUnderflowError e
  Right v -> "right: " ++ showInt32 v

res : Either StringTooLong String
res = showResult (countDown 100_000)

main : IO Never Unit
main = eitherToIO res
  |> andThenIO IO.Stdout.print
  |> handleErrorIO onError

onError : StringTooLong -> IO Never Unit
onError e = case e of
  StringTooLong -> IO.Stdout.print "STRING_TOO_LONG"
