{- `predUInt8`: `Left UnderflowError` at 0; `predUInt8 255` traps signed-byte clipping on JVM. -}
import IO.Stdout

render : Either UnderflowError UInt8 -> String
render r = case r of
  Left e -> "underflow: " ++ showUnderflowError e
  Right v -> "ok: " ++ showUInt8 v

main : String -> IO Unit
main _input = IO.Stdout.print (render (predUInt8 minUInt8) ++ ", " ++ render (predUInt8 1) ++ ", " ++ render (predUInt8 maxUInt8))
