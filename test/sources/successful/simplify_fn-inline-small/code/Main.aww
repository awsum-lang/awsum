{- A small helper called twice: both calls inline and the definition is
   dropped. Prints `hello!again!`. -}

import IO.Stdout

shout : String -> String
shout s = case s ++ "!" of
  Left _e -> "TOO_LONG"
  Right t -> t

main : IO Never Unit
main = IO.Stdout.print (shout "hello") |> andThenIO (\_u -> IO.Stdout.print (shout "again"))
