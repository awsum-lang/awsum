{- A small helper called twice: both calls inline (body under the
   always-inline size bound) and the definition falls to the tree-shake —
   core.txt has no `shout` and no calls to it. -}

import IO.Stdout

shout : String -> String
shout s = case s ++ "!" of
  Left _e -> "TOO_LONG"
  Right t -> t

main : IO Never Unit
main =
  IO.Stdout.print (shout "hello")
    |> andThenIO (\_u -> IO.Stdout.print (shout "again"))
