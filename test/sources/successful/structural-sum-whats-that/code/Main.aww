-- End-to-end: the 'whatsThat' example, demonstrating the full
-- row-polymorphic pattern repertoire on a single scrutinee.
--
-- Features exercised in one program:
--   * a closed structural sum with three labels — two nominal
--     primitives ('Int32', 'String') and one type-applied nominal
--     ('Maybe (Bool | Unit)') whose argument is itself a structural
--     sum;
--   * mixed 'PAscribe' / 'PCon' arms in a single row case — the row
--     dispatch ('CRowCase' on FNV-1a row tags) interleaves with
--     nominal dispatch ('CCase' on positional constructor tags) for
--     'Just' vs 'Nothing';
--   * distributive head subsumption — a literal 'Just True : Maybe Bool'
--     flows into the outer expected type 'Maybe (Bool | Unit)' without
--     an explicit injection, because 'rowSubsume' descends through the
--     'TyApp' head;
--   * implicit injection at the lowering layer — 'Nothing' /
--     'Just True' / 'Just Unit' are wrapped at construction time with
--     'CRow (rowTag (Maybe (Bool | Unit))) …', so the outer 'CRowCase'
--     dispatch finds them under the same tag, and the inner row of
--     'Just' is in turn 'CRow (rowTag Bool)' / 'CRow (rowTag Unit)'.
import IO.Stdout

whatsThat : (Int32 | String | Maybe (Bool | Unit)) -> String
whatsThat x = case x of
  (n : Int32) -> "Int32 " ++ showInt32 n
  (s : String) -> "String " ++ s
  Nothing -> "Nothing"
  Just (b : Bool) -> case b of
    True -> "Just True"
    False -> "Just False"
  Just (u : Unit) -> "Just " ++ showUnit u

main : String -> IO Unit
main _input = IO.Stdout.print (whatsThat (Just True))
