{- `addUInt8`: `Left OverflowError` above 255; `255 + 255` traps sign-extension on JVM/CLR. -}
import IO.Stdout

render : Either OverflowError UInt8 -> Either StringTooLong String
render r = case r of
  Left e -> "overflow: " ++ showOverflowError e
  Right v -> "ok: " ++ showUInt8 v

main : Either (StringTooLong | UnpairedUtf16Surrogate) String -> IO Never Unit
main _input =
  let res : Either StringTooLong String = do
        a <- render (addUInt8 200 55)
        b <- render (addUInt8 200 56)
        c <- render (addUInt8 maxUInt8 maxUInt8)
        d <- render (addUInt8 minUInt8 minUInt8)
        s0 <- a ++ ", "
        s1 <- s0 ++ b
        s2 <- s1 ++ ", "
        s3 <- s2 ++ c
        s4 <- s3 ++ ", "
        s4 ++ d
   in case res of
        Left _ -> IO.Stdout.print "STRING_TOO_LONG"
        Right s -> IO.Stdout.print s
