{- `addUInt8`: `Left OverflowError` above 255; `255 + 255` traps sign-extension on JVM/CLR. -}
import IO.Stdout

render : Either OverflowError UInt8 -> String
render r = case r of
  Left e -> "overflow: " ++ showOverflowError e
  Right v -> "ok: " ++ showUInt8 v

main : String -> IO Unit
main _input = IO.Stdout.print (render (addUInt8 200 55) ++ ", " ++ render (addUInt8 200 56) ++ ", " ++ render (addUInt8 maxUInt8 maxUInt8) ++ ", " ++ render (addUInt8 minUInt8 minUInt8))
