{- Single ADT mixing data-bearing and nullary constructors. -}
import IO.Stdout

type Token = Word String | Number String | Comma | EOF

showToken : Token -> String
showToken token = case token of
  Word w -> "word:" ++ w
  Number n -> "num:" ++ n
  Comma -> ","
  EOF -> "<eof>"

main : String -> IO Unit
main _input = IO.Stdout.print (showToken (Word "hello") ++ " " ++ showToken Comma ++ " " ++ showToken (Number "42") ++ " " ++ showToken EOF)
