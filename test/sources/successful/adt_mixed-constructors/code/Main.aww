{- Single ADT mixing data-bearing and nullary constructors. -}
import IO.Stdout

type Token
  = Word String
  | Number String
  | Comma
  | EOF

showToken : Token -> Either StringTooLong String
showToken token = case token of
  Word w -> "word:" ++ w
  Number n -> "num:" ++ n
  Comma -> Right ","
  EOF -> Right "<eof>"

main : IO Never Unit
main =
  let res : Either StringTooLong String = (do
        a <- showToken (Word "hello")
        b <- showToken Comma
        c <- showToken (Number "42")
        d <- showToken EOF
        ab <- a ++ " "
        abc <- ab ++ b
        abcs <- abc ++ " "
        abcsc <- abcs ++ c
        abcscd <- abcsc ++ " "
        abcscd ++ d
      )
   in case res of
        Left _ -> IO.Stdout.print "STRING_TOO_LONG"
        Right s -> IO.Stdout.print s
