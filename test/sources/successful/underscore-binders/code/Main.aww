{- Tests: underscore in binders.
   • _ alone (in function params or patterns) is a wildcard — no binding.
   • _foo binds the name but the parser forbids referencing names with a
     leading underscore, so the binding is intentionally unused.
   • Multiple _ wildcards in the same scope are fine; they don't collide. -}
import IO.Stdout

type Box a = Box a

type Pair a b = Pair a b

greeting : String -> String
greeting _ = "hi"

unwrapBox : Box String -> String
unwrapBox b = case b of
  Box _ -> "unwrapped"

unwrapBoxNamed : Box String -> String
unwrapBoxNamed b = case b of
  Box _v -> "unwrapped-named"

showPair : Pair String String -> String
showPair p = case p of
  Pair _ _ -> "paired"

main : String -> IOUnit
main _input = IO.Stdout.print (greeting "x" ++ " " ++ unwrapBox (Box "a") ++ " " ++ unwrapBoxNamed (Box "b") ++ " " ++ showPair (Pair "l" "r"))
