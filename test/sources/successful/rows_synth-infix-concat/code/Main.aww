{- A `Left e` rebuilt from `(++)`'s `Either StringTooLong String` flows
   into a multi-alternative error row `(UnderflowError | StringTooLong)`.
   The program doubles a 16-char ASCII string 24 times, pushing `(++)` past
   `maxStringLengthUtf16CodeUnits` (`2^27` UTF-16 code units), so it returns
   `Left StringTooLong` and the row dispatch prints `string-too-long`. -}

import IO.Stdout

double : Int32 -> String -> Either (UnderflowError | StringTooLong) String
double n s = case eqInt32 n 0 of
  True -> Right s
  False -> case predInt32 n of
    Left ue -> Left ue
    Right m -> case s ++ s of
      Left se -> Left se
      Right s2 -> double m s2

onError : (UnderflowError | StringTooLong) -> IO Never Unit
onError e = case e of
  (_u : UnderflowError) -> IO.Stdout.print "underflow"
  (_t : StringTooLong) -> IO.Stdout.print "string-too-long"

main : IO Never Unit
main = eitherToIO (double 24 "0123456789abcdef")
  |> andThenIO (\_s -> IO.Stdout.print "done")
  |> handleErrorIO onError
