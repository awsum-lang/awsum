{- `case f x of …` — scrutinee is a direct call, not a variable. -}
import IO.Stdout

type Lookup a = Found a | NotFound

search : String -> Lookup String
search key = Found ("found:" ++ key)

main : String -> IO Unit
main _input = IO.Stdout.print (case search "hello" of
  Found v -> v
  NotFound -> "nothing")
