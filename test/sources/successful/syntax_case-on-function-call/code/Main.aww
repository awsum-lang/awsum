{- `case f x of …` — scrutinee is a direct call, not a variable. -}

import IO.Stdout

type Lookup a = Found a | NotFound

search : String -> Either StringTooLong (Lookup String)
search key = do
  found <- "found:" ++ key
  Right (Found found)

res : Either StringTooLong String
res = case search "hello" of
  Left e -> Left e
  Right (Found v) -> Right v
  Right NotFound -> Right "nothing"

main : IO Never Unit
main = eitherToIO res
  |> andThenIO IO.Stdout.print
  |> handleErrorIO onError

onError : StringTooLong -> IO Never Unit
onError e = case e of
  StringTooLong -> IO.Stdout.print "STRING_TOO_LONG"
