{- `case f x of …` — scrutinee is a direct call, not a variable. -}

import IO.Stdout

type Lookup a = Found a | NotFound

search : String -> Either StringTooLong (Lookup String)
search key = do
  found <- "found:" ++ key
  Right (Found found)

main : IO Never Unit
main =
  let res : Either StringTooLong String = (case search "hello" of
        Left e -> Left e
        Right (Found v) -> Right v
        Right NotFound -> Right "nothing"
      )
   in case res of
        Left _ -> IO.Stdout.print "STRING_TOO_LONG"
        Right s -> IO.Stdout.print s
