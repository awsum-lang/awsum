{- A function value stored in a constructor field, extracted by a
   `case` arm, then called. Two distinct functions are stored so the
   call site dispatches on more than one closure shape. -}

import IO.Stdout

type Box a = Box a

double : Int32 -> Either (UnderflowError | OverflowError) Int32
double n = addInt32 n n

triple : Int32 -> Either (UnderflowError | OverflowError) Int32
triple n = do
  m <- addInt32 n n
  addInt32 m n

callBox : Box (Int32 -> Either (UnderflowError | OverflowError) Int32) -> Int32 -> Either (UnderflowError | OverflowError) Int32
callBox b x = case b of
  Box f -> f x

res : Either (UnderflowError | OverflowError | StringTooLong) String
res = do
  d <- callBox (Box double) 7
  t <- callBox (Box triple) 7
  ds <- showInt32 d ++ " "
  ds ++ showInt32 t

main : IO Never Unit
main = eitherToIO res
  |> andThenIO IO.Stdout.print
  |> handleErrorIO onError

onError : (UnderflowError | OverflowError | StringTooLong) -> IO Never Unit
onError e = case e of
  UnderflowError -> IO.Stdout.print "UNDERFLOW"
  OverflowError -> IO.Stdout.print "OVERFLOW"
  StringTooLong -> IO.Stdout.print "STRING_TOO_LONG"
