{- Underscore binders: bare `_` is a wildcard, `_foo` is named-but-unused. -}
import IO.Stdout

type Box a = Box a

type Pair a b = Pair a b

greeting : String -> String
greeting _ = "hi"

unwrapBox : Box String -> String
unwrapBox b = case b of
  Box _ -> "unwrapped"

unwrapBoxNamed : Box String -> String
unwrapBoxNamed b = case b of
  Box _v -> "unwrapped-named"

showPair : Pair String String -> String
showPair p = case p of
  Pair _ _ -> "paired"

main : Either (StringTooLong | UnpairedUtf16Surrogate) String -> IO Never Unit
main _input =
  let res : Either StringTooLong String = (do
        s0 <- greeting "x" ++ " "
        s1 <- s0 ++ unwrapBox (Box "a")
        s2 <- s1 ++ " "
        s3 <- s2 ++ unwrapBoxNamed (Box "b")
        s4 <- s3 ++ " "
        s4 ++ showPair (Pair "l" "r")
      )
   in case res of
        Left _ -> IO.Stdout.print "STRING_TOO_LONG"
        Right s -> IO.Stdout.print s
