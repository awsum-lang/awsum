{- A row combinator (`bindEither`) partially applied and bound to a named
   top-level (`partialB = bindEither oa`) whose signature carries a concrete,
   narrow continuation row. The errors compose into `(EA | EB)`; `cont`
   returns `Left EB`, so it prints `B`. -}

import IO.Stdout

type EA = EA

type EB = EB

oa : Either EA Int32
oa = Right 2

cont : Int32 -> Either EB Int32
cont _n = Left EB

partialB : (Int32 -> Either EB Int32) -> Either (EA | EB) Int32
partialB = bindEither oa

describe : Either (EA | EB) Int32 -> String
describe r = case r of
  Left (_a : EA) -> "A"
  Left (_b : EB) -> "B"
  Right v -> showInt32 v

main : IO Never Unit
main = IO.Stdout.print (describe (partialB cont))
