{- The outer case's scrutinee is itself a `case`. Its arm `Just x` is
   destructured and `x` dispatched into a row `(Int32 | String)`. The inner
   case yields `Just "yes"`, so `x : String` and `dispatch x` takes the
   `String` alternative — it prints `s`. -}

import IO.Stdout

dispatch : (Int32 | String) -> String
dispatch x = case x of
  (_n : Int32) -> "i"
  (_s : String) -> "s"

main : IO Never Unit
main = case (case True of
  True -> Just "yes"
  False -> Nothing
) of
  Nothing -> IO.Stdout.print "n"
  Just x -> IO.Stdout.print (dispatch x)
