-- Test: `splitOnFirst` covers all eight cases listed in its prelude
-- docstring, in the same order. Output is a comma-separated trace of
-- the rendered results. Each case writes either `Nothing` or
-- `Just(<prefix>|<suffix>)` so absent vs empty fields stay
-- distinguishable on every backend.
import IO.Stdout

render : Maybe (Tuple2 String String) -> String
render r = case r of
  Nothing -> "Nothing"
  Just t -> case t of
    Tuple2 a b -> "Just(" ++ a ++ "|" ++ b ++ ")"

main : String -> IO Unit
main _input = IO.Stdout.print (render (splitOnFirst "," "a,b,c") ++ ", " ++ render (splitOnFirst "::" "user::42::admin") ++ ", " ++ render (splitOnFirst "x" "abc") ++ ", " ++ render (splitOnFirst "" "abc") ++ ", " ++ render (splitOnFirst ":" ":foo") ++ ", " ++ render (splitOnFirst ":" "foo:") ++ ", " ++ render (splitOnFirst "abc" "abc") ++ ", " ++ render (splitOnFirst "abcde" "ab"))
