{- Reads all of stdin as raw bytes with `IO.Stdin.readAllBytes` and prints
   them as a hex string; input past the length cap gives `StringTooLong`. -}

import IO.Stdout
import IO.Stdin

main : IO Never Unit
main = IO.Stdin.readAllBytes
  |> andThenIO (\bytes -> eitherToIO (bytesToHexStringNoPrefix bytes))
  |> andThenIO IO.Stdout.print
  |> handleErrorIO onError

onError : StringTooLong -> IO Never Unit
onError e = case e of
  StringTooLong -> IO.Stdout.print "TOO_LONG"
