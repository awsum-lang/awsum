{- A `case` whose scrutinee is a top-level value definition (`box`): the
   compiler must read the matched field through the case binder, not project it
   from the scrutinee a second time, since re-referencing a top-level value can
   re-evaluate it. A parameter scrutinee stays inlinable; a value-definition
   scrutinee does not. Prints `X`. -}

import IO.Stdout

box : Maybe String
box = Just "X"

pick : String
pick = case box of
  Nothing -> "none"
  Just s -> s

main : IO Never Unit
main = IO.Stdout.print pick
