{- A `case` over a literal `Just 42`: the compiler collapses it to the matching
   arm, so the scrutinee allocation and the dispatch disappear and the program
   just shows `42`. -}

import IO.Stdout

main : IO Never Unit
main = IO.Stdout.print (case Just (42 : Int32) of
  Nothing -> "nothing"
  Just n -> showInt32 n
)
