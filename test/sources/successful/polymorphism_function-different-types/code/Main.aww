{- One polymorphic function applied to two different type instantiations. -}
import IO.Stdout

type Box a = Box a

type Result a e = Ok a | Err e

unwrap : Box a -> a
unwrap box = case box of
  Box value -> value

showResult : Result String String -> String
showResult r = case r of
  Ok a -> a
  Err e -> e

main : Either (StringTooLong | UnpairedUtf16Surrogate) String -> IO Never Unit
main _input =
  let res : Either StringTooLong String = do
        s0 <- unwrap (Box "from box") ++ " "
        s0 ++ showResult (unwrap (Box (Ok "nested")))
   in case res of
        Left _ -> IO.Stdout.print "STRING_TOO_LONG"
        Right s -> IO.Stdout.print s
