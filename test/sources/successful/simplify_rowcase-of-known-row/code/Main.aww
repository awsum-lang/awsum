{- A `case` over a literal injection into a structural sum (`"hi"` ascribed to
   `(Int32 | String)`): the compiler collapses it to the matching `String` arm
   at compile time, so the row wrapper and the dispatch disappear and the
   program holds the string directly. Prints `hi`. -}

import IO.Stdout

main : IO Never Unit
main = IO.Stdout.print (case ("hi" : Int32 | String) of
  (n : Int32) -> showInt32 n
  (s : String) -> s
)
