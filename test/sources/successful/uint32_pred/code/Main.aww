{- `predUInt32`: `Left UnderflowError` at 0; `predUInt32 maxUInt32` traps signed-int clipping on JVM/CLR. -}

import IO.Stdout

render : Either UnderflowError UInt32 -> Either StringTooLong String
render r = case r of
  Left e -> "underflow: " ++ showUnderflowError e
  Right v -> "ok: " ++ showUInt32 v

res : Either StringTooLong String
res = do
  a <- render (predUInt32 minUInt32)
  b <- render (predUInt32 1)
  c <- render (predUInt32 2_147_483_648)
  d <- render (predUInt32 maxUInt32)
  s0 <- a ++ ", "
  s1 <- s0 ++ b
  s2 <- s1 ++ ", "
  s3 <- s2 ++ c
  s4 <- s3 ++ ", "
  s4 ++ d

main : IO Never Unit
main = eitherToIO res
  |> andThenIO IO.Stdout.print
  |> handleErrorIO onError

onError : StringTooLong -> IO Never Unit
onError e = case e of
  StringTooLong -> IO.Stdout.print "STRING_TOO_LONG"
