{- Eta-reduced (point-free) alias for a function-typed value. -}
import IO.Stdout
import IO.Args

say : String -> IO Never Unit
say = IO.Stdout.print

handleInputErr : (StringTooLong | UnpairedUtf16Surrogate) -> IO Never Unit
handleInputErr _e = IO.Stdout.print "INPUT_ERROR"

main : IO Never Unit
main = IO.Args.getArgs
  |> andThenIO say
  |> handleErrorIO handleInputErr
