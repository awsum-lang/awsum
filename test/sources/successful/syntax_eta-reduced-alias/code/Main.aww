{- Eta-reduced (point-free) alias for a function-typed value. -}

import IO.Stdout
import IO.Args

say : String -> IO Never Unit
say = IO.Stdout.print

sayFirst : List String -> IO Never Unit
sayFirst args = case headList args of
  Nothing -> say "NO_ARG"
  Just first -> say first

onError : (StringTooLong | UnpairedUtf16Surrogate) -> IO Never Unit
onError e = case e of
  StringTooLong -> IO.Stdout.print "STRING_TOO_LONG"
  UnpairedUtf16Surrogate -> IO.Stdout.print "UNPAIRED_UTF16_SURROGATE"

main : IO Never Unit
main = IO.Args.getArgs
  |> andThenIO sayFirst
  |> handleErrorIO onError
