-- End-to-end test for 'let' inside 'do'. The desugarer rewrites
-- 'do { let n = e; rest }' into 'ELet n e <rest desugared>', so by
-- the time lowering sees the program every 'let' — whether
-- written inside 'do' or as a standalone 'let-in' expression — is
-- the same 'ELet' node.
--
-- Two things this exercises beyond the standalone 'let-in' test:
--
--   * The let appears /between/ two 'do'-binds, so the lifted
--     '$let$N' helper has to capture both the previous bind's
--     result ('a') and the let-binder ('prefix') as parameters,
--     and the trailing '<-' / 'pureEither' steps continue to thread
--     correctly through the residual 'case'-on-'Either' that the
--     do-desugar generates around them.
--
--   * The let-binder ('prefix') is referenced in the trailing
--     'pureEither' result, so the lifted helper genuinely has to
--     keep it in scope across the rest of the block — eliminating
--     it via dead-code analysis would mask the regression this
--     test guards against.
import IO.Stdout

step1 : Int32 -> Either String Int32
step1 n = case addInt32 n 10 of
  Left _e -> Left "overflow"
  Right m -> Right m

step2 : Int32 -> Either String Int32
step2 n = case mulInt32 n 2 of
  Left _e -> Left "overflow"
  Right m -> Right m

run : Int32 -> Either String String
run start = do
  a <- step1 start
  let prefix = "answer="
  b <- step2 a
  pureEither (prefix ++ showInt32 b)

main : String -> IO Unit
main _input = case run 5 of
  Left e -> IO.Stdout.print ("err: " ++ e)
  Right s -> IO.Stdout.print s
