{- `Maybe a` from prelude (no import). -}
import IO.Stdout

unwrap : Maybe String -> Either StringTooLong String
unwrap m = case m of
  Just s -> "just: " ++ s
  Nothing -> Right "nothing"

main : IO Never Unit
main =
  let res : Either StringTooLong String = (do
        a <- unwrap (Just "hi")
        b <- unwrap Nothing
        s0 <- a ++ ", "
        s0 ++ b
      )
   in case res of
        Left _ -> IO.Stdout.print "STRING_TOO_LONG"
        Right s -> IO.Stdout.print s
