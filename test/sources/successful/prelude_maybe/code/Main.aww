{- `Maybe a` from prelude (no import). -}

import IO.Stdout

unwrap : Maybe String -> Either StringTooLong String
unwrap m = case m of
  Just s -> "just: " ++ s
  Nothing -> Right "nothing"

res : Either StringTooLong String
res = do
  a <- unwrap (Just "hi")
  b <- unwrap Nothing
  s0 <- a ++ ", "
  s0 ++ b

main : IO Never Unit
main = eitherToIO res
  |> andThenIO IO.Stdout.print
  |> handleErrorIO onError

onError : StringTooLong -> IO Never Unit
onError e = case e of
  StringTooLong -> IO.Stdout.print "STRING_TOO_LONG"
