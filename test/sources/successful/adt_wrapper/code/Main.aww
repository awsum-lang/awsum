{- Non-parametric single-constructor wrapper over a concrete field. -}
import IO.Stdout

type Wrapper = Wrap String

unwrap : Wrapper -> String
unwrap w = case w of
  Wrap value -> value

main : Either (StringTooLong | UnpairedUtf16Surrogate) String -> IO Unit
main _input = IO.Stdout.print (unwrap (Wrap "hello"))
