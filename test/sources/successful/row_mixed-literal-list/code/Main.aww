{- A row-typed list built from literals mixing `Int32` and `String` elements
   (`List (Int32 | String)`). The fold sums the `Int32` elements and skips
   the strings: `1 + 2 + 3`, so it prints `6`. -}

import IO.Stdout

sumRow : List (Int32 | String) -> Int32
sumRow xs = case xs of
  Nil -> 0
  Cons h t -> case h of
    (n : Int32) -> case addInt32 n (sumRow t) of
      Left _e -> 0
      Right r -> r
    (_s : String) -> sumRow t

mixed : List (Int32 | String)
mixed = Cons 1 (Cons "x" (Cons 2 (Cons "y" (Cons 3 Nil))))

main : IO Never Unit
main = IO.Stdout.print (showInt32 (sumRow mixed))
