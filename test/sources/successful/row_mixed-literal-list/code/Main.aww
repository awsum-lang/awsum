{- A row-typed list built from literals mixing Int32 and String elements.
   `synthLabelType` used to under-approximate the tail of such a list as
   `List String`: the bare int literals synthesise to nothing, so a later
   string element alone fixed the element tyvar, and the int literals were
   then lowered against a `String` element type — a "no numeric type" compile
   error on a well-typed program. Now an un-synthesisable argument that
   reaches the result fails synthesis, so the declared element type
   propagates to every element and the five backends agree on the fold. -}

import IO.Stdout

sumRow : List (Int32 | String) -> Int32
sumRow xs = case xs of
  Nil -> 0
  Cons h t -> case h of
    (n : Int32) -> case addInt32 n (sumRow t) of
      Left _e -> 0
      Right r -> r
    (_s : String) -> sumRow t

mixed : List (Int32 | String)
mixed = Cons 1 (Cons "x" (Cons 2 (Cons "y" (Cons 3 Nil))))

main : IO Never Unit
main = IO.Stdout.print (showInt32 (sumRow mixed))
