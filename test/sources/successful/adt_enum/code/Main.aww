{- Enum: nullary constructors, exhaustive case-of. -}
import IO.Stdout

type Color = Red | Green | Blue

show : Color -> String
show c = case c of
  Red -> "Red"
  Green -> "Green"
  Blue -> "Blue"

main : String -> IO Unit
main _input = IO.Stdout.print (show Red ++ ", " ++ show Green ++ ", " ++ show Blue)
