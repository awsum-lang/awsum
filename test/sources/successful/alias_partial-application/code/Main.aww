import IO.Stdout

-- Regression: an alias-form definition whose body is a partial
-- application (`const "RESULT"`, one of const's two arguments) is
-- eta-expanded into a first-order function. The eta parameter must be
-- appended to the inner call (`const "RESULT" $eta`) rather than
-- wrapping it (`CCall (CCall const ["RESULT"]) [$eta]`) — the nested form
-- is defunctionalised into a closure CCon in callee position that
-- LowerClosures cannot route through $applyN, crashing every backend.
partial : String -> String
partial = const "RESULT"

main : IO Never Unit
main = IO.Stdout.print (partial "ignored")
