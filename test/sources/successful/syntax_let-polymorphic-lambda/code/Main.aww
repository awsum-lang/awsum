{- `let id = \x -> x in body` — polymorphic let-bound lambda used at
   multiple types in the body, no annotation needed. -}
import IO.Stdout

type Tri = TA | TB | TC

showTri : Tri -> String
showTri t = case t of
  TA -> "A"
  TB -> "B"
  TC -> "C"

threeTypes : Int32 -> String -> Tri -> Either StringTooLong String
threeTypes n s b =
  let id = \x -> x
   in do
        s0 <- showInt32 (id n) ++ "/"
        s1 <- s0 ++ id s
        s2 <- s1 ++ "/"
        s2 ++ showTri (id b)

main : Either (StringTooLong | UnpairedUtf16Surrogate) String -> IO Unit
main _input =
  let res : Either StringTooLong String = threeTypes 42 "hello" TA
   in case res of
        Left _ -> IO.Stdout.print "STRING_TOO_LONG"
        Right s -> IO.Stdout.print s
