{- `let id = \x -> x in body` — polymorphic let-bound lambda used at
   multiple types in the body, no annotation needed. -}

import IO.Stdout

type Tri
  = TA
  | TB
  | TC

showTri : Tri -> String
showTri t = case t of
  TA -> "A"
  TB -> "B"
  TC -> "C"

threeTypes : Int32 -> String -> Tri -> Either StringTooLong String
threeTypes n s b =
  let id = (\x -> x)
   in do
        s0 <- showInt32 (id n) ++ "/"
        s1 <- s0 ++ id s
        s2 <- s1 ++ "/"
        s2 ++ showTri (id b)

res : Either StringTooLong String
res = threeTypes 42 "hello" TA

main : IO Never Unit
main = eitherToIO res
  |> andThenIO IO.Stdout.print
  |> handleErrorIO onError

onError : StringTooLong -> IO Never Unit
onError e = case e of
  StringTooLong -> IO.Stdout.print "STRING_TOO_LONG"
