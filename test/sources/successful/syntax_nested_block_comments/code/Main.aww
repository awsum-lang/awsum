{- Block comments nest: `{- outer {- inner -} more -}` is one comment
   in every position, while a comment inside a string literal is text.
   Prints `nested {- comments -}`. -}

import IO.Stdout

{- Standalone {- nested -} between declarations. -}

{- Doc comment {- nested {- twice -} -} on `label`. -}
label : Bool -> String
label b = case b of
  True -> "nested {- comments -}"
  {- Between case arms {--} {---} -}
  False -> "unreachable"

main : IO Never Unit
main = IO.Stdout.print (label True)
