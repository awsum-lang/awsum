{- A row combinator with the continuation as the /first/ argument:
   `andThenEither` takes the function before the operand (`oa |> andThenEither cont`).
   The errors compose into `(EA | EB | EC)`; `oc = Left EC`, so the chain
   short-circuits to `EC` and it prints `C`. -}

import IO.Stdout

type EA = EA

type EB = EB

type EC = EC

oa : Either EA Int32
oa = Right 1

ob : Either EB Int32
ob = Right 5

oc : Either EC Int32
oc = Left EC

cAt : Either (EA | EB | EC) Int32
cAt = oa |> andThenEither (\_n -> do
  b <- ob
  c <- oc
  pureEither c
)

describe : Either (EA | EB | EC) Int32 -> String
describe r = case r of
  Left (_a : EA) -> "A"
  Left (_b : EB) -> "B"
  Left (_c : EC) -> "C"
  Right n -> showInt32 n

main : IO Never Unit
main = IO.Stdout.print (describe cAt)
