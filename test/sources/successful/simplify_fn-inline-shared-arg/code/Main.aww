{- A parameter used twice with a non-variable argument: when the helper inlines,
   the argument is shared through a binding so it is evaluated once, not
   duplicated. A runtime seed keeps anything from folding away. Prints `14`. -}

import IO.Stdout

double : UInt32 -> String
double n = case addUInt32 n n of
  Left _o -> "OVERFLOW"
  Right d -> showUInt32 d

main : IO Never Unit
main = IO.Stdout.print (double (lengthUtf8Bytes (showInt32 (-123_456))))
