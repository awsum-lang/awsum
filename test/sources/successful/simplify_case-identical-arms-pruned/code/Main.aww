{- Dead-arm pruning composes with the collapse: `Blue` is never constructed,
   so its arm is dropped, and the two survivors are identical — the dispatch
   decides nothing. The compiler folds the choice through and the whole
   program reduces to printing a constant. Prints `vis`. -}

import IO.Stdout

type Color
  = Red
  | Green
  | Blue

pick : Bool -> Color
pick b = case b of
  True -> Red
  False -> Green

render : Color -> String
render c = case c of
  Red -> "vis"
  Green -> "vis"
  Blue -> "invis"

main : IO Never Unit
main = IO.Stdout.print (render (pick (eqUInt32 (lengthUtf8Bytes "zz") 2)))
