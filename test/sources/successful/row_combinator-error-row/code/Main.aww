{- A row-unioning combinator applied to a continuation that ignores its
   argument — `const ob` (a partial application) and `\_n -> ob` (a lambda).
   The errors compose into `(EA | EB)`. `oa = Left EA`, so each chain
   short-circuits to `EA` — it prints `AA`. -}

import IO.Stdout

type EA = EA

type EB = EB

oa : Either EA Int32
oa = Left EA

ob : Either EB Int32
ob = Right 5

c1 : Either (EA | EB) Int32
c1 = bindEither oa (const ob)

c2 : Either (EA | EB) Int32
c2 = andThenEither (\_n -> ob) oa

de : Either (EA | EB) Int32 -> String
de x = case x of
  Left (_a : EA) -> "A"
  Left (_b : EB) -> "B"
  Right n -> showInt32 n

main : IO Never Unit
main = IO.Stdout.print (de c1) |> andThenIO (\_u -> IO.Stdout.print (de c2))
