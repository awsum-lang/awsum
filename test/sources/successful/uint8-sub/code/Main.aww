-- Test: `subUInt8` returns `Right (a - b)` when `a >= b` and
-- `Left UnderflowError` when `a < b`. Covers (i) the exact boundary
-- `5 - 5 = Right 0` (the smallest non-underflow result), (ii) the
-- largest non-underflow result `255 - 0 = Right 255`, (iii) the
-- smallest underflow `0 - 1 = Left UnderflowError`, and (iv) the
-- maximum-underflow case `0 - 255 = Left UnderflowError` (verifies
-- the JVM/CLR Integer-boxed value isn't sign-extended before the
-- comparison the way add's UInt8 boundary check has to be).
import IO.Stdout

render : Either UnderflowError UInt8 -> String
render r = case r of
  Left e -> "underflow: " ++ showUnderflowError e
  Right v -> "ok: " ++ showUInt8 v

main : String -> IO Unit
main _input = IO.Stdout.print (render (subUInt8 5 5) ++ ", " ++ render (subUInt8 255 0) ++ ", " ++ render (subUInt8 0 1) ++ ", " ++ render (subUInt8 0 255))
