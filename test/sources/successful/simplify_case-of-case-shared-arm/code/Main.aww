{- A `case` whose scrutinee is another `case` where both inner arms select the
   same outer arm (`or b True` is `True` on both branches). The selected arm is
   small and case-free, so the compiler fuses the nested dispatch by
   materialising it on each branch. Prints `yes`. -}

import IO.Stdout

always : Bool -> String
always b = case or b True of
  True -> "yes"
  False -> "no"

main : IO Never Unit
main = IO.Stdout.print (always (eqUInt32 (lengthUtf8Bytes "x") 9))
