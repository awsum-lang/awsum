{- A binder whose sole use is the scrutinee of an inner `case` reached on
   only ONE path: `v`'s consuming `case v of` sits under the True arm of an
   outer dispatch, so its lifetime must end around the whole arm — sinking
   it into the inner case's arms would leave the False path never releasing
   `v` (a leak on the reference-counted backends, invisible in stdout).
   Prints `x`. -}

import IO.Stdout
import IO.Args

type Duo = MkDuo String String

type Boxed = MkBoxed Duo

build : Int32 -> Boxed
build n = case eqInt32 n 0 of
  True -> MkBoxed (MkDuo "x" "y")
  False -> case predInt32 n of
    Left _e -> MkBoxed (MkDuo "p" "q")
    Right m -> build m

pick : Boxed -> Bool -> String
pick bx flag = case bx of
  MkBoxed v -> case flag of
    True -> case v of
      MkDuo a _b -> a
    False -> "skip"

run : List String -> IO Never Unit
run args =
  let flag : Bool = case headList args of
        Nothing -> True
        Just _s -> False
   in IO.Stdout.print (pick (build 1) flag)

onError : (StringTooLong | UnpairedUtf16Surrogate) -> IO Never Unit
onError e = case e of
  StringTooLong -> IO.Stdout.print "STRING_TOO_LONG"
  UnpairedUtf16Surrogate -> IO.Stdout.print "UNPAIRED"

main : IO Never Unit
main = IO.Args.getArgs
  |> andThenIO run
  |> handleErrorIO onError
