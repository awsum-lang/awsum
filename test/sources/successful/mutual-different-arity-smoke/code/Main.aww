-- Smoke test for mutual recursion where the two members have DIFFERENT
-- ARITY: @parseExpr@ takes a single 'Input' argument, @parseBinary@
-- takes an 'Input' plus an 'Int32' accumulator. Before Awsum.Scc learned
-- to emit a sum-typed args ADT, this shape would pass through the pass
-- untouched (skipped because arities don't match) — perfectly fine at
-- the tiny depth exercised here (3 cross-calls), catastrophic at
-- real-world depths.
--
-- Keeping this in the suite ensures the heterogeneous merge stays
-- correct across all five backends, and locks in the cross-backend
-- stdout invariant so regressions are caught automatically. The stress
-- variant (@mutual-different-arity-stress@) exercises the same shape at
-- depth 100 000 to prove the stack-safety property.
import IO.Stdout

zero : Int32
zero = 0

type Input = IDone | IStep

parseExpr : Input -> Int32
parseExpr tok = case tok of
  IDone -> zero
  IStep -> parseBinary tok zero

parseBinary : Input -> Int32 -> Int32
parseBinary tok _acc = case tok of
  IDone -> zero
  IStep -> parseExpr IDone

main : String -> IO Unit
main _input = IO.Stdout.print (showInt32 (parseExpr IStep))
