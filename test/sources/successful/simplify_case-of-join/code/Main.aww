{- A tower of boolean operations above a runtime-dependent step: each level
   feeds the next, and the compiler folds the four upper levels through the
   shared dispatch into a single final case. Prints `F`. -}

import IO.Stdout

mix : Bool -> Bool
mix b = case b of
  True -> eqUInt32 (lengthUtf8Bytes "xyz") 3
  False -> False

seed : Bool
seed = eqUInt32 (lengthUtf8Bytes (showInt32 42)) 2

result : String
result =
  let s0 = seed
      s1 = and (mix s0) True
      s2 = and s1 True
      s3 = or s2 False
      s4 = not s3
   in case s4 of
        True -> "T"
        False -> "F"

main : IO Never Unit
main = IO.Stdout.print result
