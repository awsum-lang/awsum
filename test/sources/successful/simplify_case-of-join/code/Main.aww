{- A three-`case` tower over a runtime value (first CLI argument, or `3` when
   absent). The inner two `case`s fuse into a residual join point; the outer
   consumer then folds into the join's value tails, leaving one `CJoin` whose
   body is the consumer. Prints `x` for `7`, `y` for `1`, `z` otherwise. -}

import IO.Stdout
import IO.Args

type Col
  = Red
  | Green
  | Blue

type Tag
  = TX
  | TY
  | TZ

pick : Int32 -> Col
pick n = case eqInt32 n 0 of
  True -> Red
  False -> case eqInt32 n 1 of
    True -> Green
    False -> Blue

label : Int32 -> String
label k = case (case (case eqInt32 k 7 of
  True -> Red
  False -> pick k
) of
  Red -> TX
  Green -> TY
  Blue -> TZ
) of
  TX -> "x"
  TY -> "y"
  TZ -> "z"

run : List String -> IO Never Unit
run args = case headList args of
  Nothing -> IO.Stdout.print (label 3)
  Just s -> case parseInt32 s of
    Left _e -> IO.Stdout.print "PARSE"
    Right n -> IO.Stdout.print (label n)

onError : (StringTooLong | UnpairedUtf16Surrogate) -> IO Never Unit
onError e = case e of
  StringTooLong -> IO.Stdout.print "STL"
  UnpairedUtf16Surrogate -> IO.Stdout.print "UPS"

main : IO Never Unit
main = IO.Args.getArgs
  |> andThenIO run
  |> handleErrorIO onError
