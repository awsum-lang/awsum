{- `showInt32`: full range (sign, zero, multi-digit, boundaries). -}

import IO.Stdout

res : Either StringTooLong String
res = do
  s0 <- showInt32 minInt32 ++ ", "
  s1 <- s0 ++ showInt32 (-42)
  s2 <- s1 ++ ", "
  s3 <- s2 ++ showInt32 0
  s4 <- s3 ++ ", "
  s5 <- s4 ++ showInt32 7
  s6 <- s5 ++ ", "
  s7 <- s6 ++ showInt32 1_234_567
  s8 <- s7 ++ ", "
  s8 ++ showInt32 maxInt32

main : IO Never Unit
main = eitherToIO res
  |> andThenIO IO.Stdout.print
  |> handleErrorIO onError

onError : StringTooLong -> IO Never Unit
onError e = case e of
  StringTooLong -> IO.Stdout.print "STRING_TOO_LONG"
