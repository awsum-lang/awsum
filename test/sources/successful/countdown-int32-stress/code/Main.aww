-- Stress test: NON-tail-recursive countDown from 100_000 to 0 over
-- Int32. The recursive call @countDown m@ sits inside @case … of@ as a
-- scrutinee, so every invocation parks a pending pattern-match + Either
-- rewrap on the system stack before descending. At N=100_000 that would
-- blow every backend's stack (V8 ~13k, JVM ~16k, libc threads 8k pages)
-- without the compiler turning the non-tail self-recursion into a
-- heap-allocated continuation chain via CPS + defunctionalization (Awsum.
-- Cps pass).
--
-- Paired with @countdown-int32-stress-tail@ this pins down the
-- cross-backend stdout invariant for both recursion shapes at depth
-- 100_000. Printing @right: 0@ on all five backends proves the Core pass
-- hoists continuation frames off the system stack into an ADT chain and
-- the existing TCO pass folds the CPS'd form into a loop.
--
-- The post-call arms are @Left e -> Left e@ / @Right v -> Right v@ —
-- superficially identity, but each reconstructs a fresh @Either@ cell on
-- every backend (our uniform @[tag, field, …]@ container layout), so
-- @clang -O2@ can't collapse the chain into a tail call via peephole.
-- That keeps the stress load honest across LLVM/JVM/CLR/WASM/JS.
import IO.Stdout

zero : Int32
zero = 0

countDown : Int32 -> Either UnderflowError Int32
countDown n = case eqInt32 n zero of
  True -> Right zero
  False -> case predInt32 n of
    Left e -> Left e
    Right m -> case countDown m of
      Left e -> Left e
      Right v -> Right v

showResult : Either UnderflowError Int32 -> String
showResult r = case r of
  Left e -> "left: " ++ showUnderflowError e
  Right v -> "right: " ++ showInt32 v

start : Int32
start = 100000

main : String -> IOUnit
main _input = IO.Stdout.print (showResult (countDown start))
