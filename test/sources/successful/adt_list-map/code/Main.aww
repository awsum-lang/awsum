{- HOF over recursive ADT; case branches reconstruct the parametric type. -}

import IO.Stdout

type List a = Cons a (List a) | Nil

map : (String -> Either StringTooLong String) -> List String -> List (Either StringTooLong String)
map f list = case list of
  Cons head tail -> Cons (f head) (map f tail)
  Nil -> Nil

show : List (Either StringTooLong String) -> Either StringTooLong String
show xs = case xs of
  Cons h t -> showCons h t
  Nil -> Right ""

showCons : Either StringTooLong String -> List (Either StringTooLong String) -> Either StringTooLong String
showCons h t = do
  hStr <- h
  rest <- show t
  comma <- hStr ++ ","
  comma ++ rest

shout : String -> Either StringTooLong String
shout s = s ++ "!"

main : IO Never Unit
main =
  let res : Either StringTooLong String = show (map shout (Cons "a" (Cons "b" (Cons "c" Nil))))
   in case res of
        Left _ -> IO.Stdout.print "STRING_TOO_LONG"
        Right s -> IO.Stdout.print s
