{- Non-tail self-recursion at depth 1_000_000 whose post-call
   continuation also calls a closure stored in a constructor field.
   Runs in bounded stack on every backend. -}

import IO.Stdout

type Box = Box (Int32 -> Int32)

identity : Int32 -> Int32
identity n = n

countWithBox : Box -> Int32 -> Either UnderflowError Int32
countWithBox b n = case eqInt32 n 0 of
  True -> Right 0
  False -> case predInt32 n of
    Left e -> Left e
    Right m -> case countWithBox b m of
      Left e -> Left e
      Right v -> case b of
        Box f -> Right (f v)

main : IO Never Unit
main = eitherToIO (countWithBox (Box identity) 1_000_000)
  |> andThenIO (\v -> IO.Stdout.print (showInt32 v))
  |> handleErrorIO onError

onError : UnderflowError -> IO Never Unit
onError e = case e of
  UnderflowError -> IO.Stdout.print "underflow"
