{- `addUInt32`: `Left OverflowError` above 2^32-1; `maxUInt32 + maxUInt32` traps signedness on JVM/CLR. -}
import IO.Stdout

render : Either OverflowError UInt32 -> Either StringTooLong String
render r = case r of
  Left e -> "overflow: " ++ showOverflowError e
  Right v -> "ok: " ++ showUInt32 v

main : Either (StringTooLong | UnpairedUtf16Surrogate) String -> IO Unit
main _input =
  let res : Either StringTooLong String = do
        a <- render (addUInt32 2147483647 2147483647)
        b <- render (addUInt32 2147483647 2147483648)
        c <- render (addUInt32 maxUInt32 maxUInt32)
        d <- render (addUInt32 minUInt32 minUInt32)
        e <- render (addUInt32 maxUInt32 1)
        s0 <- a ++ ", "
        s1 <- s0 ++ b
        s2 <- s1 ++ ", "
        s3 <- s2 ++ c
        s4 <- s3 ++ ", "
        s5 <- s4 ++ d
        s6 <- s5 ++ ", "
        s6 ++ e
   in case res of
        Left _ -> IO.Stdout.print "STRING_TOO_LONG"
        Right s -> IO.Stdout.print s
