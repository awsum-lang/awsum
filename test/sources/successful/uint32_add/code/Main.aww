{- `addUInt32`: `Left OverflowError` above 2^32-1; `maxUInt32 + maxUInt32` traps signedness on JVM/CLR. -}

import IO.Stdout

render : Either OverflowError UInt32 -> Either StringTooLong String
render r = case r of
  Left e -> "overflow: " ++ showOverflowError e
  Right v -> "ok: " ++ showUInt32 v

res : Either StringTooLong String
res = do
  a <- render (addUInt32 2_147_483_647 2_147_483_647)
  b <- render (addUInt32 2_147_483_647 2_147_483_648)
  c <- render (addUInt32 maxUInt32 maxUInt32)
  d <- render (addUInt32 minUInt32 minUInt32)
  e <- render (addUInt32 maxUInt32 1)
  s0 <- a ++ ", "
  s1 <- s0 ++ b
  s2 <- s1 ++ ", "
  s3 <- s2 ++ c
  s4 <- s3 ++ ", "
  s5 <- s4 ++ d
  s6 <- s5 ++ ", "
  s6 ++ e

main : IO Never Unit
main = eitherToIO res
  |> andThenIO IO.Stdout.print
  |> handleErrorIO onError

onError : StringTooLong -> IO Never Unit
onError e = case e of
  StringTooLong -> IO.Stdout.print "STRING_TOO_LONG"
