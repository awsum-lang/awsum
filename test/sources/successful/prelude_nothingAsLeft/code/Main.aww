{- Direct test of `nothingAsLeft`: `Nothing` becomes `Left e`, `Just a`
   becomes `Right a`. The `chained` binding threads the result through a
   `do`-block sitting in an argument position. -}

import IO.Stdout

type Missing = Missing

show : Either Missing String -> Either StringTooLong String
show r = case r of
  Left Missing -> Right "Left Missing"
  Right s -> "Right " ++ s

main : IO Never Unit
main =
  let fromNothing : Either Missing String = nothingAsLeft Missing Nothing
      fromJust : Either Missing String = nothingAsLeft Missing (Just "hi")
      chained : Either Missing String = do
        h <- headList (Cons "first" (Cons "second" Nil)) |> nothingAsLeft Missing
        pureEither h
      msg : Either StringTooLong String = do
        a <- show fromNothing
        b <- show fromJust
        c <- show chained
        sep <- a ++ "|"
        s1 <- sep ++ b
        s2 <- s1 ++ "|"
        s2 ++ c
   in eitherToIO msg
        |> andThenIO IO.Stdout.print
        |> handleErrorIO onError

onError : StringTooLong -> IO Never Unit
onError e = case e of
  StringTooLong -> IO.Stdout.print "STRING_TOO_LONG"
