{- Direct test of `nothingAsLeft`: `Nothing` becomes `Left e`, `Just a`
   becomes `Right a`. The third binding (`chained`) threads the result
   through a `do`-block, which lowers to a `CCase` in an argument
   position of the let-block's compiled `CCall` — a JVM-codegen
   stackmap regression case (see `Awsum.Codegen.JVM.Assemble`'s
   `emitArgsViaLocals`). -}

import IO.Stdout

type Missing = Missing

show : Either Missing String -> Either StringTooLong String
show r = case r of
  Left Missing -> Right "Left Missing"
  Right s -> "Right " ++ s

main : IO Never Unit
main =
  let fromNothing : Either Missing String = nothingAsLeft Missing Nothing
      fromJust : Either Missing String = nothingAsLeft Missing (Just "hi")
      chained : Either Missing String = do
        h <- nothingAsLeft Missing (headList (Cons "first" (Cons "second" Nil)))
        pureEither h
      msg : Either StringTooLong String = do
        a <- show fromNothing
        b <- show fromJust
        c <- show chained
        sep <- a ++ "|"
        s1 <- sep ++ b
        s2 <- s1 ++ "|"
        s2 ++ c
   in case msg of
        Left _ -> IO.Stdout.print "STRING_TOO_LONG"
        Right s -> IO.Stdout.print s
