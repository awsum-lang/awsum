{- A `case` over a top-level constant (`alias`, which aliases `boxed = Just 42`):
   the compiler collapses it to the matching arm at compile time, so the
   constants disappear and the program just shows `42`. -}

import IO.Stdout

boxed : Maybe Int32
boxed = Just 42

alias : Maybe Int32
alias = boxed

main : IO Never Unit
main = IO.Stdout.print (case alias of
  Nothing -> "nothing"
  Just n -> showInt32 n
)
