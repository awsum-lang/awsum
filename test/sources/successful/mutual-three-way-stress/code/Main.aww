-- Stress test: three-way mutual tail recursion @stepA -> stepB ->
-- stepC -> stepA@ at depth 1 000 000 on Int32. SCC analysis should
-- detect the three-member cluster and fuse it into a single
-- @$scc$stepA_stepB_stepC@ with one tag per member; existing TCO then
-- folds the body into a loop. The combined effect: the recursion cycles
-- through all three arms dispatching by tag, but every iteration stays
-- on the same stack frame.
--
-- The 'even-odd-stress' test exercises the two-member version of the
-- same trick; this one pins down that SCC merge handles arbitrary cycle
-- lengths correctly and that dispatch over three tags is as cheap as
-- over two across all six backends.
--
-- @stepA@ returns @Either UnderflowError Int32@ to keep @predInt32@'s
-- shape threaded through uniformly — the @Left@ arm is unreachable for
-- any non-negative input (we hit zero before @predInt32@ could ever see
-- @minInt32@) but is still pattern-matched to keep the type shape
-- honest.
import IO.Stdout

zero : Int32
zero = 0

stepA : Int32 -> Either UnderflowError Int32
stepA n = case eqInt32 n zero of
  True -> Right zero
  False -> case predInt32 n of
    Left e -> Left e
    Right m -> stepB m

stepB : Int32 -> Either UnderflowError Int32
stepB n = case eqInt32 n zero of
  True -> Right zero
  False -> case predInt32 n of
    Left e -> Left e
    Right m -> stepC m

stepC : Int32 -> Either UnderflowError Int32
stepC n = case eqInt32 n zero of
  True -> Right zero
  False -> case predInt32 n of
    Left e -> Left e
    Right m -> stepA m

showResult : Either UnderflowError Int32 -> String
showResult r = case r of
  Left e -> "left: " ++ showUnderflowError e
  Right v -> "right: " ++ showInt32 v

start : Int32
start = 1000000

main : String -> IOUnit
main _input = IO.Stdout.print (showResult (stepA start))
