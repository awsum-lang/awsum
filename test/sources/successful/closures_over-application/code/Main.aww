{- Over-application of a higher-order function: `identity` (arity 1) is
   applied to three arguments, so `applyOnce` fills its single slot and
   `inc` and `5` over-apply the result it returns.
   `identity applyOnce inc 5` = `applyOnce inc 5` = `inc 5` = `5`. -}

import IO.Stdout

applyOnce : (Int32 -> Int32) -> Int32 -> Int32
applyOnce f x = f x

identity : a -> a
identity x = x

inc : Int32 -> Int32
inc n = n

main : IO Never Unit
main = IO.Stdout.print (showInt32 (identity applyOnce inc 5))
