-- Pattern on the LHS of a do-bind: `Tuple3 a b c <- e` destructures
-- the bound value in one step, no separate `case parsed of Tuple3 a
-- b c -> …` wrapper. Desugars to `case e of Left err -> Left err;
-- Right (Tuple3 a b c) -> rest` — the same `Right`-arm with the
-- user's pattern nested inside. Exhaustiveness is checked by the
-- standard `caseArmsNominal` machinery (Tuple3 is single-
-- constructor, so the inner column is trivially exhaustive); a
-- refutable LHS like `Just x <-` on a `Maybe` source raises
-- `NonExhaustiveCase` against the missing constructors (see the
-- error fixture `pattern-do-bind-refutable`).
import IO.Stdout

opTuple : String -> Either ParseError (Tuple3 Int32 Int32 Int32)
opTuple _ = Right (Tuple3 1 2 3)

main : String -> IO Unit
main raw =
  let res : Either ParseError Int32 = do
        Tuple3 a b c <- opTuple raw
        pureEither (case addInt32 a b of
          Left _ -> c
          Right ab -> case addInt32 ab c of
            Left _ -> c
            Right abc -> abc)
   in case res of
        Left _ -> IO.Stdout.print "PARSE_ERROR"
        Right n -> IO.Stdout.print (showInt32 n)
