{- Error-row widening for an io-first `bindIO` of `IO.Args.getArgs` whose
   continuation is an inline lambda failing with `EX`: the platform errors
   and `EX` compose into one row that the handler dispatches on. `getArgs`
   succeeds with no arguments, so the lambda runs `failIO EX` and prints
   `EX`. -}

import IO.Stdout
import IO.Args

type EX = EX

combined : IO (StringTooLong | UnpairedUtf16Surrogate | EX) Unit
combined = bindIO IO.Args.getArgs (\_args -> failIO EX)

onError : (StringTooLong | UnpairedUtf16Surrogate | EX) -> IO Never Unit
onError e = case e of
  StringTooLong -> IO.Stdout.print "STRING_TOO_LONG"
  UnpairedUtf16Surrogate -> IO.Stdout.print "UNPAIRED_UTF16_SURROGATE"
  EX -> IO.Stdout.print "EX"

main : IO Never Unit
main = combined |> handleErrorIO onError
