{- Tests: case expression applied directly to a function call result
   (case f x of ...) rather than to a variable or parameter. -}
import IO.Stdout

type Lookup a = Found a | NotFound

search : String -> Lookup String
search key = Found ("found:" ++ key)

main : String -> IOUnit
main input = IO.Stdout.print (case search "hello" of
  Found v -> v
  NotFound -> "nothing")
