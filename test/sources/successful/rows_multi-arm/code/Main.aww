{- Multi-arm row dispatch under a nominal head: two `Just (… : T)`
   ascribed arms merged into one multi-label dispatch. -}
import IO.Stdout

whatsInside : Maybe (Bool | Unit) -> Either StringTooLong String
whatsInside x = case x of
  Nothing -> Right "Nothing"
  Just (b : Bool) -> case b of
    True -> Right "Just True"
    False -> Right "Just False"
  Just (u : Unit) -> "Just " ++ showUnit u

summary : Either StringTooLong String
summary = do
  a <- whatsInside (Just True)
  b <- whatsInside (Just Unit)
  c <- whatsInside Nothing
  s0 <- a ++ "; "
  s1 <- s0 ++ b
  s2 <- s1 ++ "; "
  s2 ++ c

main : Either (StringTooLong | UnpairedUtf16Surrogate) String -> IO Unit
main _input =
  let res : Either StringTooLong String = summary
   in case res of
        Left _ -> IO.Stdout.print "STRING_TOO_LONG"
        Right s -> IO.Stdout.print s
