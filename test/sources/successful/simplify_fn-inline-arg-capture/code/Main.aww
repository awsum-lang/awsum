{- Function inlining must not capture an argument's free names: `pickSecond`'s
   parameter `a` is multi-use, so a call binds its first argument to a fresh
   name — and the second argument mentions the caller's own local `a`. The two
   stay distinct, so this prints `F` (capturing it would print `T`). -}

import IO.Stdout
import IO.Args

pickSecond : Bool -> Bool -> Bool
pickSecond a b = case a of
  True -> b
  False -> a

run : List String -> IO Never Unit
run args =
  let a : Bool = case headList args of
        Nothing -> True
        Just _s -> False
   in case pickSecond (eqString "x" "x") a of
        True -> IO.Stdout.print "T"
        False -> IO.Stdout.print "F"

onError : (StringTooLong | UnpairedUtf16Surrogate) -> IO Never Unit
onError e = case e of
  StringTooLong -> IO.Stdout.print "STRING_TOO_LONG"
  UnpairedUtf16Surrogate -> IO.Stdout.print "UNPAIRED"

main : IO Never Unit
main = IO.Args.getArgs
  |> andThenIO run
  |> handleErrorIO onError
