{- A row-widening combinator (`bindEither`) called in a checked position
   with an inline-lambda continuation (`\_n -> pureEither 7`). The errors
   compose into `(EA | EB)`. `oa = Left EA`, so the chain short-circuits to
   `EA` and it prints `A`. -}

import IO.Stdout

type EA = EA

type EB = EB

oa : Either EA Int32
oa = Left EA

cBare : Either (EA | EB) Int32
cBare = bindEither oa (\_n -> pureEither 7)

describe : Either (EA | EB) Int32 -> String
describe r = case r of
  Left (_a : EA) -> "A"
  Left (_b : EB) -> "B"
  Right n -> showInt32 n

main : IO Never Unit
main = IO.Stdout.print (describe cBare)
