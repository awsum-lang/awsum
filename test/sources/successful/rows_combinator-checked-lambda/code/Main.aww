import IO.Stdout

type EA = EA

type EB = EB

oa : Either EA Int32
oa = Left EA

-- Regression: a row-widening combinator (bindEither) called in a checked
-- position with an inline-lambda continuation whose body makes synth-first
-- fail (so checkExpr takes the spine fallback) must still be
-- row-monomorphised — the fallback has to substitute the call head so the
-- Left payload is tagged. Otherwise the row-case mis-dispatches and the
-- five backends diverge (crash / wrong arm / JS undefined).
cBare : Either (EA | EB) Int32
cBare = bindEither oa (\_n -> pureEither 7)

describe : Either (EA | EB) Int32 -> String
describe r = case r of
  Left (_a : EA) -> "A"
  Left (_b : EB) -> "B"
  Right n -> showInt32 n

main : IO Never Unit
main = IO.Stdout.print (describe cBare)
