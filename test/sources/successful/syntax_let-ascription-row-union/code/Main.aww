{- `let n : T = e in body`: ascription pushes the expected row-union
   down through a do-block; without it the do-block can't synthesise. -}

import IO.Stdout

type ErrA = ErrA

type ErrB = ErrB

opA : Either ErrA Int32
opA = Right 1

opB : Either ErrB Int32
opB = Right 2

main : IO Never Unit
main =
  let res : Either (ParseError | ErrA | ErrB) Int32 = (do
        a <- opA
        b <- opB
        pureEither b
      )
   in eitherToIO res
        |> andThenIO (\n -> IO.Stdout.print (showInt32 n))
        |> handleErrorIO onError

onError : (ParseError | ErrA | ErrB) -> IO Never Unit
onError e = case e of
  ParseError -> IO.Stdout.print "PARSE_ERROR"
  ErrA -> IO.Stdout.print "ERR_A"
  ErrB -> IO.Stdout.print "ERR_B"
