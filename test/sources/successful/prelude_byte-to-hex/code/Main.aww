{- Exercises the hex helpers `byteToHexStringNoPrefix` and
   `bytesToHexStringNoPrefix` on literal bytes; output is `000f10abff`. -}

import IO.Stdout

res : Either StringTooLong String
res =
  let bytes : List UInt8 = Cons 0 (Cons 15 (Cons 16 (Cons 171 (Cons 255 Nil))))
   in bytesToHexStringNoPrefix bytes

main : IO Never Unit
main = eitherToIO res
  |> andThenIO IO.Stdout.print
  |> handleErrorIO onError

onError : StringTooLong -> IO Never Unit
onError e = case e of
  StringTooLong -> IO.Stdout.print "TOO_LONG"
