{- Direct test of `pureIO`: lifts a pure value into the IO monad
   as an `IOPure` cell. Composed with `bindIO` whose continuation
   is the platform built-in `IO.Stdout.print` passed as a value —
   this shape used to crash before built-in eta-wrappers landed. -}

import IO.Stdout

main : IO Never Unit
main = bindIO (pureIO "from pureIO") IO.Stdout.print
