-- Test: tail-recursive self-recursion on UInt8 counting down from 255 to
-- 0. The accumulator carries the rendered prefix, and the recursive
-- `countDown m acc'` call is the very last thing each branch does —
-- nothing wraps its result. Paired with `countdown-uint8` (non-tail
-- counterpart), this pins down the cross-backend stdout invariant for
-- both recursion shapes. The TCO pass rewrites this body into a 'CLoop'
-- before codegen, so every backend emits it as a jump rather than a
-- recursive call; see `countdown-int32-stress-tail` for the depth proof.
--
-- `countDown`'s result is `Either UnderflowError String` — @predUInt8@'s
-- `Left` arm is unreachable here because the termination check
-- (@eqUInt8 n zero@) fires first, so we never call @predUInt8 0@. The
-- arm is still threaded through (`Left e -> Left e`) to keep the full
-- shape intact, and `showResult` renders the final value so the stdout
-- layout matches the other countdown tests.
import IO.Stdout

zero : UInt8
zero = 0

countDown : UInt8 -> String -> Either UnderflowError String
countDown n acc = case eqUInt8 n zero of
  True -> Right (acc ++ showUInt8 n)
  False -> case predUInt8 n of
    Left e -> Left e
    Right m -> countDown m (acc ++ showUInt8 n ++ ",")

showResult : Either UnderflowError String -> String
showResult r = case r of
  Left e -> "left: " ++ showUnderflowError e
  Right s -> "right: " ++ s

start : UInt8
start = 255

main : String -> IOUnit
main _input = IO.Stdout.print (showResult (countDown start ""))
