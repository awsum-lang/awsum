{- Test: partial application creates a first-class function value.
   `compose unwrap wrap` supplies 2 of 3 args to compose; the result must
   behave as a 1-arg function that `apply` can invoke with the final arg. -}
import IO.Stdout

type Box a = Box a

wrap : String -> Box String
wrap s = Box s

unwrap : Box String -> String
unwrap b = case b of
  Box value -> value

apply : (a -> b) -> a -> b
apply f x = f x

compose : (b -> c) -> (a -> b) -> a -> c
compose f g x = f (g x)

main : String -> IO Unit
main _input = IO.Stdout.print (apply (compose unwrap wrap) "chain")
