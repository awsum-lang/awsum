-- Test: nested monomorphic Result with inline flat pattern matching (4 branches)
import IO.Stdout

type Result a e = Ok a | Err e

unwrap : Result (Result String String) (Result String String) -> String
unwrap r = case r of
  Ok (Ok value) -> value
  Ok (Err value) -> value
  Err (Ok value) -> value
  Err (Err value) -> value

main : String -> IOUnit
main _input = IO.Stdout.print (unwrap (Ok (Ok "1")) ++ "," ++ unwrap (Ok (Err "2")) ++ "," ++ unwrap (Err (Ok "3")) ++ "," ++ unwrap (Err (Err "4")))
