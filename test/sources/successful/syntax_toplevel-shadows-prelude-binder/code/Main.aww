{- Cross-module shadowing. Top-level functions `x` and `a` reuse names the
   prelude binds locally inside `eitherToIO` (whose body is
   `case x of Left e -> failIO e; Right a -> pureIO a`). Within-module
   shadowing is rejected, but the prelude and the user program are separate
   modules, so this is legal. `x 7 = Right 6`, `a 6 = Right 7`, so it
   prints `7`. -}

import IO.Stdout

x : Int32 -> Either UnderflowError Int32
x n = predInt32 n

a : Int32 -> Either OverflowError Int32
a n = succInt32 n

main : IO Never Unit
main = eitherToIO (x 7)
  |> andThenIO (\v -> eitherToIO (a v))
  |> andThenIO (\w -> IO.Stdout.print (showInt32 w))
  |> handleErrorIO onError

onError : (UnderflowError | OverflowError) -> IO Never Unit
onError e = case e of
  UnderflowError -> IO.Stdout.print "UNDERFLOW"
  OverflowError -> IO.Stdout.print "OVERFLOW"
