{- Closed structural sum `(Int32 | String)`: row-dispatch arms, implicit
   injection at the call site. -}

import IO.Stdout

describe : (Int32 | String) -> Either StringTooLong String
describe x = case x of
  (n : Int32) -> "Int32 " ++ showInt32 n
  (s : String) -> "String " ++ s

main : IO Never Unit
main =
  let res : Either StringTooLong String = describe "hello"
   in case res of
        Left _ -> IO.Stdout.print "STRING_TOO_LONG"
        Right s -> IO.Stdout.print s
