{- Closed structural sum `(Int32 | String)`: row-dispatch arms, implicit
   injection at the call site. -}

import IO.Stdout

describe : (Int32 | String) -> Either StringTooLong String
describe x = case x of
  (n : Int32) -> "Int32 " ++ showInt32 n
  (s : String) -> "String " ++ s

res : Either StringTooLong String
res = describe "hello"

main : IO Never Unit
main = eitherToIO res
  |> andThenIO IO.Stdout.print
  |> handleErrorIO onError

onError : StringTooLong -> IO Never Unit
onError e = case e of
  StringTooLong -> IO.Stdout.print "STRING_TOO_LONG"
