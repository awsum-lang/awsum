{- Tests: polymorphic function (identity) applied to a parametric ADT
   value (Box "one"), then pattern matched. Verifies that polymorphic
   functions correctly pass through ADT values in all backends. -}
import IO.Stdout

type Box a = Box a

identity : a -> a
identity x = x

main : String -> IO Unit
main _input = IO.Stdout.print (case identity (Box "one") of
  Box v -> v)
