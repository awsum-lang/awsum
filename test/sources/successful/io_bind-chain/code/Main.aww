{- Composing two IO actions with `bindIO`: the first prints "a", its
   continuation prints "b". Output: `ab`. Demonstrates that `bindIO`
   in the prelude (lowered through Defunctionalize → Cps → TCO)
   produces an IO tree that the runtime walks in order. -}
import IO.Stdout

main : Either (StringTooLong | UnpairedUtf16Surrogate) String -> IO Never Unit
main _input = bindIO (IO.Stdout.print "a") (\_u -> IO.Stdout.print "b")
