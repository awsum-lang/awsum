{- Composing two IO actions with `andThenIO`: the first prints "a",
   its continuation prints "b". Output: `ab`. Demonstrates that
   `andThenIO` in the prelude (lowered through Defunctionalize → Cps
   → TCO) produces an IO tree that the runtime walks in order. The
   `|>` form puts the actions in execution order left-to-right. -}
import IO.Stdout

main : IO Never Unit
main = IO.Stdout.print "a" |> andThenIO (\_u -> IO.Stdout.print "b")
