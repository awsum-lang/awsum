{- Parametric ADT mixing one data constructor with one nullary constructor. -}
import IO.Stdout

type Lookup a = Found a | NotFound

unwrap : Lookup String -> String
unwrap x = case x of
  Found value -> value
  NotFound -> "not found"

main : Either (StringTooLong | UnpairedUtf16Surrogate) String -> IO Never Unit
main _input =
  let res : Either StringTooLong String = do
        s0 <- unwrap (Found "hello") ++ ", "
        s0 ++ unwrap NotFound
   in case res of
        Left _ -> IO.Stdout.print "STRING_TOO_LONG"
        Right s -> IO.Stdout.print s
