{- Parametric ADT mixing one data constructor with one nullary constructor. -}

import IO.Stdout

type Lookup a = Found a | NotFound

unwrap : Lookup String -> String
unwrap x = case x of
  Found value -> value
  NotFound -> "not found"

res : Either StringTooLong String
res = do
  s0 <- unwrap (Found "hello") ++ ", "
  s0 ++ unwrap NotFound

main : IO Never Unit
main = eitherToIO res
  |> andThenIO IO.Stdout.print
  |> handleErrorIO onError

onError : StringTooLong -> IO Never Unit
onError e = case e of
  StringTooLong -> IO.Stdout.print "STRING_TOO_LONG"
