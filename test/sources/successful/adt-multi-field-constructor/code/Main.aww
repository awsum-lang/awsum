{- Tests: constructor with 2 independent fields and pattern matching that binds both. -}
import IO.Stdout

type Pair a b = Pair a b

showPair : Pair String String -> String
showPair pair = case pair of
  Pair first second -> "(" ++ first ++ ", " ++ second ++ ")"

main : String -> IOUnit
main input = IO.Stdout.print (showPair (Pair "hello" "world"))
