{- Tail self-recursion at depth 100_000 on Int32; TCO must fold the
   self-call into a jump. -}
import IO.Stdout

countDown : Int32 -> Either UnderflowError Int32
countDown n = case eqInt32 n 0 of
  True -> Right 0
  False -> case predInt32 n of
    Left e -> Left e
    Right m -> countDown m

showResult : Either UnderflowError Int32 -> Either StringTooLong String
showResult r = case r of
  Left e -> "left: " ++ showUnderflowError e
  Right v -> "right: " ++ showInt32 v

main : Either (StringTooLong | UnpairedUtf16Surrogate) String -> IO Unit
main _input =
  let res : Either StringTooLong String = showResult (countDown 100000)
   in case res of
        Left _ -> IO.Stdout.print "STRING_TOO_LONG"
        Right s -> IO.Stdout.print s
