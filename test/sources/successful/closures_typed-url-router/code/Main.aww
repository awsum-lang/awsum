{- A typed URL router: one route value both matches a path and builds links
   to it, and each handler's parameters follow from the route's captures. The
   argument is a request path; prints the rendered page or the request's
   error. -}

import IO.Stdout
import IO.Args

type Route a b c d = Route (List String -> a -> Maybe (Tuple2 (List String) b)) ((List String -> d) -> List String -> c)

matchLit : String -> List String -> a -> Maybe (Tuple2 (List String) a)
matchLit expected segments value = case segments of
  Nil -> Nothing
  Cons segment rest -> case eqString segment expected of
    True -> Just (Tuple2 rest value)
    False -> Nothing

lit : String -> Route a a c c
lit label = Route (matchLit label) (\k acc -> k (Cons label acc))

top : Route a a c c
top = Route (\segments value -> Just (Tuple2 segments value)) (\k acc -> k acc)

matchCapture : (String -> Maybe x) -> List String -> (x -> p) -> Maybe (Tuple2 (List String) p)
matchCapture decode segments handler = case segments of
  Nil -> Nothing
  Cons segment rest -> case decode segment of
    Nothing -> Nothing
    Just x -> Just (Tuple2 rest (handler x))

capture : (String -> Maybe x) -> (x -> String) -> Route (x -> p) p (x -> q) q
capture decode encode = Route (matchCapture decode) (\k acc x -> k (Cons (encode x) acc))

chainMatch : (List String -> a -> Maybe (Tuple2 (List String) b)) -> (List String -> b -> Maybe (Tuple2 (List String) e)) -> List String -> a -> Maybe (Tuple2 (List String) e)
chainMatch earlier later segments value = case earlier segments value of
  Nothing -> Nothing
  Just (Tuple2 rest mid) -> later rest mid

andThen : Route b e d f -> Route a b c d -> Route a e c f
andThen (Route laterMatch laterPrint) (Route earlierMatch earlierPrint) = Route (chainMatch earlierMatch laterMatch) (\k acc -> earlierPrint (laterPrint k) acc)

decodeUInt : String -> Maybe UInt32
decodeUInt s = case parseUInt32 s of
  Left _ -> Nothing
  Right n -> Just n

uint : Route (UInt32 -> p) p (UInt32 -> q) q
uint = capture decodeUInt showUInt32

word : Route (String -> p) p (String -> q) q
word = capture Just (\s -> s)

type Section = Published | Drafts

decodeSection : String -> Maybe Section
decodeSection s = case eqString s "published" of
  True -> Just Published
  False -> case eqString s "drafts" of
    True -> Just Drafts
    False -> Nothing

encodeSection : Section -> String
encodeSection s = case s of
  Published -> "published"
  Drafts -> "drafts"

section : Route (Section -> p) p (Section -> q) q
section = capture decodeSection encodeSection

homeRoute : Route r r s s
homeRoute = top

userRoute : Route (UInt32 -> r) r (UInt32 -> s) s
userRoute = lit "users" |> andThen uint

postRoute : Route (UInt32 -> String -> r) r (UInt32 -> String -> s) s
postRoute = lit "users"
  |> andThen uint
  |> andThen (lit "posts")
  |> andThen word

archiveRoute : Route (UInt32 -> Section -> UInt32 -> r) r (UInt32 -> Section -> UInt32 -> s) s
archiveRoute = lit "users"
  |> andThen uint
  |> andThen section
  |> andThen (lit "page")
  |> andThen uint

serve : Route a r c d -> a -> List String -> Maybe r
serve (Route matcher _) handler segments = case matcher segments handler of
  Nothing -> Nothing
  Just (Tuple2 Nil result) -> Just result
  Just (Tuple2 (Cons _ _) _) -> Nothing

prependAll : List String -> String -> Either StringTooLong String
prependAll reversed acc = case reversed of
  Nil -> Right acc
  Cons segment rest -> do
    withSlash <- "/" ++ segment
    next <- withSlash ++ acc
    prependAll rest next

joinPath : List String -> Either StringTooLong String
joinPath reversed = case reversed of
  Nil -> Right "/"
  Cons _ _ -> prependAll reversed ""

link : Route a b c (Either StringTooLong String) -> c
link (Route _ printer) = printer joinPath Nil

type NotFound = NotFound

type Forbidden = Forbidden

userName : UInt32 -> Either NotFound String
userName userId = case eqUInt32 userId 1 of
  True -> Right "ada"
  False -> case eqUInt32 userId 2 of
    True -> Right "grace"
    False -> Left NotFound

postTitle : String -> Either (NotFound | Forbidden) String
postTitle slug = case eqString slug "hello" of
  True -> Right "Hello, world"
  False -> case eqString slug "draft" of
    True -> Left Forbidden
    False -> Left NotFound

concat3 : String -> String -> String -> Either StringTooLong String
concat3 x y z = do
  xy <- x ++ y
  xy ++ z

homePage : Either (NotFound | Forbidden | StringTooLong) String
homePage = Right "welcome"

userPage : UInt32 -> Either (NotFound | Forbidden | StringTooLong) String
userPage userId = do
  name <- userName userId
  archive <- link archiveRoute userId Published 1
  concat3 name " writes at " archive

postPage : UInt32 -> String -> Either (NotFound | Forbidden | StringTooLong) String
postPage userId slug = do
  name <- userName userId
  title <- postTitle slug
  author <- link userRoute userId
  self <- link postRoute userId slug
  byline <- concat3 title " by " name
  withAuthor <- concat3 byline ", author " author
  concat3 withAuthor ", permalink " self

archivePage : UInt32 -> Section -> UInt32 -> Either (NotFound | Forbidden | StringTooLong) String
archivePage userId kind page = case kind of
  Drafts -> Left Forbidden
  Published -> do
    name <- userName userId
    next <- nextPage userId page
    concat3 name " archive, next " next

nextPage : UInt32 -> UInt32 -> Either StringTooLong String
nextPage userId page = case succUInt32 page of
  Left _ -> Right "none"
  Right following -> link archiveRoute userId Published following

routes : List (List String -> Maybe (Either (NotFound | Forbidden | StringTooLong) String))
routes = Cons (serve homeRoute homePage) (Cons (serve userRoute userPage) (Cons (serve postRoute postPage) (Cons (serve archiveRoute archivePage) Nil)))

firstMatch : List (List String -> Maybe r) -> List String -> Maybe r
firstMatch table segments = case table of
  Nil -> Nothing
  Cons attempt rest -> case attempt segments of
    Just found -> Just found
    Nothing -> firstMatch rest segments

segmentsOf : String -> List String
segmentsOf path = case splitOnFirst "/" path of
  Nothing -> keepNonEmpty path Nil
  Just (Tuple2 piece rest) -> keepNonEmpty piece (segmentsOf rest)

keepNonEmpty : String -> List String -> List String
keepNonEmpty piece rest = case eqString piece "" of
  True -> rest
  False -> Cons piece rest

type MissingPath = MissingPath

type NoRoute = NoRoute

respond : List String -> Either (MissingPath | NoRoute | NotFound | Forbidden | StringTooLong) String
respond args = do
  path <- nothingAsLeft MissingPath (headList args)
  outcome <- nothingAsLeft NoRoute (firstMatch routes (segmentsOf path))
  outcome

onError : (StringTooLong | UnpairedUtf16Surrogate | MissingPath | NoRoute | NotFound | Forbidden) -> IO Never Unit
onError e = case e of
  StringTooLong -> IO.Stdout.print "STRING_TOO_LONG"
  UnpairedUtf16Surrogate -> IO.Stdout.print "UNPAIRED_UTF16_SURROGATE"
  MissingPath -> IO.Stdout.print "MISSING_PATH"
  NoRoute -> IO.Stdout.print "NO_ROUTE"
  NotFound -> IO.Stdout.print "NOT_FOUND"
  Forbidden -> IO.Stdout.print "FORBIDDEN"

main : IO Never Unit
main = IO.Args.getArgs
  |> andThenIO (\args -> eitherToIO (respond args))
  |> andThenIO IO.Stdout.print
  |> handleErrorIO onError
