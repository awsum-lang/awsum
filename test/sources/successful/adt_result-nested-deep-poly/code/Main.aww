{- Triple-nested polymorphic Result; flat 8-arm inline patterns. -}
import IO.Stdout

type Result a e = Ok a | Err e

unwrap : Result (Result (Result a a) (Result a a)) (Result (Result a a) (Result a a)) -> a
unwrap r = case r of
  Ok (Ok (Ok value)) -> value
  Ok (Ok (Err value)) -> value
  Ok (Err (Ok value)) -> value
  Ok (Err (Err value)) -> value
  Err (Ok (Ok value)) -> value
  Err (Ok (Err value)) -> value
  Err (Err (Ok value)) -> value
  Err (Err (Err value)) -> value

main : Either (StringTooLong | UnpairedUtf16Surrogate) String -> IO Never Unit
main _input =
  let res : Either StringTooLong String = (do
        s0 <- unwrap (Ok (Ok (Ok "1"))) ++ ","
        s1 <- s0 ++ unwrap (Ok (Ok (Err "2")))
        s2 <- s1 ++ ","
        s3 <- s2 ++ unwrap (Ok (Err (Ok "3")))
        s4 <- s3 ++ ","
        s5 <- s4 ++ unwrap (Ok (Err (Err "4")))
        s6 <- s5 ++ ","
        s7 <- s6 ++ unwrap (Err (Ok (Ok "5")))
        s8 <- s7 ++ ","
        s9 <- s8 ++ unwrap (Err (Ok (Err "6")))
        s10 <- s9 ++ ","
        s11 <- s10 ++ unwrap (Err (Err (Ok "7")))
        s12 <- s11 ++ ","
        s12 ++ unwrap (Err (Err (Err "8")))
      )
   in case res of
        Left _ -> IO.Stdout.print "STRING_TOO_LONG"
        Right s -> IO.Stdout.print s
