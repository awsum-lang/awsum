-- Test: polymorphic functions (identity, compose, const) with type variables
import IO.Stdout

main : String -> IOUnit
main input = IO.Stdout.print (identity (compose appendY appendX (const "a" "b")))

const : a -> b -> a
const x y = x

identity : a -> a
identity x = x

appendX : String -> String
appendX s = s ++ "x"

appendY : String -> String
appendY s = s ++ "y"

compose : (b -> c) -> (a -> b) -> a -> c
compose g f x = g (f x)
