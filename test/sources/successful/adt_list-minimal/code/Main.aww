{- Recursive ADT (List) with recursive show. -}
import IO.Stdout

type List a = Cons a (List a) | Nil

show : List String -> Either StringTooLong String
show xs = case xs of
  Cons h t -> showCons h t
  Nil -> Right ""

showCons : String -> List String -> Either StringTooLong String
showCons h t = do
  hc <- h ++ ","
  rest <- show t
  hc ++ rest

main : Either (StringTooLong | UnpairedUtf16Surrogate) String -> IO Unit
main _input =
  let res : Either StringTooLong String = show (Cons "a" (Cons "b" (Cons "c" Nil)))
   in case res of
        Left _ -> IO.Stdout.print "STRING_TOO_LONG"
        Right s -> IO.Stdout.print s
