{- A top-level value flows into a loop that consumes a stack of the same
   shape, and is read again afterwards. Awsum is pure, so the retained
   value must read back unchanged — the second read probes one level past
   the head, where an in-place overwrite would show. Its body is a call,
   not a constant, so neither the value nor the probe folds at compile
   time. Identical stdout on every backend is the check. -}

import IO.Stdout

type Stack = Empty | Push String Stack

mk : Int32 -> Stack -> Stack
mk n acc = case eqInt32 n 0 of
  True -> acc
  False -> case predInt32 n of
    Left _u -> acc
    Right m -> mk m (Push (showInt32 n) acc)

threeUp : Stack
threeUp = mk 3 Empty

revInto2 : Stack -> Stack -> Stack
revInto2 lst acc = case lst of
  Empty -> acc
  Push s rest -> revInto2 rest (Push s acc)

second : Stack -> String
second st = case st of
  Empty -> "E"
  Push _s2 r -> case r of
    Empty -> "e"
    Push s3 _r2 -> s3

main : IO Never Unit
main = IO.Stdout.print (second (revInto2 threeUp Empty)) |> andThenIO (\_u2 -> IO.Stdout.print (second threeUp))
