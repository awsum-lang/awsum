{- Chains two `Either`-returning ops with mismatching error labels;
   the `do`-desugared `case` arms must inject the bare-nominal error
   into the combined `(ErrA | ErrB)` row at lowering time without an
   explicit lift wrapper. -}
import IO.Stdout

type ErrA = ErrA

type ErrB = ErrB

opA : Int32 -> Either ErrA Int32
opA n = Right n

opB : Int32 -> Either ErrB Int32
opB _n = Left ErrB

run : Int32 -> Either (ErrA | ErrB) Int32
run x = do
  a <- opA x
  opB a

describe : Either (ErrA | ErrB) Int32 -> Either StringTooLong String
describe r = case r of
  Left e -> case e of
    ErrA -> Right "ErrA"
    ErrB -> Right "ErrB"
  Right n -> "Ok " ++ showInt32 n

main : Either (StringTooLong | UnpairedUtf16Surrogate) String -> IO Never Unit
main _input =
  let res : Either StringTooLong String = describe (run 5)
   in case res of
        Left _ -> IO.Stdout.print "STRING_TOO_LONG"
        Right s -> IO.Stdout.print s
