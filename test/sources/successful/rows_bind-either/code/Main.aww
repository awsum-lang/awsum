-- End-to-end: the prelude's row-polymorphic 'bindEither' composes two
-- 'Either'-returning operations whose error types differ by a single
-- nominal label, and the resulting error is dispatched by row-tag
-- (FNV-1a tag-by-name) in a 'PAscribe'-only 'case'.
--
-- Lift wrappers ('liftA' / 'liftB') re-construct the value with the
-- combined row type as the surrounding context; that is where the inner
-- nominal label gets implicitly injected as a CRow at lowering time.
-- The test exercises both arms (Right path threading 'opA' through,
-- Left path bubbling 'opB''s ErrB up).
import IO.Stdout

type ErrA = ErrA
type ErrB = ErrB

opA : Int32 -> Either ErrA Int32
opA n = Right n

opB : Int32 -> Either ErrB Int32
opB _n = Left ErrB

liftA : Either ErrA Int32 -> Either (ErrA | ErrB) Int32
liftA x = case x of
  Left e -> Left e
  Right n -> Right n

liftB : Either ErrB Int32 -> Either (ErrA | ErrB) Int32
liftB x = case x of
  Left e -> Left e
  Right n -> Right n

opBLifted : Int32 -> Either (ErrA | ErrB) Int32
opBLifted n = liftB (opB n)

run : Int32 -> Either (ErrA | ErrB) Int32
run x = bindEither (liftA (opA x)) opBLifted

describe : Either (ErrA | ErrB) Int32 -> String
describe r = case r of
  Left e -> case e of
    (_ : ErrA) -> "ErrA"
    (_ : ErrB) -> "ErrB"
  Right n -> "Ok " ++ showInt32 n

main : String -> IO Unit
main _input = IO.Stdout.print (describe (run 5))
