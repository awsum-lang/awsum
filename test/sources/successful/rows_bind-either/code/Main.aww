{- Chains two `Either`-returning ops with mismatching error labels;
   `do` desugars to row-polymorphic `bindEither`. The lift wrappers are
   load-bearing: implicit row-injection through `bindEither`'s lambda
   typechecks but lowers wrong on JVM (no `CRow` wrap). -}
import IO.Stdout

type ErrA = ErrA
type ErrB = ErrB

opA : Int32 -> Either ErrA Int32
opA n = Right n

opB : Int32 -> Either ErrB Int32
opB _n = Left ErrB

liftA : Either ErrA Int32 -> Either (ErrA | ErrB) Int32
liftA x = case x of
  Left e -> Left e
  Right n -> Right n

liftB : Either ErrB Int32 -> Either (ErrA | ErrB) Int32
liftB x = case x of
  Left e -> Left e
  Right n -> Right n

run : Int32 -> Either (ErrA | ErrB) Int32
run x = do
  a <- liftA (opA x)
  liftB (opB a)

describe : Either (ErrA | ErrB) Int32 -> String
describe r = case r of
  Left e -> case e of
    (_ : ErrA) -> "ErrA"
    (_ : ErrB) -> "ErrB"
  Right n -> "Ok " ++ showInt32 n

main : String -> IO Unit
main _input = IO.Stdout.print (describe (run 5))
