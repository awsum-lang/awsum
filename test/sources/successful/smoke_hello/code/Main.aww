{- Smoke: string concat, helper function, `IO.Stdout.print`. -}
import IO.Stdout
import IO.Args

main : IO Never Unit
main = IO.Args.getArgs
  |> andThenIO greetAndPrint
  |> handleErrorIO printDecodeError

greetAndPrint : String -> IO Never Unit
greetAndPrint input = case addGreeting input of
  Left _ -> IO.Stdout.print "STRING_TOO_LONG"
  Right s -> IO.Stdout.print s

printDecodeError : (StringTooLong | UnpairedUtf16Surrogate) -> IO Never Unit
printDecodeError e = case e of
  (_l : StringTooLong) -> IO.Stdout.print "STRING_TOO_LONG"
  (_u : UnpairedUtf16Surrogate) -> IO.Stdout.print "UNPAIRED_UTF16_SURROGATE"

{- Block comment -}

greeting : String
greeting = "Hello" -- Line comment

addGreeting : String -> Either StringTooLong String
addGreeting name = do
  s0 <- greeting ++ ", "
  s1 <- s0 ++ name
  s1 ++ "!"
