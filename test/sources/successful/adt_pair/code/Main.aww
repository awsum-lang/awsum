{- Constructor with 2 fields; pattern match binds both. -}
import IO.Stdout

type Pair a b = Pair a b

showPair : Pair String String -> String
showPair pair = case pair of
  Pair first second -> "(" ++ first ++ ", " ++ second ++ ")"

main : String -> IO Unit
main _input = IO.Stdout.print (showPair (Pair "hello" "world"))
