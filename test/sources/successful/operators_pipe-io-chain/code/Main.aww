{- The motivating use case for `|>`: chaining IO operations so the
   reading order matches the execution order. `andThenIO` takes the
   continuation first and the IO action second — exactly the shape
   `|>` wants on its right-hand side, so three actions chain
   left-to-right in execution order without nested lambdas and
   without a user-defined helper. -}
import IO.Stdout

main : Either (StringTooLong | UnpairedUtf16Surrogate) String -> IO Never Unit
main _input = IO.Stdout.print "a" |> andThenIO (\_u -> IO.Stdout.print "b") |> andThenIO (\_u -> IO.Stdout.print "c")
