{- Mutual recursion through a closure stored in a constructor field,
   at depth 1_000_000: `a` calls `b` indirectly via the closure in
   `bBox`, and `b` calls `a` directly. Runs in bounded stack on every
   backend. -}

import IO.Stdout

type Box = Box (Int32 -> Either UnderflowError Int32)

bBox : Box
bBox = Box (\n -> b n)

a : Int32 -> Either UnderflowError Int32
a n = case eqInt32 n 0 of
  True -> Right 0
  False -> case predInt32 n of
    Left e -> Left e
    Right m -> case bBox of
      Box f -> f m

b : Int32 -> Either UnderflowError Int32
b n = case eqInt32 n 0 of
  True -> Right 0
  False -> case predInt32 n of
    Left e -> Left e
    Right m -> a m

main : IO Never Unit
main = eitherToIO (a 1_000_000)
  |> andThenIO (\v -> IO.Stdout.print (showInt32 v))
  |> handleErrorIO onError

onError : UnderflowError -> IO Never Unit
onError e = case e of
  UnderflowError -> IO.Stdout.print "underflow"
