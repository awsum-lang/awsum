-- Test: `subInt32` returns `Right (a - b)` when the true difference stays
-- in [minInt32, maxInt32] and `Left ArithError` otherwise — with
-- `Left Overflow` for results above maxInt32 and `Left Underflow` for
-- results below minInt32. Covers all five cases:
--   (i)   ordinary positive difference                → `Right`,
--   (ii)  ordinary mixed-sign difference              → `Right` (no overflow possible
--                                                              when signs of a, b agree),
--   (iii) `maxInt32 - (-1)`                            → `Left Overflow`,
--   (iv)  `minInt32 - 1`                               → `Left Underflow`,
--   (v)   `0 - minInt32`                               → `Left Overflow` (negation of
--                                                              minInt32 doesn't fit).
import IO.Stdout

render : Either ArithError Int32 -> String
render r = case r of
  Left e -> "err: " ++ showArithError e
  Right v -> "ok: " ++ showInt32 v

maxInt32 : Int32
maxInt32 = 2147483647

minInt32 : Int32
minInt32 = -2147483648

main : String -> IO Unit
main _input = IO.Stdout.print (render (subInt32 100 23) ++ ", " ++ render (subInt32 100 (-50)) ++ ", " ++ render (subInt32 maxInt32 (-1)) ++ ", " ++ render (subInt32 minInt32 1) ++ ", " ++ render (subInt32 0 minInt32))
