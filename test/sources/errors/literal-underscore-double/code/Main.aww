-- Two consecutive '_' in an integer literal are rejected at parse
-- time. '_' is a single separator between digits — `1__2` has '_'
-- followed by '_' instead of a digit and is a syntax error.
-- Workaround: collapse to a single '_' between digits.
import IO.Stdout

bad : Int32
bad = 1__2

main : Either (StringTooLong | UnpairedUtf16Surrogate) String -> IO Never Unit
main _input = IO.Stdout.print "ok"
