-- Error: wildcard pattern on a structural-sum scrutinee.
-- Catch-all on rows is forbidden by design — exhaustiveness without
-- wildcards is a load-bearing invariant of the language.
import IO.Stdout

_f : (Int32 | String) -> String
_f x = case x of
  (n : Int32) -> showInt32 n
  _ -> "anything else"

main : Either (StringTooLong | UnpairedUtf16Surrogate) String -> IO Unit
main _input = IO.Stdout.print "ok"
