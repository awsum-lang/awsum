-- Not yet supported: `\case` lambda-case sugar. Awsum's `Lambda`
-- form is `"\" LIdent { LIdent } "->" Expr`; `case` is reserved and
-- can't be used as the lambda's parameter name, so the lexer rejects
-- the shape outright. Workaround: introduce an explicit parameter
-- and case on it: `\m -> case m of …`.
import IO.Stdout

describe : Maybe Int32 -> String
describe = \case
  Just n -> showInt32 n
  Nothing -> "no"

main : String -> IO Unit
main _input = IO.Stdout.print (describe Nothing)
