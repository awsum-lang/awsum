-- Error: `Either` is defined by the prelude; the user cannot redeclare
-- it. The diagnostic is `Duplicate type definition` on the user's own
-- declaration, because the prelude's `type Either a b` is prepended
-- before the user's typecheck runs.
import IO.Stdout

type Either a b = MyLeft a | MyRight b

main : IO Never Unit
main = IO.Stdout.print "x"
