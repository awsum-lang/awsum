{- Error: duplicate pattern (Green matched twice) in case expression -}

import IO.Stdout

type Color
  = Red
  | Green
  | Blue

show : Color -> String
show c = case c of
  Red -> "Red"
  Green -> "Green"
  Green -> "even more Green"
  Blue -> "Blue"

main : IO Never Unit
main = IO.Stdout.print (show Red)
