-- Not yet supported: 64-bit integer types (`Int64`, `UInt64`,
-- `Int16`, etc.). The only built-in numeric types in this iteration
-- are `Int32` and `UInt8`; widening / narrowing types and BigInt are
-- on the roadmap but not implemented. The typechecker reports an
-- unknown type constructor on first use.
import IO.Stdout

n : Int64
n = 1

main : Either (StringTooLong | UnpairedUtf16Surrogate) String -> IO Unit
main _input = IO.Stdout.print "ok"
