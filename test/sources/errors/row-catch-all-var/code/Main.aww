-- Error: variable pattern as a top-level catch-all on a structural-sum
-- scrutinee. Each alternative must be matched explicitly with '(x : T)'.
import IO.Stdout

_f : (Int32 | String) -> String
_f x = case x of
  (n : Int32) -> showInt32 n
  fallback -> "got something"

main : Either (StringTooLong | UnpairedUtf16Surrogate) String -> IO Unit
main _input = IO.Stdout.print "ok"
