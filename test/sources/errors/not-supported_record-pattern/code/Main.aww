-- Not yet supported: record-style field destructuring in patterns
-- (`Wrap { x = n } -> …`). Awsum has no records and no
-- field-by-name pattern form — `PatternAtom` is `LIdent | UIdent
-- | (Pattern) | (Pattern : Type)`, all positional. Workaround:
-- destructure positionally with the constructor.
import IO.Stdout

type Wrap = Wrap Int32

f : Wrap -> Int32
f w = case w of
  Wrap { x = n } -> n

main : IO Never Unit
main = IO.Stdout.print "ok"
