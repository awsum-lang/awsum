{- Not yet supported: list literal syntax `[1, 2, 3]`. Square brackets
   are not in the expression grammar — they are not lexed as anything
   meaningful, so the parser rejects the unexpected `[` immediately.
   Workaround: build the `List a` defined in the prelude with explicit
   `Cons h t` and `Nil`. -}

import IO.Stdout

main : IO Never Unit
main = IO.Stdout.print [1, 2, 3]
