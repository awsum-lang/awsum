{- Exhaustiveness recurses into nested constructor patterns: the
   top-level `Right` / `Left` are both covered, but the `Right`-arm's
   inner column has only `Just x`, so `Right Nothing` matches no arm.
   The matrix check reports that uncovered combination as the
   witness in the diagnostic. -}

import IO.Stdout

opMaybe : String -> Either ParseError (Maybe Int32)
opMaybe _ = Right Nothing

main : IO Never Unit
main = case opMaybe "x" of
  Left _ -> IO.Stdout.print "PARSE_ERROR"
  Right (Just x) -> IO.Stdout.print (showInt32 x)
