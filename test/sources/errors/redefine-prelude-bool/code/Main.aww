-- Error: `Bool` is defined by the prelude; the user cannot redeclare
-- it. The diagnostic is `Duplicate type definition` on the user's own
-- declaration, because the prelude's `type Bool = True | False` is
-- prepended before the user's typecheck runs.
import IO.Stdout

type Bool = MyTrue | MyFalse

main : Either (StringTooLong | UnpairedUtf16Surrogate) String -> IO Never Unit
main input = IO.Stdout.print input
