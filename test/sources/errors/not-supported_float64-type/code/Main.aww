{- Not yet supported: floating-point types (`Float32`, `Float64`).
   IEEE-754 floats need their own design pass (NaN handling,
   "honest arithmetic" story, representation across all five
   backends) before Awsum will admit them. Today they are simply
   unknown type constructors. -}

import IO.Stdout

pi : Float64
pi = 3.14

main : IO Never Unit
main = IO.Stdout.print "ok"
