-- Not yet supported: brace-and-semicolon explicit-layout `do` block
-- (`do { x <- e1 ; e2 }`). Awsum's `DoBlock` rule is purely
-- newline-delimited — there are no `{`, `}` or `;` tokens at
-- statement-list level. Workaround: drop the braces and put each
-- statement on its own line.
import IO.Stdout

result : Either ParseError Int32
result = do { x <- pureEither 1; pureEither x }

main : Either (StringTooLong | UnpairedUtf16Surrogate) String -> IO Never Unit
main _input = IO.Stdout.print "ok"
