-- Error: the inner 'let x = ...' shadows the outer function
-- parameter 'x'. No-shadowing applies to 'let' the same way it does
-- to function parameters and case-pattern binders.
import IO.Stdout

f : String -> String
f x =
  let x = "shadow"
   in x

main : Either (StringTooLong | UnpairedUtf16Surrogate) String -> IO Never Unit
main _input = IO.Stdout.print (f "hi")
