-- Not yet supported: lowering a top-level definition whose RHS is a
-- bare lambda (`f = \n -> n` with `f : Int32 -> Int32`). The
-- typechecker accepts the lambda against the signature, but the
-- elaborator's defunctionaliser does not have a code path for a
-- lambda that appears as the entire body of a top-level `FunDef` —
-- it expects every closure to flow into a HOF call site. The user
-- workaround is to rewrite the definition with explicit parameters
-- (`f n = n`); the eta-expanded form goes through the normal lowering.
import IO.Stdout

f : Int32 -> Int32
f = \n -> n

main : String -> IO Unit
main _input = IO.Stdout.print "ok"
