{- Warning: 'second' is bound but never used in the body.
   The check produces a 'warning' severity (yellow squiggle in the editor)
   with two quick-fixes: replace with '_' or rename to '_second'. -}

import IO.Stdout

greeting : String -> String -> Either StringTooLong String
greeting first second = "hi " ++ first

main : IO Never Unit
main = case greeting "hi" "y" of
  Left _ -> IO.Stdout.print "STRING_TOO_LONG"
  Right s -> IO.Stdout.print s
