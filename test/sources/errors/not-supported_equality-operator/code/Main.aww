-- Not yet supported: equality / comparison operators
-- (`==`, `/=`, `<`, `>`, `<=`, `>=`). The prelude exposes only the
-- type-specialised `eqInt32`, `eqUInt8` etc., which return `Bool`.
-- Polymorphic comparison operators land with the type-class system.
-- The parser rejects the `==` token directly.
import IO.Stdout

b : Bool
b = 1 == 2

main : IO Never Unit
main = IO.Stdout.print "ok"
