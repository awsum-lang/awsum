{- Error: a constructor pattern binds more sub-patterns than the
   constructor has fields — 'Single' has one field, the arm writes three. -}

import IO.Stdout

type T = Single Int32 | Empty

describe : T -> Int32
describe x = case x of
  Single a b c -> a
  Empty -> 0

main : IO Never Unit
main = IO.Stdout.print (showInt32 (describe Empty))
