-- Not yet supported: multi-clause function definitions in
-- ML/Haskell style (`f Nothing = …` / `f (Just x) = …`). Each
-- top-level name corresponds to exactly one `FunDef`; a second
-- equation with the same name is a `Duplicate definition` error,
-- not an additional pattern arm. Workaround: write one `FunDef`
-- whose body is a `case` over the parameter.
import IO.Stdout

describe : Maybe Int32 -> String
describe (Nothing) = "no"
describe (Just n) = showInt32 n

main : Either (StringTooLong | UnpairedUtf16Surrogate) String -> IO Unit
main _input = IO.Stdout.print (describe Nothing)
