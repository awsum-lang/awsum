-- Not yet supported: expression-level type ascription
-- (`(expr : Type)`). The `(x : T)` form exists in the grammar only
-- as a `Pattern` for matching against a structural-sum scrutinee —
-- it is not an `Expr` shape. The parser reaches the `:` inside the
-- `( … )` expression-atom, fails to match a `,`-style sub-expression
-- continuation, and rejects the input. Workaround: pin the type at
-- the binding site (`foo : T = …`) or at the function signature.
import IO.Stdout

main : Either (StringTooLong | UnpairedUtf16Surrogate) String -> IO Never Unit
main _input = IO.Stdout.print (showInt32 (42 : Int32))
