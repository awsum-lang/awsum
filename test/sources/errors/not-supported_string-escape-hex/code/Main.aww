-- Not yet supported: hex / unicode string escapes (`"\x41"`,
-- `"A"`, etc.). The lexer's `escape` rule recognises only
-- `\n \t \r \" \\ \0`. Workaround: paste the literal byte / character
-- directly into the source (Awsum sources are UTF-8) — there is no
-- runtime distinction between an escape and a literal codepoint.
import IO.Stdout

main : IO Never Unit
main = IO.Stdout.print "\x41"
