-- Refutable pattern on the LHS of a do-bind: `Just x <- e` where
-- `e : Either err (Maybe a)`. The do-desugar produces a case
-- whose Right arm uses only `Just x`, leaving `Right Nothing`
-- uncovered. The exhaustiveness recursion in `caseArmsNominal`
-- (added when destructuring let-bindings landed) walks into
-- nested patterns and reports the missing constructor — same
-- diagnostic the user would get from a hand-written `case ... of
-- Right (Just x) -> …; Left _ -> …`.
--
-- Fix: write the inner case explicitly with both `Just` and
-- `Nothing` arms, or restructure so the bound value is a
-- single-constructor type.
import IO.Stdout

opMaybe : String -> Either ParseError (Maybe Int32)
opMaybe _ = Right (Just 1)

main : Either (StringTooLong | UnpairedUtf16Surrogate) String -> IO Never Unit
main rawArg =
  let res : Either (StringTooLong | UnpairedUtf16Surrogate | ParseError) Int32 = (do
        raw <- rawArg
        Just x <- opMaybe raw
        pureEither x
      )
   in case res of
        Left e -> case e of
          StringTooLong -> IO.Stdout.print "STRING_TOO_LONG"
          UnpairedUtf16Surrogate -> IO.Stdout.print "UNPAIRED_UTF16_SURROGATE"
          ParseError -> IO.Stdout.print "PARSE_ERROR"
        Right n -> IO.Stdout.print (showInt32 n)
