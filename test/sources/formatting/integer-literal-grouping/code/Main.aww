{- Integer literal grouping is canonicalised by the formatter:
   - 1-3 digits → no separator
   - 4+ digits → groups of 3 from the right, with '_' between groups
   - sign stays on the outside
   Below: every form of weird grouping the parser accepts gets
   normalised to one canonical shape. -}
import IO.Stdout

short : Int32
short = 9_99

exactlyFour : Int32
exactlyFour = 1000

oddGrouping : Int32
oddGrouping = 12_3456

denseGrouping : Int32
denseGrouping = 1_2_3_4_5

bareLong : Int32
bareLong = 134217728

negShort : Int32
negShort = -4_2

negLong : Int32
negLong = -2000000000

main : Either (StringTooLong | UnpairedUtf16Surrogate) String -> IO Never Unit
main _input = IO.Stdout.print "ok"
