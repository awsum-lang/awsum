{- Awsum standard prelude.

   Prelude-visible types and functions that become available to every
   module without an explicit import. See docs/prelude.md for the
   architectural design.

   The file is shipped inside the compiler binary (embedded at build time)
   and must parse and typecheck as a regular module. It intentionally has
   no `main`: the presence of `main` is an entry-point concern, not a
   module-level one. -}

-- ---------------------- String

(++) : String -> String -> String
(++) = BuiltIn.concatString

{- Split a string at the first occurrence of `separator`. Returns
   `Just (Tuple2 prefix suffix)` such that
   `prefix ++ separator ++ suffix == str`, or `Nothing` if `separator`
   does not appear in `str`.

   Examples:
   - `splitOnFirst "," "a,b,c"`         → `Just (Tuple2 "a" "b,c")`
   - `splitOnFirst "::" "user::42::admin"` → `Just (Tuple2 "user" "42::admin")`
   - `splitOnFirst "x" "abc"`           → `Nothing`
   - `splitOnFirst "" "abc"`            → `Just (Tuple2 "" "abc")`     (empty separator matches at position 0)
   - `splitOnFirst ":" ":foo"`          → `Just (Tuple2 "" "foo")`     (separator at start)
   - `splitOnFirst ":" "foo:"`          → `Just (Tuple2 "foo" "")`     (separator at end)
   - `splitOnFirst "abc" "abc"`         → `Just (Tuple2 "" "")`        (separator equals string)
   - `splitOnFirst "abcde" "ab"`        → `Nothing`                    (separator longer than string)

   Strings are byte sequences and matching is byte-level, not codepoint-level.
   For ASCII the distinction is irrelevant; for multi-byte UTF-8, a single-byte
   separator can land inside a codepoint. UTF-8-aware splitting is a separate
   API and not provided here. -}

splitOnFirst : String -> String -> Maybe (Tuple2 String String)
splitOnFirst = BuiltIn.splitOnFirst

-- ---------------------- Unit

{- Single-constructor type carrying no information. Useful as a
   placeholder return value for functions called purely for their
   effect, and as a sentinel in generic containers. -}

type Unit = Unit

showUnit : Unit -> String
showUnit _ = "Unit"

-- ---------------------- Bool

{- Two-valued sum used by equality and other boolean-returning primitives.
   Foundation for a future `if`/`then`/`else` sugar and logical operators. -}

type Bool = True | False

not : Bool -> Bool
not b = case b of
  True -> False
  False -> True

and : Bool -> Bool -> Bool
and a b = case a of
  True -> b
  False -> False

or : Bool -> Bool -> Bool
or a b = case a of
  True -> True
  False -> b

-- ---------------------- Either

{- Two-constructor sum: a `Left` carrying an error / failure value, or a
   `Right` carrying a success value. This is how honest-arithmetic and
   other effectful-but-total primitives report whether they succeeded,
   without runtime exceptions or sentinel values. -}

type Either a b = Left a | Right b

-- ---------------------- Maybe

{- Optional value: `Just x` carries a payload, `Nothing` doesn't. For
   computations that can legitimately produce "no result" without that
   being an error (e.g. a lookup). When a reason *why* there's no value
   matters, reach for `Either` instead. -}

type Maybe a = Nothing | Just a

-- ---------------------- Tuple2

{- A pair of values. Single constructor `Tuple2 a b` carrying two
   positional fields — used wherever a function honestly produces two
   results and there's no obvious naming for them at the type level
   (e.g. `splitOnFirst` returning prefix and suffix). When the two
   fields *do* have meaningful names, prefer a domain-specific
   single-constructor sum (e.g. `type RangeI32 = RangeI32 Int32 Int32`)
   over `Tuple2`. The numeric suffix leaves the door open for future
   `Tuple3` / `Tuple4` without anyone wondering whether `Pair` and
   `Triple` belong to the same family. -}

type Tuple2 a b = Tuple2 a b

-- ---------------------- UnderflowError

{- Reported by integer primitives when a result would leave the declared
   type's range (e.g. `predInt32 minInt32`). Single-constructor sum so
   there is nothing to pattern-match on beyond the fact that it happened. -}

type UnderflowError = UnderflowError

showUnderflowError : UnderflowError -> String
showUnderflowError _ = "UnderflowError"

-- ---------------------- OverflowError

{- Reported by integer primitives when a result would exceed the declared
   type's range (e.g. `succInt32 maxInt32`). Symmetric twin of
   `UnderflowError` — single-constructor sum with nothing to pattern-match
   on beyond the fact that it happened. -}

type OverflowError = OverflowError

showOverflowError : OverflowError -> String
showOverflowError _ = "OverflowError"

-- ---------------------- ArithError

{- Reported by signed integer primitives that can fail at *either* end of
   the type's range — `addInt32` is the seed case (`maxInt32 + 1` is an
   overflow, `minInt32 + (-1)` is an underflow, both reachable from one
   operation). Closed nominal sum picked deliberately over an open / row-
   polymorphic union: structural unions are a separate, future feature. -}

type ArithError = Underflow | Overflow

showArithError : ArithError -> String
showArithError e = case e of
  Underflow -> "Underflow"
  Overflow -> "Overflow"

-- ---------------------- UInt8

eqUInt8 : UInt8 -> UInt8 -> Bool
eqUInt8 = BuiltIn.eqUInt8

showUInt8 : UInt8 -> String
showUInt8 = BuiltIn.showUInt8

predUInt8 : UInt8 -> Either UnderflowError UInt8
predUInt8 = BuiltIn.predUInt8

succUInt8 : UInt8 -> Either OverflowError UInt8
succUInt8 = BuiltIn.succUInt8

addUInt8 : UInt8 -> UInt8 -> Either OverflowError UInt8
addUInt8 = BuiltIn.addUInt8

-- ---------------------- Int32

eqInt32 : Int32 -> Int32 -> Bool
eqInt32 = BuiltIn.eqInt32

showInt32 : Int32 -> String
showInt32 = BuiltIn.showInt32

predInt32 : Int32 -> Either UnderflowError Int32
predInt32 = BuiltIn.predInt32

succInt32 : Int32 -> Either OverflowError Int32
succInt32 = BuiltIn.succInt32

addInt32 : Int32 -> Int32 -> Either ArithError Int32
addInt32 = BuiltIn.addInt32
