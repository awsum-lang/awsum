{- Awsum standard prelude.

   Prelude-visible types and functions that become available to every
   module without an explicit import. See docs/prelude.md for the
   architectural design.

   The file is shipped inside the compiler binary (embedded at build time)
   and must parse and typecheck as a regular module. It intentionally has
   no `main`: the presence of `main` is an entry-point concern, not a
   module-level one. -}

-- ---------------------- String

(++) : String -> String -> Either StringTooLong String
(++) a b = BuiltIn.concatString a b

{- Split a string at the first occurrence of `separator`. Returns
   `Just (Tuple2 prefix suffix)` such that
   `prefix ++ separator ++ suffix == str`, or `Nothing` if `separator`
   does not appear in `str`.

   Examples:
   - `splitOnFirst "," "a,b,c"`         → `Just (Tuple2 "a" "b,c")`
   - `splitOnFirst "::" "user::42::admin"` → `Just (Tuple2 "user" "42::admin")`
   - `splitOnFirst "x" "abc"`           → `Nothing`
   - `splitOnFirst "" "abc"`            → `Just (Tuple2 "" "abc")`     (empty separator matches at position 0)
   - `splitOnFirst ":" ":foo"`          → `Just (Tuple2 "" "foo")`     (separator at start)
   - `splitOnFirst ":" "foo:"`          → `Just (Tuple2 "foo" "")`     (separator at end)
   - `splitOnFirst "abc" "abc"`         → `Just (Tuple2 "" "")`        (separator equals string)
   - `splitOnFirst "abcde" "ab"`        → `Nothing`                    (separator longer than string)

   Strings are byte sequences and matching is byte-level, not codepoint-level.
   For ASCII the distinction is irrelevant; for multi-byte UTF-8, a single-byte
   separator can land inside a codepoint. UTF-8-aware splitting is a separate
   API and not provided here. -}

splitOnFirst : String -> String -> Maybe (Tuple2 String String)
splitOnFirst = BuiltIn.splitOnFirst

{- The string-length API is three explicit functions, not one `length`.
   Each name spells out the unit it counts so the call site does not
   have to remember which one is the default. There is no `length`
   alias, by design — the choice of unit is meaningful, and a call site
   that picks the wrong one (UTF-16 code units when it meant code
   points, say) will silently produce wrong answers for any string
   containing a surrogate pair. -}

{- Number of Unicode code points (USVs) in the string. A supplementary-
   plane character (e.g. an emoji like `🔥`, U+1F525) counts as 1, even
   though it is two UTF-16 code units and four UTF-8 bytes wide. Useful
   when reasoning about "characters" the way the user perceives them
   for monospace text — though grapheme clusters (combining marks,
   regional indicators, ZWJ sequences) are still wider concepts than
   one code point. -}

lengthCodePoints : String -> UInt32
lengthCodePoints = BuiltIn.lengthCodePoints

{- Number of UTF-16 code units in the string. A BMP character counts as
   1; a supplementary character counts as 2 (high surrogate + low
   surrogate). Equal to `String.length` on JVM/CLR/JS backends, where
   strings are stored as UTF-16 natively. Useful when interfacing with
   APIs whose offsets are UTF-16-indexed. -}

lengthUtf16CodeUnits : String -> UInt32
lengthUtf16CodeUnits = BuiltIn.lengthUtf16CodeUnits

{- Number of bytes the string occupies when encoded as standard UTF-8
   (RFC 3629). One byte per ASCII character, two for U+0080..U+07FF,
   three for U+0800..U+FFFF, four for U+10000..U+10FFFF. Useful when
   sizing a buffer for an API that takes UTF-8. -}

lengthUtf8Bytes : String -> UInt32
lengthUtf8Bytes = BuiltIn.lengthUtf8Bytes

{- Maximum length of an Awsum `String` in UTF-16 code units, identical
   on every backend (LLVM, JVM, CLR, WASM, JS). Operations that would
   produce a longer string return `Left StringTooLong`.

   Value: `2^27 = 134217728` UTF-16 code units. In UTF-8 bytes the
   worst case (BMP CJK content, 3 bytes per UTF-16 code unit) is
   `3 × 2^27 = 402653184` ≈ 384 MiB; ASCII is `1 × 2^27` ≈ 128 MiB.

   The cap is fixed by the WASM-32 backend, not by the smallest UTF-16
   runtime — see docs/targets.md for the cross-runtime budget that
   determines this value. -}

maxStringLengthUtf16CodeUnits : UInt32
maxStringLengthUtf16CodeUnits = 134_217_728

-- ---------------------- Unit

{- Single-constructor type carrying no information. Useful as a
   placeholder return value for functions called purely for their
   effect, and as a sentinel in generic containers. -}

type Unit = Unit

showUnit : Unit -> String
showUnit _ = "Unit"

-- ---------------------- Never

{- The canonical empty type — no constructors, no values, declared
   with the `empty type` keyword to mark it as the row identity. Two
   `empty type` declarations are interchangeable in row positions,
   and any `empty type` value (none exist at runtime) flows into any
   expected position via row-subsumption. Most visible occurrence:
   the error row of `IO Never a` declares an IO action that cannot
   fail; an `IO Never Unit` value can be composed with IO actions
   carrying any error row without an explicit wrapper.

   Plain `type X` (without the `empty` keyword) declares a normal
   nominal type that may happen to be uninhabited (zero constructors)
   but stays a /distinct row label/ — useful for phantom markers
   that must not collapse with `Never` in row positions.

   When a primitive whose error row is currently `Never` later gains
   a real error (e.g. `BrokenPipe` for `IO.Stdout.print`), every
   existing site stops compiling until the new error is handled —
   which is the intended behaviour. -}

empty type Never

-- ---------------------- Bool

{- Two-valued sum used by equality and other boolean-returning primitives.
   Foundation for a future `if`/`then`/`else` sugar and logical operators. -}

type Bool = True | False

not : Bool -> Bool
not b = case b of
  True -> False
  False -> True

and : Bool -> Bool -> Bool
and a b = case a of
  True -> b
  False -> False

or : Bool -> Bool -> Bool
or a b = case a of
  True -> True
  False -> b

showBool : Bool -> String
showBool b = case b of
  True -> "True"
  False -> "False"

-- ---------------------- Either

{- Two-constructor sum: a `Left` carrying an error / failure value, or a
   `Right` carrying a success value. This is how honest-arithmetic and
   other effectful-but-total primitives report whether they succeeded,
   without runtime exceptions or sentinel values. -}

type Either a b = Left a | Right b

{- `bindEither` chains two Either-returning operations and unions their
   error rows: the first step's error type `e1` and the second step's
   `e2` combine into the structural sum `(e1 | e2)` in the result. The
   set-semantic union collapses duplicates (`(ErrA | ErrA) ~ ErrA`) and
   ignores order, which is what makes `do`-style chaining add new
   labels per `<-` without the user writing intermediate combined-error
   types. The desugaring of the `do` form goes through this function. -}

bindEither : Either e1 a -> (a -> Either e2 b) -> Either (e1 | e2) b
bindEither x k = case x of
  Left e -> Left e
  Right a -> k a

{- `pureEither` lifts a value into `Either` on the `Right` side. The
   error row stays a free row variable `e`; at use site it gets pinned
   by the surrounding context. Used by hand at the tail of a `do`
   block — there is no `pure` soft keyword in this iteration. -}

pureEither : a -> Either e a
pureEither x = Right x

{- `andThenEither` is `bindEither` with the arguments flipped: the
   continuation comes first, the `Either` value second. The shape is
   `value |> andThenEither k`, so a chain of fallible steps reads
   left-to-right in execution order without nested lambdas. The error
   rows union the same way as in `bindEither`. The body is a direct
   `case` rather than a wrapper around `bindEither` so no extra
   tail-call survives at Core level. -}

andThenEither : (a -> Either e2 b) -> Either e1 a -> Either (e1 | e2) b
andThenEither k x = case x of
  Left e -> Left e
  Right a -> k a

{- `const` returns its first argument and ignores the second. Used by
   the `do`-notation desugarer to express continuations whose bound
   variable is unused: a chain like `do { a <- e1; e2 }` desugars to
   `bindEither e1 (const e2)` when `a` does not appear in `e2`,
   avoiding the need to introduce a lambda the compiler cannot yet
   lift. -}

const : a -> b -> a
const x _y = x

{- `mapRight` rebuilds an `Either` with `f` applied to the success value
   and the error left untouched. Same shape as `Functor.fmap` but
   specialised to `Either`'s success side; we don't have type classes,
   so this stays a plain function. -}

mapRight : Either e a -> (a -> b) -> Either e b
mapRight x f = case x of
  Left e -> Left e
  Right a -> Right (f a)

{- `mapLeft` rebuilds an `Either` with `f` applied to the error value
   and the success left untouched. Used to widen / narrow / rename a
   nominal error type without touching the success side. -}

mapLeft : Either e1 a -> (e1 -> e2) -> Either e2 a
mapLeft x f = case x of
  Left e -> Left (f e)
  Right a -> Right a

-- ---------------------- IO

{- The IO type represents a description of an effect that the runtime
   may execute. An `IO e a` value is **data** — constructing it does
   not perform any effect; the effect happens only when the runtime
   walks the IO tree returned from `main`. This is what makes
   `let unit = IO.Stdout.print "ignored" in IO.Stdout.print "real"`
   print only `real`: the first `IO` value is built and discarded.

   The error row `e` works like the error row of `Either`: primitives
   that may fail report the failure type explicitly. Currently every
   built-in IO primitive uses `Never`, meaning it cannot fail; this
   tightens as real error sources (broken pipe, disk full, ...) are
   added.

   `IO Never Unit` is the type required by `main`. Any `IO e _` with
   non-empty `e` must be reduced to `IO Never _` before main returns
   it — handle errors via `bindIO … (\result -> case result of Left e
   -> … | Right v -> …)`.

   Pattern-matching on the constructors directly is permitted today
   but **not part of the stable API**: new effects will add new
   constructors over time, breaking existing case-matches (no
   catch-all by language design). For ordinary composition, use
   `bindIO` / `mapIO` / `pureIO` and the platform built-ins
   (`IO.Stdout.print`, ...). Direct matching is for first-party
   tooling (e.g. `awsum test`'s mock interpreter) that updates in
   lockstep with the compiler. When modules land, the constructors
   move to a privileged module and become inaccessible to user code. -}

type IO e a = IOPure a | IOFail e | IOStdoutPrint String (IO e a) | IOGetArgs (Either (StringTooLong | UnpairedUtf16Surrogate) String -> IO e a)

{- Lift a pure value into IO. The error row `e` stays free and gets
   pinned by the surrounding context. -}

pureIO : a -> IO e a
pureIO x = IOPure x

{- Lift a failure value into IO. The success type `a` stays free and
   gets pinned by the surrounding context. Mirror of `pureIO` on the
   error side. Useful for re-throwing inside a `handleErrorIO` handler that
   only closes part of an error row, and for constructing failing IO
   actions in tests without reaching for the `IOFail` constructor
   directly. -}

failIO : e -> IO e a
failIO e = IOFail e

{- Sequence two IO actions: run the first, feed its success value into
   a continuation that produces the second. The error rows union,
   same shape as `bindEither`. Failure of the first action propagates
   without invoking `k`; this is what makes `IOFail` a terminal
   constructor at the chain level. -}

bindIO : IO e1 a -> (a -> IO e2 b) -> IO (e1 | e2) b
bindIO io k = case io of
  IOPure a -> k a
  IOFail e -> IOFail e
  IOStdoutPrint s next -> IOStdoutPrint s (bindIO next k)
  IOGetArgs cont -> IOGetArgs (bindIOAfterArgs cont k)

{- Helper for the `IOGetArgs` arm of `bindIO`: constructs the new
   getArgs continuation that, given the runtime-decoded result, runs
   the original cont and then chains via `bindIO` with the outer
   continuation `k`. Lifted to top-level so the typechecker pins
   cont's type explicitly via the signature, sidestepping
   bidirectional propagation through an in-place lambda. -}

bindIOAfterArgs : (Either (StringTooLong | UnpairedUtf16Surrogate) String -> IO e1 a) -> (a -> IO e2 b) -> Either (StringTooLong | UnpairedUtf16Surrogate) String -> IO (e1 | e2) b
bindIOAfterArgs cont k result = bindIO (cont result) k

{- `andThenIO` is `bindIO` with the arguments flipped: the continuation
   comes first, the IO value second. The shape is
   `io |> andThenIO k`, so a chain of IO actions reads left-to-right
   in execution order without nested lambdas. The error rows union the
   same way as in `bindIO`. The body is a direct `case` rather than a
   wrapper around `bindIO` so no extra tail-call survives at Core
   level. -}

andThenIO : (a -> IO e2 b) -> IO e1 a -> IO (e1 | e2) b
andThenIO k io = case io of
  IOPure a -> k a
  IOFail e -> IOFail e
  IOStdoutPrint s next -> IOStdoutPrint s (andThenIO k next)
  IOGetArgs cont -> IOGetArgs (\result -> andThenIO k (cont result))

{- Apply `f` to the success value of an IO action, leaving the error
   row untouched. Same shape as `mapRight` for `Either`. -}

mapIO : IO e a -> (a -> b) -> IO e b
mapIO io f = case io of
  IOPure a -> IOPure (f a)
  IOFail e -> IOFail e
  IOStdoutPrint s next -> IOStdoutPrint s (mapIO next f)
  IOGetArgs cont -> IOGetArgs (\result -> mapIO (cont result) f)

{- `mapIOError` rebuilds an IO with `f` applied to the failure value
   and the success / effect tree left untouched. Same shape as
   `mapLeft` for `Either`, used to widen / narrow / rename the error
   row of an IO computation without inspecting its success side. -}

mapIOError : IO e1 a -> (e1 -> e2) -> IO e2 a
mapIOError io f = case io of
  IOPure a -> IOPure a
  IOFail e -> IOFail (f e)
  IOStdoutPrint s next -> IOStdoutPrint s (mapIOError next f)
  IOGetArgs cont -> IOGetArgs (\result -> mapIOError (cont result) f)

{- `handleErrorIO` runs an IO computation and routes its `IOFail` through a
   recovery continuation. The handler may fully recover (returning
   `IO Never a` via `e2 = Never`), partially handle (returning an IO
   whose row carries only the labels the handler chose to re-throw),
   or rename the failure type (any other `e2`). Function-first ordering
   pairs with `|>` at the tail of an IO chain: `io |> handleErrorIO h`.
   No value-first sibling today — the dominant use is at the tail of
   a pipeline. The body is a direct `case` rather than a wrapper,
   mirroring the `andThenIO` convention of keeping zero overhead at
   Core level. -}

handleErrorIO : (e1 -> IO e2 a) -> IO e1 a -> IO e2 a
handleErrorIO h io = case io of
  IOPure a -> IOPure a
  IOFail e -> h e
  IOStdoutPrint s next -> IOStdoutPrint s (handleErrorIO h next)
  IOGetArgs cont -> IOGetArgs (\result -> handleErrorIO h (cont result))

{- `runIO` walks the IO tree returned from `main` and performs the
   corresponding effects in order. `main` returns `IO Never Unit`, so
   the `IOFail` arm is unreachable (its field type is uninhabited)
   and exhaustiveness skips it.

   Intended caller is the per-target entry-point glue (`v_runIO` is
   wired into the runtime startup that the codegens emit). User code
   never calls this directly; once modules land, `runIO` will move
   into a privileged module inaccessible from user code, alongside
   `IO`'s constructors. The `case … of Unit -> runIO next` form
   threads the recursive call as a tail call so the existing TCO
   pass folds the whole walker into a bounded-stack loop on every
   backend. -}

runIO : IO Never Unit -> Unit
runIO io = case io of
  IOPure u -> u
  IOStdoutPrint s next -> case BuiltIn.internalStdoutPrint s of
    Unit -> runIO next
  IOGetArgs cont -> runIO (cont BuiltIn.internalGetArgs)

-- ---------------------- Maybe

{- Optional value: `Just x` carries a payload, `Nothing` doesn't. For
   computations that can legitimately produce "no result" without that
   being an error (e.g. a lookup). When a reason *why* there's no value
   matters, reach for `Either` instead. -}

type Maybe a = Nothing | Just a

-- ---------------------- Tuple2

{- A pair of values. Single constructor `Tuple2 a b` carrying two
   positional fields — used wherever a function honestly produces two
   results and there's no obvious naming for them at the type level
   (e.g. `splitOnFirst` returning prefix and suffix). When the two
   fields *do* have meaningful names, prefer a domain-specific
   single-constructor sum (e.g. `type RangeI32 = RangeI32 Int32 Int32`)
   over `Tuple2`. The numeric suffix leaves the door open for future
   `Tuple3` / `Tuple4` without anyone wondering whether `Pair` and
   `Triple` belong to the same family. -}

type Tuple2 a b = Tuple2 a b

-- ---------------------- Tuple3

{- A triple of values. Same conventions as `Tuple2` — prefer a domain-
   specific single-constructor sum when the fields have meaningful
   names, reach for `Tuple3` only when they honestly don't. The
   property-test infrastructure relies on it to thread three
   positional arguments from a single `argv[1]` (`"a:b:c"` → two
   `splitOnFirst ":"` → `Tuple3 a b c`) into a property body. -}

type Tuple3 a b c = Tuple3 a b c

-- ---------------------- UnderflowError

{- Reported by integer primitives when a result would leave the declared
   type's range (e.g. `predInt32 minInt32`). Single-constructor sum so
   there is nothing to pattern-match on beyond the fact that it happened. -}

type UnderflowError = UnderflowError

showUnderflowError : UnderflowError -> String
showUnderflowError _ = "UnderflowError"

-- ---------------------- OverflowError

{- Reported by integer primitives when a result would exceed the declared
   type's range (e.g. `succInt32 maxInt32`). Symmetric twin of
   `UnderflowError` — single-constructor sum with nothing to pattern-match
   on beyond the fact that it happened. -}

type OverflowError = OverflowError

showOverflowError : OverflowError -> String
showOverflowError _ = "OverflowError"

-- ---------------------- StringTooLong

{- Reported by string operations (`(++)`, future input parsing) when the
   resulting string would exceed the language-fixed maximum length.
   Single-constructor sum — there is nothing to pattern-match on beyond
   the fact that it happened. The maximum length value and unit are
   pinned by the runtime contract and are equivalent across all backends. -}

type StringTooLong = StringTooLong

showStringTooLong : StringTooLong -> String
showStringTooLong _ = "StringTooLong"

-- ---------------------- UnpairedUtf16Surrogate

{- Reported by string-construction primitives that take input from outside
   the runtime (CLI arguments, interactive input, FFI) when a UTF-16
   half-surrogate appears without its mate. Awsum strings are strict
   UTF-16; one-half surrogates are not representable in the language,
   so the boundary that decodes external bytes into an Awsum `String`
   reports them through this label. Internal-only strings stay valid
   by construction (every operation that synthesises a `String` is
   closed under UTF-16 validity), so this never appears as the result
   of a pure computation — only at the I/O boundary. -}

type UnpairedUtf16Surrogate = UnpairedUtf16Surrogate

showUnpairedUtf16Surrogate : UnpairedUtf16Surrogate -> String
showUnpairedUtf16Surrogate _ = "UnpairedUtf16Surrogate"

-- ---------------------- ParseError

{- Reported by parsing primitives (e.g. `parseInt32`) when the input
   string does not match the expected grammar or yields a value outside
   the target type's range. Single-constructor sum — there is nothing
   to pattern-match on beyond the fact that parsing failed. The grammar
   itself, and the precise list of inputs that fail, is documented on
   each parser's own docstring. -}

type ParseError = ParseError

showParseError : ParseError -> String
showParseError _ = "ParseError"

-- ---------------------- BrokenPipe

{- Will be reported by IO primitives that write to a pipe (e.g.
   `IO.Stdout.print`) when the consumer side closes before the write
   completes — the canonical SIGPIPE / EPIPE scenario when output is
   piped into a consumer that exits early (`awsum-program | head`,
   etc.). Single-constructor sum — there is nothing to pattern-match
   on beyond the fact that the write failed.

   Declared now as a placeholder: built-in print primitives still
   carry `IO Never Unit` and never produce this value at runtime, but
   the type is in place so the eventual signature flip
   (`String -> IO BrokenPipe Unit`) does not require a rename. The
   `Never` row identity rule (a value of type `Never` flows into any
   row position) keeps current `IO.Stdout.print` calls compatible
   with future signatures composed via `bindIO` / `handleErrorIO` chains. -}

type BrokenPipe = BrokenPipe

showBrokenPipe : BrokenPipe -> String
showBrokenPipe _ = "BrokenPipe"

-- ---------------------- UInt8

{- Lower and upper bounds of `UInt8` (0..255). Useful for boundary
   checks without spelling out the literal at every call site. -}

minUInt8 : UInt8
minUInt8 = 0

maxUInt8 : UInt8
maxUInt8 = 255

eqUInt8 : UInt8 -> UInt8 -> Bool
eqUInt8 = BuiltIn.eqUInt8

showUInt8 : UInt8 -> String
showUInt8 = BuiltIn.showUInt8

predUInt8 : UInt8 -> Either UnderflowError UInt8
predUInt8 = BuiltIn.predUInt8

succUInt8 : UInt8 -> Either OverflowError UInt8
succUInt8 = BuiltIn.succUInt8

addUInt8 : UInt8 -> UInt8 -> Either OverflowError UInt8
addUInt8 = BuiltIn.addUInt8

subUInt8 : UInt8 -> UInt8 -> Either UnderflowError UInt8
subUInt8 = BuiltIn.subUInt8

mulUInt8 : UInt8 -> UInt8 -> Either OverflowError UInt8
mulUInt8 = BuiltIn.mulUInt8

{- Parse a `UInt8` from a decimal string. The grammar mirrors Awsum's
   integer literal: one or more decimal digits, nothing else — no sign
   (UInt8 cannot represent a negative number), no leading or trailing
   whitespace, no trailing characters of any kind, no leading `+`.
   Range is 0..255 inclusive.

   Examples:
   - `parseUInt8 "0"`   → `Right 0`
   - `parseUInt8 "255"` → `Right 255`
   - `parseUInt8 "256"` → `Left ParseError`   (above max)
   - `parseUInt8 "-1"`  → `Left ParseError`   (negative)
   - `parseUInt8 ""`    → `Left ParseError`   (empty)
   - `parseUInt8 "abc"` → `Left ParseError`   (not digits)
   - `parseUInt8 " 5"`  → `Left ParseError`   (whitespace)
   - `parseUInt8 "12a"` → `Left ParseError`   (trailing garbage)

   Strings are byte sequences and digits are recognised as the seven-bit
   ASCII codepoints '0'..'9' (0x30..0x39); other Unicode digit forms are
   rejected. -}

parseUInt8 : String -> Either ParseError UInt8
parseUInt8 = BuiltIn.parseUInt8

-- ---------------------- UInt32

{- Lower and upper bounds of `UInt32` (0..4294967295). Useful for
   boundary checks without spelling out the literal at every call site. -}

minUInt32 : UInt32
minUInt32 = 0

maxUInt32 : UInt32
maxUInt32 = 4_294_967_295

eqUInt32 : UInt32 -> UInt32 -> Bool
eqUInt32 = BuiltIn.eqUInt32

showUInt32 : UInt32 -> String
showUInt32 = BuiltIn.showUInt32

predUInt32 : UInt32 -> Either UnderflowError UInt32
predUInt32 = BuiltIn.predUInt32

succUInt32 : UInt32 -> Either OverflowError UInt32
succUInt32 = BuiltIn.succUInt32

addUInt32 : UInt32 -> UInt32 -> Either OverflowError UInt32
addUInt32 = BuiltIn.addUInt32

subUInt32 : UInt32 -> UInt32 -> Either UnderflowError UInt32
subUInt32 = BuiltIn.subUInt32

mulUInt32 : UInt32 -> UInt32 -> Either OverflowError UInt32
mulUInt32 = BuiltIn.mulUInt32

{- Parse a `UInt32` from a decimal string. Same grammar as `parseUInt8`:
   one or more decimal digits, no sign (UInt32 cannot represent a
   negative number), no whitespace, no trailing characters. Range is
   0..4294967295 inclusive.

   Examples:
   - `parseUInt32 "0"`           → `Right 0`
   - `parseUInt32 "4294967295"`  → `Right 4294967295`
   - `parseUInt32 "4294967296"`  → `Left ParseError`   (above max)
   - `parseUInt32 "-1"`          → `Left ParseError`   (negative)
   - `parseUInt32 ""`            → `Left ParseError`   (empty)
   - `parseUInt32 "abc"`         → `Left ParseError`   (not digits)
   - `parseUInt32 " 5"`          → `Left ParseError`   (whitespace)
   - `parseUInt32 "12a"`         → `Left ParseError`   (trailing garbage)

   Strings are byte sequences and digits are recognised as the seven-bit
   ASCII codepoints '0'..'9' (0x30..0x39); other Unicode digit forms are
   rejected. -}

parseUInt32 : String -> Either ParseError UInt32
parseUInt32 = BuiltIn.parseUInt32

-- ---------------------- Int32

{- Lower and upper bounds of `Int32` (-2147483648..2147483647). Useful
   for boundary checks without spelling out the literal at every call site. -}

minInt32 : Int32
minInt32 = -2_147_483_648

maxInt32 : Int32
maxInt32 = 2_147_483_647

eqInt32 : Int32 -> Int32 -> Bool
eqInt32 = BuiltIn.eqInt32

showInt32 : Int32 -> String
showInt32 = BuiltIn.showInt32

predInt32 : Int32 -> Either UnderflowError Int32
predInt32 = BuiltIn.predInt32

succInt32 : Int32 -> Either OverflowError Int32
succInt32 = BuiltIn.succInt32

addInt32 : Int32 -> Int32 -> Either (UnderflowError | OverflowError) Int32
addInt32 = BuiltIn.addInt32

subInt32 : Int32 -> Int32 -> Either (UnderflowError | OverflowError) Int32
subInt32 = BuiltIn.subInt32

mulInt32 : Int32 -> Int32 -> Either (UnderflowError | OverflowError) Int32
mulInt32 = BuiltIn.mulInt32

negInt32 : Int32 -> Either OverflowError Int32
negInt32 = BuiltIn.negInt32

{- Parse an `Int32` from a decimal string. The grammar mirrors Awsum's
   integer literal: an optional leading `-`, then one or more decimal
   digits, nothing else — no `+`, no leading or trailing whitespace, no
   trailing characters of any kind. Range is `minInt32..maxInt32`
   inclusive.

   Examples:
   - `parseInt32 "42"`           → `Right 42`
   - `parseInt32 "-42"`          → `Right -42`
   - `parseInt32 "0"`            → `Right 0`
   - `parseInt32 "2147483647"`   → `Right 2147483647`     (maxInt32)
   - `parseInt32 "-2147483648"`  → `Right -2147483648`    (minInt32)
   - `parseInt32 "2147483648"`   → `Left ParseError`      (above max)
   - `parseInt32 "-2147483649"`  → `Left ParseError`      (below min)
   - `parseInt32 ""`             → `Left ParseError`      (empty)
   - `parseInt32 "-"`            → `Left ParseError`      (sign without digits)
   - `parseInt32 "+42"`          → `Left ParseError`      (`+` is not accepted, mirroring the literal grammar)
   - `parseInt32 " 42"`          → `Left ParseError`      (leading whitespace)
   - `parseInt32 "12abc"`        → `Left ParseError`      (trailing garbage)

   Strings are byte sequences and digits are recognised as the seven-bit
   ASCII codepoints '0'..'9' (0x30..0x39); other Unicode digit forms are
   rejected. -}

parseInt32 : String -> Either ParseError Int32
parseInt32 = BuiltIn.parseInt32
